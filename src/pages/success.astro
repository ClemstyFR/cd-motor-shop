---
import '../styles/global.css';
---
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Commande confirmée | CD Motor Shop</title>
</head>
<body class="bg-black text-white font-sans min-h-screen flex items-center justify-center">
    <div style="text-align:center;padding:2rem;max-width:480px;">

        <div style="width:5rem;height:5rem;border-radius:50%;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto 1.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" style="height:2.5rem;width:2.5rem;color:#22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <span style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:#22c55e;">Paiement accepté</span>
        <h1 style="font-size:2.5rem;font-weight:900;text-transform:uppercase;font-style:italic;margin:0.5rem 0 1rem;">Commande confirmée !</h1>
        <p style="color:#6b7280;font-size:0.9rem;line-height:1.7;margin-bottom:2rem;">
            Merci pour ton achat.<br>
            Tu recevras un email de confirmation sous peu.<br>
            <span style="color:#4b5563;font-size:0.8rem;">Livraison estimée : 12–18 jours ouvrés.</span>
        </p>

        <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
            <a href="/" style="background:#16a34a;color:white;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.875rem 2rem;border-radius:99px;text-decoration:none;">
                Retour à la boutique
            </a>
            <a href="/orders" style="background:transparent;color:#22c55e;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.875rem 2rem;border-radius:99px;text-decoration:none;border:1px solid rgba(34,197,94,0.3);">
                Mes commandes
            </a>
        </div>

    </div>

    <script>
    // Redirige si pas de session_id Stripe dans l'URL (accès direct)
    const params = new URLSearchParams(window.location.search);
    if (!params.get('session_id')) {
        window.location.href = '/';
    }

    // Vider le panier après paiement réussi
    localStorage.removeItem('cd-motor-cart');
</script>
</body>
</html>