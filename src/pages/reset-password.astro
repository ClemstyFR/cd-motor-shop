---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Nouveau mot de passe | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show  { transform: translateX(-50%) translateY(0); opacity: 1; }
            #toast.error { background: #dc2626; }

            .field-input {
                width: 100%;
                background: #000;
                border: 1.5px solid rgba(255,255,255,0.1);
                border-radius: 0.75rem;
                padding: 0.8rem 1rem;
                font-size: 0.875rem;
                color: white;
                outline: none;
                transition: border-color 0.2s;
                box-sizing: border-box;
            }
            .field-input::placeholder { color: #4b5563; }
            .field-input:focus { border-color: #22c55e; }
            .field-input.error { border-color: #ef4444; }
            .field-input.valid { border-color: #22c55e; }

            .field-error {
                font-size: 0.65rem;
                font-weight: 700;
                color: #ef4444;
                margin-top: 0.35rem;
                min-height: 1rem;
                letter-spacing: 0.04em;
                display: flex;
                align-items: center;
                gap: 0.3rem;
                opacity: 0;
                transform: translateY(-4px);
                transition: opacity 0.2s, transform 0.2s;
            }
            .field-error.visible { opacity: 1; transform: translateY(0); }

            .pw-wrap { position: relative; }
            .pw-toggle {
                position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%);
                background: none; border: none; color: #6b7280; cursor: pointer; padding: 0.25rem;
                transition: color 0.2s;
            }
            .pw-toggle:hover { color: #22c55e; }

            #reset-btn {
                width: 100%;
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 1rem;
                border-radius: 1rem;
                border: none;
                cursor: pointer;
                transition: background 0.2s, transform 0.1s, opacity 0.2s;
                margin-top: 0.5rem;
                position: relative;
                overflow: hidden;
            }
            #reset-btn:hover   { background: #15803d; }
            #reset-btn:active  { transform: scale(0.98); }
            #reset-btn:disabled { opacity: 0.6; cursor: not-allowed; }
            #reset-btn.loading::after {
                content: '';
                position: absolute; inset: 0;
                background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
                background-size: 200% 100%;
                animation: btn-shimmer 1.2s infinite;
            }
            @keyframes btn-shimmer {
                0%   { background-position: -200% 0; }
                100% { background-position: 200% 0; }
            }

            /* Barre de force */
            #pw-strength-bar {
                height: 3px; border-radius: 99px; margin-top: 0.5rem;
                background: rgba(255,255,255,0.08); overflow: hidden; display: none;
            }
            #pw-strength-fill {
                height: 100%; border-radius: 99px; width: 0%;
                transition: width 0.4s ease, background 0.3s;
            }
            #pw-strength-label {
                font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
                letter-spacing: 0.08em; margin-top: 0.3rem; opacity: 0; transition: opacity 0.2s;
            }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .card { animation: fadeUp 0.5s ease-out 0.1s both; }

            /* Écran succès */
            #success-screen {
                display: none;
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 1rem;
                padding: 2rem 0;
                animation: fadeUp 0.5s ease-out both;
            }
            #success-screen.visible { display: flex; }

            /* Écran lien invalide */
            #invalid-screen {
                display: none;
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 1rem;
                padding: 2rem 0;
            }
            #invalid-screen.visible { display: flex; }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans min-h-screen flex flex-col">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> CD MOTOR SHOP
            </a>
        </nav>

        <!-- FORMULAIRE -->
        <main class="flex-1 flex items-center justify-center px-5 pt-24 pb-16">
            <div class="w-full max-w-md">

                <div class="mb-10 text-center" style="animation: fadeUp 0.4s ease-out both;">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Sécurité</span>
                    <h1 class="text-4xl font-black uppercase italic mt-2">Nouveau mot de passe</h1>
                    <p class="text-gray-500 text-sm mt-3">Choisis un mot de passe sécurisé pour ton compte</p>
                </div>

                <div class="card bg-zinc-900 border border-white/10 rounded-3xl p-8" style="display:flex;flex-direction:column;gap:1.25rem;">

                    <!-- Lien invalide / expiré -->
                    <div id="invalid-screen">
                        <div style="width:4rem;height:4rem;border-radius:50%;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);display:flex;align-items:center;justify-content:center;">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:1.75rem;width:1.75rem;color:#ef4444;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                            </svg>
                        </div>
                        <h2 style="font-weight:900;font-size:1.1rem;text-transform:uppercase;font-style:italic;color:white;">Lien invalide ou expiré</h2>
                        <p style="color:#6b7280;font-size:0.85rem;line-height:1.6;">Ce lien de réinitialisation n'est plus valide.<br>Demande un nouveau lien.</p>
                        <a href="/forgot-password" style="margin-top:0.5rem;background:#16a34a;color:white;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.75rem 2rem;border-radius:99px;text-decoration:none;">
                            Renvoyer un lien
                        </a>
                    </div>

                    <!-- Formulaire -->
                    <div id="form-screen" style="display:none;flex-direction:column;gap:1.25rem;">

                        <!-- Nouveau mot de passe -->
                        <div>
                            <label for="password" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Nouveau mot de passe</label>
                            <div class="pw-wrap">
                                <input id="password" type="password" placeholder="••••••••" class="field-input" autocomplete="new-password" style="padding-right:2.75rem;" />
                                <button type="button" class="pw-toggle" id="pw-toggle-1" aria-label="Afficher/masquer">
                                    <svg id="pw-eye-1" xmlns="http://www.w3.org/2000/svg" style="height:1.1rem;width:1.1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </button>
                            </div>
                            <div id="pw-strength-bar"><div id="pw-strength-fill"></div></div>
                            <p id="pw-strength-label"></p>
                            <p class="field-error" id="password-error">
                                <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                                <span id="password-error-text"></span>
                            </p>
                        </div>

                        <!-- Confirmer -->
                        <div>
                            <label for="confirm" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Confirmer le mot de passe</label>
                            <div class="pw-wrap">
                                <input id="confirm" type="password" placeholder="••••••••" class="field-input" autocomplete="new-password" style="padding-right:2.75rem;" />
                                <button type="button" class="pw-toggle" id="pw-toggle-2" aria-label="Afficher/masquer">
                                    <svg id="pw-eye-2" xmlns="http://www.w3.org/2000/svg" style="height:1.1rem;width:1.1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </button>
                            </div>
                            <p class="field-error" id="confirm-error">
                                <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                                <span id="confirm-error-text"></span>
                            </p>
                        </div>

                        <button id="reset-btn" type="button">Enregistrer le mot de passe</button>
                    </div>

                    <!-- Succès -->
                    <div id="success-screen">
                        <div style="width:4rem;height:4rem;border-radius:50%;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:1.75rem;width:1.75rem;color:#22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <h2 style="font-weight:900;font-size:1.1rem;text-transform:uppercase;font-style:italic;color:white;">Mot de passe mis à jour !</h2>
                        <p style="color:#6b7280;font-size:0.85rem;line-height:1.6;">Ton mot de passe a bien été modifié.<br>Tu peux maintenant te connecter.</p>
                        <a href="/login" style="margin-top:0.5rem;background:#16a34a;color:white;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.75rem 2rem;border-radius:99px;text-decoration:none;">
                            Se connecter
                        </a>
                    </div>

                </div>
            </div>
        </main>

        <script>
            import { supabase } from '../lib/supabase';

            document.addEventListener('astro:page-load', async () => {

                const formScreen    = document.getElementById('form-screen');
                const successScreen = document.getElementById('success-screen');
                const invalidScreen = document.getElementById('invalid-screen');

                // ── Vérifier la session depuis le lien email ──────────────────
                // Supabase envoie les tokens dans le hash de l'URL : #access_token=...&type=recovery
                const hash = window.location.hash;
                const params = new URLSearchParams(hash.replace('#', '?'));
                const type = params.get('type') ?? new URLSearchParams(window.location.search).get('type');

                // Supabase gère automatiquement la session depuis le hash
                const { data: { session } } = await supabase.auth.getSession();

                if (!session) {
                    // Pas de session valide → lien invalide ou expiré
                    if (invalidScreen) invalidScreen.classList.add('visible');
                    return;
                }

                // Session OK → afficher le formulaire
                if (formScreen) formScreen.style.display = 'flex';

                // ── Helpers ───────────────────────────────────────────────────
                const setError = (inputId, errorId, msg) => {
                    const input  = document.getElementById(inputId);
                    const errEl  = document.getElementById(errorId);
                    const textEl = document.getElementById(errorId + '-text');
                    if (!input || !errEl || !textEl) return;
                    input.classList.add('error'); input.classList.remove('valid');
                    textEl.textContent = msg;
                    errEl.classList.add('visible');
                };
                const clearError = (inputId, errorId) => {
                    const input = document.getElementById(inputId);
                    const errEl = document.getElementById(errorId);
                    if (!input || !errEl) return;
                    input.classList.remove('error');
                    errEl.classList.remove('visible');
                };
                const setValid = (inputId) => {
                    const input = document.getElementById(inputId);
                    if (input) { input.classList.add('valid'); input.classList.remove('error'); }
                };

                // ── Barre de force mot de passe ───────────────────────────────
                const pwInput = document.getElementById('password');
                const bar     = document.getElementById('pw-strength-bar');
                const fill    = document.getElementById('pw-strength-fill');
                const label   = document.getElementById('pw-strength-label');

                const calcStrength = (pw) => {
                    let score = 0;
                    if (pw.length >= 6)  score++;
                    if (pw.length >= 10) score++;
                    if (/[A-Z]/.test(pw)) score++;
                    if (/[0-9]/.test(pw)) score++;
                    if (/[^a-zA-Z0-9]/.test(pw)) score++;
                    return score;
                };

                pwInput?.addEventListener('input', () => {
                    const pw = pwInput.value;
                    clearError('password', 'password-error');

                    if (!pw) { if (bar) bar.style.display = 'none'; if (label) label.style.opacity = '0'; return; }

                    if (bar) bar.style.display = 'block';
                    const score = calcStrength(pw);
                    const pct = Math.min((score / 5) * 100, 100);
                    if (fill) fill.style.width = pct + '%';

                    const levels = [
                        { min:0, color:'#ef4444', text:'Très faible' },
                        { min:1, color:'#f97316', text:'Faible' },
                        { min:2, color:'#eab308', text:'Moyen' },
                        { min:3, color:'#84cc16', text:'Bon' },
                        { min:4, color:'#22c55e', text:'Fort' },
                    ];
                    const lvl = [...levels].reverse().find(l => score >= l.min) || levels[0];
                    if (fill)  { fill.style.background = lvl.color; }
                    if (label) { label.style.opacity = '1'; label.style.color = lvl.color; label.textContent = lvl.text; }

                    // Re-vérifier la confirmation si déjà saisie
                    const confirm = document.getElementById('confirm');
                    if (confirm?.value) {
                        if (pw === confirm.value) { clearError('confirm', 'confirm-error'); setValid('confirm'); }
                        else setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas');
                    }
                });

                // Confirm live check
                document.getElementById('confirm')?.addEventListener('input', () => {
                    const pw  = pwInput?.value ?? '';
                    const val = document.getElementById('confirm')?.value ?? '';
                    clearError('confirm', 'confirm-error');
                    if (val && val !== pw) setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas');
                    else if (val && val === pw) setValid('confirm');
                });

                // ── Toggles afficher/masquer ──────────────────────────────────
                const makeToggle = (btnId, inputId, eyeId) => {
                    document.getElementById(btnId)?.addEventListener('click', () => {
                        const input = document.getElementById(inputId);
                        const isText = input.type === 'text';
                        input.type = isText ? 'password' : 'text';
                        document.getElementById(eyeId).innerHTML = isText
                            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>'
                            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
                    });
                };
                makeToggle('pw-toggle-1', 'password', 'pw-eye-1');
                makeToggle('pw-toggle-2', 'confirm',  'pw-eye-2');

                // ── Soumission ────────────────────────────────────────────────
                const submit = async () => {
                    const pw      = pwInput?.value ?? '';
                    const confirm = document.getElementById('confirm')?.value ?? '';
                    const btn     = document.getElementById('reset-btn');

                    let hasError = false;
                    if (!pw)           { setError('password', 'password-error', 'Le mot de passe est requis'); hasError = true; }
                    else if (pw.length < 6) { setError('password', 'password-error', 'Minimum 6 caractères'); hasError = true; }
                    if (pw !== confirm) { setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas'); hasError = true; }
                    if (hasError) return;

                    btn.textContent = 'Enregistrement…';
                    btn.disabled = true;
                    btn.classList.add('loading');

                    const { error } = await supabase.auth.updateUser({ password: pw });

                    btn.classList.remove('loading');

                    if (error) {
                        btn.textContent = 'Enregistrer le mot de passe';
                        btn.disabled = false;
                        setError('password', 'password-error', error.message);
                    } else {
                        if (formScreen)    formScreen.style.display = 'none';
                        if (successScreen) successScreen.classList.add('visible');
                        // Déconnecte pour forcer une reconnexion propre
                        setTimeout(() => supabase.auth.signOut(), 2000);
                    }
                };

                document.getElementById('reset-btn')?.addEventListener('click', submit);
                document.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
            });
        </script>
        <script>
            import { initSiteEffects } from "../scripts/site-effects.js";
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener("astro:page-load", runSiteEffects);
            if (document.readyState !== "loading") runSiteEffects();
            else document.addEventListener("DOMContentLoaded", runSiteEffects, { once: true });
        </script>
    </body>
</html>
