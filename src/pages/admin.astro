---
import '../styles/global.css';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Admin | CD Motor Shop</title>
        <style>
            :root {
                --admin-bg: #050607;
                --admin-panel: #101214;
                --admin-panel-2: #15181b;
                --admin-border: rgba(216,221,224,0.12);
                --admin-muted: #8b949e;
                --admin-text: #f4f1e8;
                --admin-green: #16a34a;
                --admin-cyan: #67e8f9;
                --admin-yellow: #facc15;
                --admin-red: #ef4444;
                --admin-blue: #60a5fa;
            }

            html { scroll-behavior: smooth; }
            body.admin-page {
                margin: 0;
                min-height: 100vh;
                background:
                    radial-gradient(circle at 50% -12rem, rgba(103,232,249,0.08), transparent 28rem),
                    linear-gradient(180deg, #050607 0%, #090b0c 45%, #050607 100%);
                color: var(--admin-text);
            }
            body.admin-page *,
            body.admin-page *::before,
            body.admin-page *::after { box-sizing: border-box; }

            .admin-shell {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 17rem minmax(0, 1fr);
            }
            .sidebar {
                position: sticky;
                top: 0;
                height: 100vh;
                border-right: 1px solid var(--admin-border);
                background: rgba(5,6,7,0.86);
                backdrop-filter: blur(18px);
                padding: 1.25rem;
                display: flex;
                flex-direction: column;
                gap: 1.25rem;
                overflow-y: auto;
            }
            .brand {
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                padding-bottom: 1.1rem;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }
            .brand strong {
                font-size: 1.05rem;
                font-weight: 950;
                font-style: italic;
                letter-spacing: -0.02em;
            }
            .brand span { color: var(--admin-green); }
            .admin-pill {
                width: fit-content;
                border: 1px solid rgba(34,197,94,0.28);
                background: rgba(34,197,94,0.1);
                color: #86efac;
                border-radius: 99px;
                padding: 0.25rem 0.55rem;
                font-size: 0.62rem;
                font-weight: 900;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .nav-group { display: flex; flex-direction: column; gap: 0.35rem; }
            .nav-label {
                color: #58606a;
                font-size: 0.65rem;
                font-weight: 900;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                padding: 0.4rem 0.55rem;
            }
            .nav-btn,
            .side-link {
                min-height: 2.7rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                width: 100%;
                border: 1px solid transparent;
                border-radius: 0.8rem;
                background: transparent;
                color: var(--admin-muted);
                font: inherit;
                font-size: 0.86rem;
                font-weight: 850;
                text-align: left;
                text-decoration: none;
                padding: 0.72rem 0.8rem;
                cursor: pointer;
            }
            .nav-btn svg,
            .side-link svg { width: 1.05rem; height: 1.05rem; flex: 0 0 auto; }
            .nav-btn:hover,
            .side-link:hover {
                color: white;
                background: rgba(255,255,255,0.045);
            }
            .nav-btn.active {
                color: white;
                border-color: rgba(34,197,94,0.26);
                background: linear-gradient(135deg, rgba(34,197,94,0.18), rgba(103,232,249,0.06));
            }
            .nav-count {
                margin-left: auto;
                min-width: 1.35rem;
                text-align: center;
                border-radius: 99px;
                padding: 0.1rem 0.45rem;
                background: rgba(255,255,255,0.08);
                color: #d8dde0;
                font-size: 0.66rem;
                font-weight: 950;
            }
            .sidebar-bottom { margin-top: auto; display: flex; flex-direction: column; gap: 0.5rem; }

            .main {
                min-width: 0;
                display: flex;
                flex-direction: column;
            }
            .topbar {
                position: sticky;
                top: 0;
                z-index: 20;
                min-height: 4.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem 1.5rem;
                border-bottom: 1px solid var(--admin-border);
                background: rgba(5,6,7,0.82);
                backdrop-filter: blur(18px);
            }
            .mobile-menu {
                display: none;
                border: 1px solid var(--admin-border);
                background: var(--admin-panel);
                color: white;
                border-radius: 0.85rem;
                width: 2.6rem;
                height: 2.6rem;
                align-items: center;
                justify-content: center;
            }
            .mobile-menu svg { width: 1.2rem; height: 1.2rem; }
            .page-title { min-width: 0; }
            .page-title h1 {
                margin: 0;
                font-size: clamp(1.25rem, 2.5vw, 2rem);
                font-weight: 950;
                font-style: italic;
                line-height: 1.1;
                text-transform: uppercase;
            }
            .page-title p {
                margin: 0.35rem 0 0;
                color: var(--admin-muted);
                font-size: 0.86rem;
                line-height: 1.45;
            }
            .top-actions {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                min-width: 0;
            }
            .admin-email {
                max-width: 14rem;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                color: #d8dde0;
                font-size: 0.78rem;
                font-weight: 800;
            }
            .btn {
                min-height: 2.5rem;
                border: 1px solid var(--admin-border);
                border-radius: 0.8rem;
                background: var(--admin-panel);
                color: white;
                padding: 0.65rem 0.95rem;
                font: inherit;
                font-size: 0.78rem;
                font-weight: 950;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.45rem;
                text-decoration: none;
            }
            .btn svg { width: 1rem; height: 1rem; }
            .btn:hover { border-color: rgba(103,232,249,0.38); }
            .btn-primary {
                border-color: rgba(34,197,94,0.35);
                background: var(--admin-green);
            }
            .btn-danger {
                color: #fca5a5;
                border-color: rgba(239,68,68,0.26);
                background: rgba(239,68,68,0.08);
            }

            .content {
                width: min(100%, 1180px);
                padding: 1.5rem;
            }
            .section { display: none; }
            .section.active { display: block; }
            .section-stack { display: flex; flex-direction: column; gap: 1rem; }
            .grid-kpis {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 1rem;
            }
            .panel {
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.055), rgba(255,255,255,0.012)),
                    var(--admin-panel);
                border: 1px solid var(--admin-border);
                border-radius: 1rem;
                box-shadow: 0 20px 70px rgba(0,0,0,0.26);
                overflow: hidden;
            }
            .panel-body { padding: 1rem; }
            .panel-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }
            .panel-title {
                display: flex;
                flex-direction: column;
                gap: 0.15rem;
                min-width: 0;
            }
            .panel-title strong {
                font-size: 0.82rem;
                font-weight: 950;
                letter-spacing: 0.09em;
                text-transform: uppercase;
            }
            .panel-title span {
                color: var(--admin-muted);
                font-size: 0.78rem;
                line-height: 1.35;
            }
            .kpi {
                min-height: 8.2rem;
                position: relative;
                padding: 1rem;
            }
            .kpi::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--accent, var(--admin-green));
            }
            .kpi-label {
                color: var(--admin-muted);
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }
            .kpi-value {
                margin-top: 0.85rem;
                color: white;
                font-size: clamp(1.65rem, 3vw, 2.25rem);
                font-weight: 950;
                font-style: italic;
                line-height: 1;
                overflow-wrap: anywhere;
            }
            .kpi-sub {
                margin-top: 0.55rem;
                color: var(--admin-muted);
                font-size: 0.78rem;
                line-height: 1.4;
            }
            .dashboard-grid {
                display: grid;
                grid-template-columns: minmax(0, 1.55fr) minmax(20rem, 0.9fr);
                gap: 1rem;
            }
            .bars {
                min-height: 15rem;
                display: grid;
                grid-template-columns: repeat(6, minmax(0, 1fr));
                align-items: end;
                gap: 0.65rem;
                padding-top: 1rem;
            }
            .bar-col { min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
            .bar-track {
                width: 100%;
                height: 10rem;
                display: flex;
                align-items: end;
                border-radius: 0.7rem;
                background: rgba(255,255,255,0.035);
                overflow: hidden;
            }
            .bar-fill {
                width: 100%;
                min-height: 0.35rem;
                border: 1px solid rgba(34,197,94,0.28);
                border-radius: 0.7rem 0.7rem 0 0;
                background: linear-gradient(180deg, rgba(103,232,249,0.5), rgba(34,197,94,0.65));
            }
            .bar-value { color: white; font-size: 0.76rem; font-weight: 950; }
            .bar-label { color: var(--admin-muted); font-size: 0.68rem; font-weight: 900; text-transform: uppercase; }

            .status-list { display: flex; flex-direction: column; gap: 0.75rem; }
            .status-line {
                display: grid;
                grid-template-columns: 6.5rem 1fr 2.2rem;
                gap: 0.75rem;
                align-items: center;
                font-size: 0.8rem;
            }
            .progress {
                height: 0.55rem;
                border-radius: 99px;
                background: rgba(255,255,255,0.08);
                overflow: hidden;
            }
            .progress span { display: block; height: 100%; width: var(--w, 0%); background: var(--c, var(--admin-green)); }

            .toolbar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
                flex-wrap: wrap;
            }
            .filters { display: flex; gap: 0.45rem; flex-wrap: wrap; }
            .chip {
                min-height: 2.15rem;
                border: 1px solid var(--admin-border);
                background: rgba(255,255,255,0.03);
                color: var(--admin-muted);
                border-radius: 99px;
                padding: 0.45rem 0.75rem;
                font: inherit;
                font-size: 0.72rem;
                font-weight: 950;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                cursor: pointer;
            }
            .chip.active {
                color: white;
                border-color: rgba(34,197,94,0.38);
                background: rgba(34,197,94,0.16);
            }
            .search {
                width: min(20rem, 100%);
                min-height: 2.5rem;
                border: 1px solid var(--admin-border);
                background: #070809;
                color: white;
                border-radius: 0.8rem;
                padding: 0.65rem 0.85rem;
                font: inherit;
                font-size: 0.86rem;
                outline: none;
            }
            .search:focus { border-color: rgba(103,232,249,0.45); }

            .data-list { display: flex; flex-direction: column; gap: 0.75rem; }
            .row-card {
                display: grid;
                grid-template-columns: minmax(0, 1.25fr) minmax(8rem, 0.55fr) minmax(8rem, 0.55fr) minmax(9rem, 0.65fr);
                gap: 0.85rem;
                align-items: center;
                padding: 1rem;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 0.95rem;
                background: rgba(255,255,255,0.025);
            }
            .row-card.review-row {
                grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr) minmax(7rem, 0.45fr) minmax(7rem, 0.45fr);
            }
            .row-card.user-row {
                grid-template-columns: minmax(0, 1.2fr) minmax(7rem, 0.45fr) minmax(7rem, 0.45fr) minmax(7rem, 0.45fr);
            }
            .row-main { min-width: 0; }
            .row-title {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                min-width: 0;
                font-size: 0.92rem;
                font-weight: 950;
            }
            .mono {
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                font-size: 0.76rem;
            }
            .muted { color: var(--admin-muted); }
            .row-sub {
                margin-top: 0.35rem;
                color: var(--admin-muted);
                font-size: 0.78rem;
                line-height: 1.45;
                overflow-wrap: anywhere;
            }
            .cell-label {
                display: block;
                color: #64707b;
                font-size: 0.62rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                margin-bottom: 0.25rem;
            }
            .cell-value { font-size: 0.86rem; font-weight: 900; }
            .badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                width: fit-content;
                border-radius: 99px;
                border: 1px solid rgba(255,255,255,0.14);
                padding: 0.28rem 0.6rem;
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                white-space: nowrap;
            }
            .badge.pending { color: #fde68a; border-color: rgba(250,204,21,0.28); background: rgba(250,204,21,0.1); }
            .badge.shipped { color: #93c5fd; border-color: rgba(96,165,250,0.28); background: rgba(96,165,250,0.1); }
            .badge.done { color: #86efac; border-color: rgba(34,197,94,0.28); background: rgba(34,197,94,0.1); }
            .badge.cancel { color: #fca5a5; border-color: rgba(239,68,68,0.28); background: rgba(239,68,68,0.1); }
            .badge.neutral { color: #d8dde0; background: rgba(255,255,255,0.06); }
            .status-select {
                width: 100%;
                min-height: 2.35rem;
                border: 1px solid var(--admin-border);
                border-radius: 0.75rem;
                background: #070809;
                color: white;
                padding: 0.5rem 0.65rem;
                font: inherit;
                font-size: 0.8rem;
                font-weight: 850;
            }
            .stars { color: var(--admin-yellow); font-size: 0.95rem; letter-spacing: -0.04em; }
            .stars .empty { color: #343a40; }
            .empty-state,
            .error-state {
                padding: 2.5rem 1rem;
                text-align: center;
                color: var(--admin-muted);
                line-height: 1.55;
            }
            .error-state { color: #fca5a5; }
            .skeleton {
                height: 5rem;
                border-radius: 0.95rem;
                background: linear-gradient(90deg, #111315 25%, #1a1e21 50%, #111315 75%);
                background-size: 200% 100%;
                animation: shimmer 1.4s infinite;
            }
            @keyframes shimmer { to { background-position: -200% 0; } }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 0.8rem;
            }
            .field { display: flex; flex-direction: column; gap: 0.35rem; }
            .field label {
                color: var(--admin-muted);
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .field input {
                width: 100%;
                min-height: 2.65rem;
                border: 1px solid var(--admin-border);
                border-radius: 0.8rem;
                background: #070809;
                color: white;
                padding: 0.65rem 0.75rem;
                font: inherit;
                font-size: 0.9rem;
            }
            .margin-result {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 0.8rem;
            }
            .mini-stat {
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 0.9rem;
                background: rgba(255,255,255,0.025);
                padding: 0.9rem;
            }
            .mini-stat span {
                display: block;
                color: var(--admin-muted);
                font-size: 0.65rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .mini-stat strong {
                display: block;
                margin-top: 0.45rem;
                font-size: 1.35rem;
                font-weight: 950;
                font-style: italic;
                overflow-wrap: anywhere;
            }
            .checklist { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
            .check-item {
                min-height: 3.25rem;
                display: flex;
                align-items: center;
                gap: 0.7rem;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 0.85rem;
                background: rgba(255,255,255,0.025);
                padding: 0.75rem;
                color: #d8dde0;
                font-size: 0.84rem;
                font-weight: 800;
                line-height: 1.35;
            }
            .check-item input { width: 1.05rem; height: 1.05rem; accent-color: var(--admin-green); flex: 0 0 auto; }
            .check-item.done { color: var(--admin-muted); text-decoration: line-through; }

            #toast {
                position: fixed;
                left: 50%;
                bottom: 1.5rem;
                z-index: 1000;
                transform: translateX(-50%) translateY(4rem);
                opacity: 0;
                max-width: calc(100vw - 2rem);
                border-radius: 99px;
                background: var(--admin-green);
                color: white;
                padding: 0.75rem 1.1rem;
                font-size: 0.78rem;
                font-weight: 950;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                white-space: nowrap;
                transition: transform 0.25s ease, opacity 0.25s ease;
            }
            #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
            #toast.error { background: var(--admin-red); }
            .auth-wall {
                position: fixed;
                inset: 0;
                z-index: 900;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
                background: var(--admin-bg);
            }
            .auth-wall.show { display: flex; }
            .auth-card {
                width: min(100%, 28rem);
                text-align: center;
                padding: 2rem;
            }

            @media (max-width: 1080px) {
                .admin-shell { grid-template-columns: 1fr; }
                .sidebar {
                    position: fixed;
                    inset: 0 auto 0 0;
                    width: min(18rem, calc(100vw - 3rem));
                    transform: translateX(-105%);
                    transition: transform 0.22s ease;
                    z-index: 80;
                }
                body.nav-open .sidebar { transform: translateX(0); }
                .mobile-menu { display: inline-flex; }
                .grid-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                .dashboard-grid { grid-template-columns: 1fr; }
                .content { width: 100%; }
            }
            @media (max-width: 760px) {
                .topbar { align-items: flex-start; }
                .top-actions { flex-direction: column; align-items: flex-end; gap: 0.45rem; }
                .admin-email { display: none; }
                .content { padding: 1rem; }
                .grid-kpis,
                .form-grid,
                .margin-result,
                .checklist { grid-template-columns: 1fr; }
                .row-card,
                .row-card.review-row,
                .row-card.user-row { grid-template-columns: 1fr; }
                .bars { min-height: 12rem; gap: 0.4rem; }
                .bar-track { height: 8rem; }
                .panel-head { align-items: flex-start; flex-direction: column; }
                .toolbar { align-items: stretch; }
                .search { width: 100%; }
            }
        </style>
    </head>
    <body class="admin-page">
        <div id="toast" role="status" aria-live="polite"></div>

        <div id="auth-wall" class="auth-wall">
            <div class="auth-card panel">
                <div class="panel-body">
                    <p class="admin-pill" style="margin:0 auto 1rem;">Admin</p>
                    <h1 style="margin:0;font-size:1.8rem;font-weight:950;font-style:italic;text-transform:uppercase;">Accès protégé</h1>
                    <p id="auth-message" class="muted" style="margin:0.85rem 0 1.35rem;line-height:1.55;">Vérification des droits administrateur...</p>
                    <a href="/" class="btn btn-primary">Retour boutique</a>
                </div>
            </div>
        </div>

        <div class="admin-shell">
            <aside class="sidebar" id="sidebar">
                <div class="brand">
                    <strong><span>CD</span> MOTOR SHOP</strong>
                    <small class="admin-pill">Back-office</small>
                </div>

                <div class="nav-group">
                    <div class="nav-label">Pilotage</div>
                    <button class="nav-btn active" data-section="dashboard">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 13h6V4H4v9Zm0 7h6v-5H4v5Zm10 0h6v-9h-6v9Zm0-11h6V4h-6v5Z"/></svg>
                        Tableau de bord
                    </button>
                    <button class="nav-btn" data-section="margin">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 10v-1m9-4a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        Marge produit
                    </button>
                    <button class="nav-btn" data-section="checklist">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 11 3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        Checklist
                    </button>
                </div>

                <div class="nav-group">
                    <div class="nav-label">Gestion</div>
                    <button class="nav-btn" data-section="orders">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h6m-8 4h10m-11 4h12M7 21h10a2 2 0 0 0 2-2V7l-4-4H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2Z"/></svg>
