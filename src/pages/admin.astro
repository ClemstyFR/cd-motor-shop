        <script>
            import { supabase } from '../lib/supabase.js';

            const PRODUCT_ID = 'deep-matte-01';
            const STATUS = ['en cours', 'expédié', 'livré', 'annulé'];
            const STATUS_META = {
                'en cours': { label: 'En cours', cls: 'pending', color: '#facc15' },
                'expédié': { label: 'Expédié', cls: 'shipped', color: '#60a5fa' },
                'livré': { label: 'Livré', cls: 'done', color: '#16a34a' },
                'annulé': { label: 'Annulé', cls: 'cancel', color: '#ef4444' },
            };
            const DEFAULT_MARGIN = {
                price: 29.9,
                productCost: 8.5,
                shippingCost: 3.9,
                packagingCost: 0.8,
                stripeFixed: 0.25,
                stripeRate: 1.5,
                adCost: 4,
                returnRate: 5,
                returnCost: 4.5,
                socialRate: 12.3,
                taxRate: 1,
                monthlyFixed: 3,
                monthlyOrders: 20,
            };
            const MARGIN_FIELDS = [
                ['price', 'Prix de vente', '€'],
                ['productCost', 'Coût fournisseur', '€'],
                ['shippingCost', 'Livraison', '€'],
                ['packagingCost', 'Emballage', '€'],
                ['stripeFixed', 'Stripe fixe', '€'],
                ['stripeRate', 'Stripe variable', '%'],
                ['adCost', 'Pub par commande', '€'],
                ['returnRate', 'Taux de retour', '%'],
                ['returnCost', 'Coût retour moyen', '€'],
                ['socialRate', 'Cotisations', '%'],
                ['taxRate', 'Impôt libératoire', '%'],
                ['monthlyFixed', 'Coûts fixes / mois', '€'],
                ['monthlyOrders', 'Commandes / mois', ''],
            ];
            const CHECKS = [
                'Prix fournisseur confirmé',
                'Coût livraison confirmé',
                'Délai livraison clairement affiché',
                'Photos produit réelles ajoutées',
                'Compatibilité M8/M10/M12 expliquée',
                'Commande Stripe test effectuée',
                'Email support actif',
                'SIRET et adresse à jour',
                'CGV / mentions / confidentialité vérifiées',
                'Process remboursement prêt',
                'Stock ou fournisseur fiable',
                'Budget pub maximum défini',
            ];

            let orders = [];
            let reviews = [];
            let profiles = [];
            let customers = [];
            let toastTimer;

            const $ = (selector) => document.querySelector(selector);
            const $$ = (selector) => Array.from(document.querySelectorAll(selector));
            const money = (n) => `${Number(n || 0).toFixed(2)} €`;
            const pct = (n) => `${Number(n || 0).toFixed(1)} %`;
            const date = (iso) => iso ? new Date(iso).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
            const esc = (value) => String(value ?? '')
                .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;').replaceAll("'", '&#39;');

            const showToast = (message, isError = false) => {
                const toast = $('#toast');
                if (!toast) return;
                toast.textContent = message;
                toast.className = isError ? 'show error' : 'show';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
            };

            const skeletons = (count = 3) => Array.from({ length: count }, () => '<div class="skeleton"></div>').join('');
            const statusBadge = (status) => {
                const meta = STATUS_META[status] ?? { label: status || 'Inconnu', cls: 'neutral' };
                return `<span class="badge ${meta.cls}">● ${esc(meta.label)}</span>`;
            };
            const stars = (rating) => Array.from({ length: 5 }, (_, i) => `<span class="${i >= Number(rating) ? 'empty' : ''}">★</span>`).join('');
            const orderLabel = (id) => `#${String(id ?? '').slice(0, 8).toUpperCase() || '—'}`;
            const orderItemsLabel = (items) => Array.isArray(items) && items.length
                ? items.map((item) => `${item.name ?? item.id ?? 'Produit'} x${Number(item.qty || 1)}`).join(', ')
                : 'Aucun article';

            document.addEventListener('DOMContentLoaded', initAdmin);

            async function initAdmin() {
                bindNavigation();
                bindMargin();
                bindChecklist();
                setLoading();

                const wall = $('#auth-wall');
                const authMessage = $('#auth-message');
                const { data: { user }, error } = await supabase.auth.getUser();

                if (error || !user) {
                    authMessage.textContent = 'Connecte-toi avec un compte administrateur pour accéder au back-office.';
                    wall.classList.add('show');
                    return;
                }
                if (user.app_metadata?.role !== 'admin') {
                    authMessage.textContent = 'Ce compte est connecté, mais il n’a pas les droits administrateur.';
                    wall.classList.add('show');
                    return;
                }

                $('#admin-email').textContent = user.email || '';
                $('#logout-btn')?.addEventListener('click', async () => {
                    await supabase.auth.signOut();
                    window.location.href = '/';
                });
                $('#refresh-btn')?.addEventListener('click', loadData);
                $('#export-orders')?.addEventListener('click', exportOrdersCsv);

                await loadData();
            }

            function bindNavigation() {
                $('#mobile-menu')?.addEventListener('click', () => document.body.classList.toggle('nav-open'));
                $$('.nav-btn[data-section]').forEach((btn) => {
                    btn.addEventListener('click', () => switchSection(btn.dataset.section));
                });
                $$('[data-jump]').forEach((btn) => {
                    btn.addEventListener('click', () => switchSection(btn.dataset.jump));
                });
            }

            function switchSection(section) {
                $$('.section').forEach((el) => el.classList.remove('active'));
                $$('.nav-btn[data-section]').forEach((el) => el.classList.remove('active'));
                $(`#section-${section}`)?.classList.add('active');
                $(`.nav-btn[data-section="${section}"]`)?.classList.add('active');
                document.body.classList.remove('nav-open');

                const titles = {
                    dashboard: ['Tableau de bord', 'Vue claire des ventes, avis et points à surveiller.'],
                    orders: ['Commandes', 'Suivi, recherche et mise à jour des statuts.'],
                    reviews: ['Avis clients', 'Modération et lecture rapide des retours.'],
                    customers: ['Clients', 'Vue consolidée des profils, commandes et avis.'],
                    margin: ['Marge produit', 'Simule la rentabilité du Deep Matte.'],
                    checklist: ['Checklist', 'Les points à valider avant lancement.'],
                };
                $('#page-heading').textContent = titles[section]?.[0] ?? 'Admin';
                $('#page-subtitle').textContent = titles[section]?.[1] ?? '';
            }

            function setLoading() {
                $('#recent-orders').innerHTML = skeletons(3);
                $('#orders-list').innerHTML = skeletons(4);
                $('#reviews-list').innerHTML = skeletons(3);
                $('#customers-list').innerHTML = skeletons(3);
            }

            async function loadData() {
                setLoading();
                const [ordersRes, reviewsRes, profilesRes] = await Promise.all([
                    supabase.from('orders').select('*').order('created_at', { ascending: false }),
                    supabase.from('reviews').select('*').order('created_at', { ascending: false }),
                    supabase.from('profiles').select('id, role, updated_at'),
                ]);

                if (ordersRes.error) renderError('#orders-list', ordersRes.error.message);
                if (reviewsRes.error) renderError('#reviews-list', reviewsRes.error.message);

                orders = ordersRes.data ?? [];
                reviews = reviewsRes.data ?? [];
                profiles = profilesRes.data ?? [];
                customers = buildCustomers();

                $('#count-orders').textContent = orders.length;
                $('#count-reviews').textContent = reviews.length;
                $('#count-customers').textContent = customers.length;

                bindFilters();
                renderAll();
                showToast('Données actualisées');
            }

            function buildCustomers() {
                const map = new Map();
                const ensure = (id) => {
                    if (!id) return null;
                    if (!map.has(id)) {
                        const profile = profiles.find((p) => p.id === id);
                        map.set(id, {
                            id,
                            role: profile?.role ?? 'user',
                            updated_at: profile?.updated_at,
                            orders: 0,
                            revenue: 0,
                            reviews: 0,
                            lastSeen: profile?.updated_at ?? null,
                        });
                    }
                    return map.get(id);
                };
                orders.forEach((order) => {
                    const customer = ensure(order.user_id);
                    if (!customer) return;
                    customer.orders += 1;
                    customer.revenue += Number(order.total || 0);
                    customer.lastSeen = maxDate(customer.lastSeen, order.created_at);
                });
                reviews.forEach((review) => {
                    const customer = ensure(review.user_id);
                    if (!customer) return;
                    customer.reviews += 1;
                    customer.lastSeen = maxDate(customer.lastSeen, review.created_at);
                });
                profiles.forEach((profile) => ensure(profile.id));
                return Array.from(map.values()).sort((a, b) => new Date(b.lastSeen || 0) - new Date(a.lastSeen || 0));
            }

            function maxDate(a, b) {
                if (!a) return b;
                if (!b) return a;
                return new Date(a) > new Date(b) ? a : b;
            }

            function bindFilters() {
                $$('#order-filters .chip').forEach((btn) => {
                    btn.onclick = () => {
                        $$('#order-filters .chip').forEach((b) => b.classList.remove('active'));
                        btn.classList.add('active');
                        renderOrders();
                    };
                });
                $('#orders-search').oninput = renderOrders;

                $$('#review-filters .chip').forEach((btn) => {
                    btn.onclick = () => {
                        $$('#review-filters .chip').forEach((b) => b.classList.remove('active'));
                        btn.classList.add('active');
                        renderReviews();
                    };
                });
                $('#reviews-search').oninput = renderReviews;
                $('#customers-search').oninput = renderCustomers;
            }

            function renderAll() {
                renderDashboard();
                renderOrders();
                renderReviews();
                renderCustomers();
                updateMargin();
            }

            function renderDashboard() {
                const revenue = orders.reduce((sum, order) => sum + Number(order.total || 0), 0);
                const pending = orders.filter((order) => order.status === 'en cours').length;
                const avg = reviews.length ? reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / reviews.length : 0;
                const margin = calculateMargin();

                $('#kpi-revenue').textContent = money(revenue);
                $('#kpi-revenue-sub').textContent = `${orders.length} commande${orders.length > 1 ? 's' : ''}`;
                $('#kpi-orders').textContent = orders.length;
                $('#kpi-orders-sub').textContent = `${pending} à préparer`;
                $('#kpi-rating').textContent = reviews.length ? avg.toFixed(1) : '—';
                $('#kpi-rating-sub').textContent = `${reviews.length} avis`;
                $('#kpi-margin').textContent = money(margin.unit);
                $('#kpi-margin-sub').textContent = `${pct(margin.rate * 100)} de marge nette`;

                renderBars();
                renderStatusList();
                $('#recent-orders').innerHTML = orders.length ? orders.slice(0, 5).map(orderCard).join('') : empty('Aucune commande pour le moment.');
            }

            function renderBars() {
                const now = new Date();
                const months = Array.from({ length: 6 }, (_, index) => {
                    const d = new Date(now.getFullYear(), now.getMonth() - (5 - index), 1);
                    return { label: d.toLocaleDateString('fr-FR', { month: 'short' }), year: d.getFullYear(), month: d.getMonth(), count: 0 };
                });
                orders.forEach((order) => {
                    const d = new Date(order.created_at);
                    const bucket = months.find((m) => m.year === d.getFullYear() && m.month === d.getMonth());
                    if (bucket) bucket.count += 1;
                });
                const max = Math.max(1, ...months.map((m) => m.count));
                $('#orders-bars').innerHTML = months.map((m) => `
                    <div class="bar-col">
                        <span class="bar-value">${m.count}</span>
                        <div class="bar-track"><div class="bar-fill" style="height:${Math.max(5, (m.count / max) * 100)}%"></div></div>
                        <span class="bar-label">${esc(m.label)}</span>
                    </div>
                `).join('');
            }

            function renderStatusList() {
                const total = Math.max(1, orders.length);
                $('#status-list').innerHTML = STATUS.map((status) => {
                    const count = orders.filter((order) => order.status === status).length;
                    const meta = STATUS_META[status];
                    return `
                        <div class="status-line">
                            <span class="muted">${esc(meta.label)}</span>
                            <div class="progress"><span style="--w:${(count / total) * 100}%;--c:${meta.color}"></span></div>
                            <strong>${count}</strong>
                        </div>
                    `;
                }).join('');
            }

            function renderOrders() {
                const status = $('#order-filters .chip.active')?.dataset.status ?? 'all';
                const query = ($('#orders-search')?.value ?? '').trim().toLowerCase();
                const filtered = orders.filter((order) => {
                    const items = orderItemsLabel(order.items).toLowerCase();
                    const haystack = `${order.id} ${order.user_id ?? ''} ${order.status ?? ''} ${items}`.toLowerCase();
                    return (status === 'all' || order.status === status) && (!query || haystack.includes(query));
                });
                $('#orders-list').innerHTML = filtered.length ? filtered.map(orderCard).join('') : empty('Aucune commande ne correspond à ce filtre.');
                $$('#orders-list [data-order-status]').forEach((select) => {
                    select.addEventListener('change', async () => updateOrderStatus(select.dataset.orderStatus, select.value));
                });
            }

            function orderCard(order) {
                const items = orderItemsLabel(order.items);
                const statusOptions = STATUS.map((status) => `<option value="${status}" ${order.status === status ? 'selected' : ''}>${STATUS_META[status].label}</option>`).join('');
                return `
                    <article class="row-card">
                        <div class="row-main">
                            <div class="row-title">
                                <span class="mono">${orderLabel(order.id)}</span>
                                ${statusBadge(order.status)}
                            </div>
                            <div class="row-sub">${esc(items)}</div>
                            <div class="row-sub mono">${esc(order.user_id ?? 'Client non associé')}</div>
                        </div>
                        <div><span class="cell-label">Total</span><span class="cell-value" style="color:#86efac">${money(order.total)}</span></div>
                        <div><span class="cell-label">Date</span><span class="cell-value">${date(order.created_at)}</span></div>
                        <div>
                            <span class="cell-label">Statut</span>
                            <select class="status-select" data-order-status="${esc(order.id)}">${statusOptions}</select>
                        </div>
                    </article>
                `;
            }

            async function updateOrderStatus(orderId, status) {
                const { error } = await supabase.from('orders').update({ status }).eq('id', orderId);
                if (error) {
                    showToast('Statut non modifié', true);
                    return;
                }
                const order = orders.find((item) => String(item.id) === String(orderId));
                if (order) order.status = status;
                renderDashboard();
                renderOrders();
                showToast('Statut mis à jour');
            }

            function renderReviews() {
                const rating = $('#review-filters .chip.active')?.dataset.rating ?? 'all';
                const query = ($('#reviews-search')?.value ?? '').trim().toLowerCase();
                const filtered = reviews.filter((review) => {
                    const rateOk = rating === 'all' || (rating === 'low' ? Number(review.rating) <= 3 : String(review.rating) === rating);
                    const haystack = `${review.user_id ?? ''} ${review.product_id ?? ''} ${review.comment ?? ''}`.toLowerCase();
                    return rateOk && (!query || haystack.includes(query));
                });
                $('#reviews-list').innerHTML = filtered.length ? filtered.map(reviewCard).join('') : empty('Aucun avis ne correspond à ce filtre.');
                $$('#reviews-list [data-delete-review]').forEach((btn) => {
                    btn.addEventListener('click', async () => deleteReview(btn.dataset.deleteReview));
                });
            }

            function reviewCard(review) {
                return `
                    <article class="row-card review-row">
                        <div class="row-main">
                            <div class="row-title mono">${esc(String(review.user_id ?? '').slice(0, 18)) || 'Client'}</div>
                            <div class="row-sub">${esc(review.product_id ?? PRODUCT_ID)}</div>
                        </div>
                        <div class="row-main">
                            <div class="stars">${stars(review.rating)}</div>
                            <div class="row-sub">${review.comment ? `"${esc(review.comment)}"` : 'Sans commentaire'}</div>
                        </div>
                        <div><span class="cell-label">Date</span><span class="cell-value">${date(review.created_at)}</span></div>
                        <div><button class="btn btn-danger" data-delete-review="${esc(review.id)}">Supprimer</button></div>
                    </article>
                `;
            }

            async function deleteReview(id) {
                if (!window.confirm('Supprimer cet avis ?')) return;
                const { error } = await supabase.from('reviews').delete().eq('id', id);
                if (error) {
                    showToast('Avis non supprimé', true);
                    return;
                }
                reviews = reviews.filter((review) => String(review.id) !== String(id));
                customers = buildCustomers();
                $('#count-reviews').textContent = reviews.length;
                renderDashboard();
                renderReviews();
                renderCustomers();
                showToast('Avis supprimé');
            }

            function renderCustomers() {
                const query = ($('#customers-search')?.value ?? '').trim().toLowerCase();
                const filtered = customers.filter((customer) => `${customer.id} ${customer.role}`.toLowerCase().includes(query));
                $('#customers-list').innerHTML = filtered.length ? filtered.map(customerCard).join('') : empty('Aucun client trouvé.');
            }

            function customerCard(customer) {
                return `
                    <article class="row-card user-row">
                        <div class="row-main">
                            <div class="row-title mono">${esc(String(customer.id).slice(0, 22))}</div>
                            <div class="row-sub">${customer.role === 'admin' ? '<span class="badge done">Admin</span>' : '<span class="badge neutral">Client</span>'}</div>
                        </div>
                        <div><span class="cell-label">Commandes</span><span class="cell-value">${customer.orders}</span></div>
                        <div><span class="cell-label">Dépensé</span><span class="cell-value" style="color:#86efac">${money(customer.revenue)}</span></div>
                        <div><span class="cell-label">Dernière activité</span><span class="cell-value">${date(customer.lastSeen)}</span></div>
                    </article>
                `;
            }

            function bindMargin() {
                renderMarginForm();
                $('#reset-margin')?.addEventListener('click', () => {
                    localStorage.removeItem('cd_admin_margin');
                    renderMarginForm();
                    updateMargin();
                    showToast('Calcul réinitialisé');
                });
            }

            function getMarginInputs() {
                try {
                    return { ...DEFAULT_MARGIN, ...JSON.parse(localStorage.getItem('cd_admin_margin') || '{}') };
                } catch {
                    return { ...DEFAULT_MARGIN };
                }
            }

            function saveMarginInputs(values) {
                localStorage.setItem('cd_admin_margin', JSON.stringify(values));
            }

            function renderMarginForm() {
                const values = getMarginInputs();
                $('#margin-form').innerHTML = MARGIN_FIELDS.map(([key, label, unit]) => `
                    <div class="field">
                        <label for="margin-${key}">${label}${unit ? ` (${unit})` : ''}</label>
                        <input id="margin-${key}" data-margin="${key}" type="number" step="0.01" value="${Number(values[key])}" />
                    </div>
                `).join('');
                $$('[data-margin]').forEach((input) => {
                    input.addEventListener('input', () => {
                        const next = getMarginInputs();
                        next[input.dataset.margin] = Number(input.value || 0);
                        saveMarginInputs(next);
                        updateMargin();
                    });
                });
            }

            function calculateMargin() {
                const v = getMarginInputs();
                const direct = v.productCost + v.shippingCost + v.packagingCost;
                const payment = v.stripeFixed + (v.price * v.stripeRate / 100);
                const returns = (v.returnRate / 100) * v.returnCost;
                const social = v.price * ((v.socialRate + v.taxRate) / 100);
                const fixed = v.monthlyFixed / Math.max(1, v.monthlyOrders);
                const unit = v.price - direct - payment - v.adCost - returns - social - fixed;
                const rate = v.price ? unit / v.price : 0;
                const month = unit * v.monthlyOrders;
                return { unit, rate, month };
            }

            function updateMargin() {
                const result = calculateMargin();
                $('#margin-unit').textContent = money(result.unit);
                $('#margin-rate').textContent = pct(result.rate * 100);
                $('#margin-month').textContent = money(result.month);
                $('#margin-decision').textContent = result.unit <= 0 ? 'À revoir' : result.rate < 0.2 ? 'Fragile' : 'OK test';
                $('#margin-decision').style.color = result.unit <= 0 ? '#fca5a5' : result.rate < 0.2 ? '#fde68a' : '#86efac';
                if ($('#kpi-margin')) {
                    $('#kpi-margin').textContent = money(result.unit);
                    $('#kpi-margin-sub').textContent = `${pct(result.rate * 100)} de marge nette`;
                }
            }

            function bindChecklist() {
                renderChecklist();
                $('#reset-checklist')?.addEventListener('click', () => {
                    localStorage.removeItem('cd_admin_checklist');
                    renderChecklist();
                    showToast('Checklist réinitialisée');
                });
            }

            function renderChecklist() {
                const done = new Set(JSON.parse(localStorage.getItem('cd_admin_checklist') || '[]'));
                $('#checklist').innerHTML = CHECKS.map((label, index) => `
                    <label class="check-item ${done.has(index) ? 'done' : ''}">
                        <input type="checkbox" data-check="${index}" ${done.has(index) ? 'checked' : ''} />
                        <span>${esc(label)}</span>
                    </label>
                `).join('');
                $$('[data-check]').forEach((input) => {
                    input.addEventListener('change', () => {
                        const next = new Set(JSON.parse(localStorage.getItem('cd_admin_checklist') || '[]'));
                        const index = Number(input.dataset.check);
                        if (input.checked) next.add(index);
                        else next.delete(index);
                        localStorage.setItem('cd_admin_checklist', JSON.stringify(Array.from(next)));
                        input.closest('.check-item')?.classList.toggle('done', input.checked);
                    });
                });
            }

            function exportOrdersCsv() {
                const lines = [['id', 'date', 'status', 'total', 'user_id', 'items']];
                orders.forEach((order) => {
                    lines.push([
                        order.id,
                        order.created_at,
                        order.status,
                        Number(order.total || 0).toFixed(2),
                        order.user_id ?? '',
                        orderItemsLabel(order.items),
                    ]);
                });
                const csv = lines.map((line) => line.map((cell) => `"${String(cell).replaceAll('"', '""')}"`).join(',')).join('\n');
                const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `commandes-cdmotorshop-${new Date().toISOString().slice(0, 10)}.csv`;
                a.click();
                URL.revokeObjectURL(url);
            }

            function empty(message) {
                return `<div class="empty-state">${esc(message)}</div>`;
            }

            function renderError(selector, message) {
                const el = $(selector);
                if (el) el.innerHTML = `<div class="error-state">Erreur de chargement : ${esc(message)}</div>`;
            }
        </script>
    </body>
</html>
