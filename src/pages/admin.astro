---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Admin | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            /* ── Layout ── */
            body {
                display: flex;
                min-height: 100vh;
                background: #050505;
                color: white;
                font-family: sans-serif;
            }

            /* ── Sidebar ── */
            #sidebar {
                width: 220px;
                flex-shrink: 0;
                background: #0a0a0a;
                border-right: 1px solid rgba(255,255,255,0.06);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0; left: 0; bottom: 0;
                z-index: 100;
                padding: 1.5rem 0;
            }

            .sidebar-logo {
                padding: 0 1.25rem 1.5rem;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                margin-bottom: 1rem;
            }
            .sidebar-logo span { color: #22c55e; }
            .sidebar-badge {
                display: inline-block;
                background: rgba(34,197,94,0.12);
                border: 1px solid rgba(34,197,94,0.25);
                color: #22c55e;
                font-size: 0.5rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                padding: 0.2rem 0.6rem;
                border-radius: 99px;
                margin-top: 0.25rem;
                display: block;
                width: fit-content;
            }

            .nav-section {
                padding: 0 0.75rem;
                margin-bottom: 0.25rem;
            }
            .nav-label {
                font-size: 0.5rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.15em;
                color: #3f3f46;
                padding: 0.75rem 0.5rem 0.4rem;
            }
            .nav-item {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.6rem 0.75rem;
                border-radius: 0.6rem;
                font-size: 0.78rem;
                font-weight: 700;
                color: #6b7280;
                cursor: pointer;
                transition: background 0.15s, color 0.15s;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                position: relative;
            }
            .nav-item:hover { background: rgba(255,255,255,0.04); color: white; }
            .nav-item.active { background: rgba(34,197,94,0.1); color: #22c55e; }
            .nav-item.active svg { color: #22c55e; }
            .nav-item svg { height: 1rem; width: 1rem; flex-shrink: 0; }

            .nav-badge {
                margin-left: auto;
                background: #22c55e;
                color: black;
                font-size: 0.55rem;
                font-weight: 900;
                padding: 0.1rem 0.45rem;
                border-radius: 99px;
                min-width: 1.1rem;
                text-align: center;
            }

            /* ── Main content ── */
            #main {
                margin-left: 220px;
                flex: 1;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* ── Topbar ── */
            #topbar {
                background: #0a0a0a;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                padding: 1rem 2rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 50;
            }
            #topbar h1 {
                font-size: 1.1rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                font-style: italic;
            }
            .topbar-right {
                display: flex;
                align-items: center;
                gap: 1rem;
            }
            #admin-email-display {
                font-size: 0.7rem;
                color: #6b7280;
            }
            .btn-logout {
                background: transparent;
                border: 1px solid rgba(239,68,68,0.25);
                color: #ef4444;
                font-size: 0.65rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.4rem 0.9rem;
                border-radius: 99px;
                cursor: pointer;
                transition: background 0.2s;
            }
            .btn-logout:hover { background: rgba(239,68,68,0.1); }

            /* ── Sections ── */
            .section { display: none; padding: 2rem; animation: fadeIn 0.3s ease-out; }
            .section.active { display: block; }
            @keyframes fadeIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }

            /* ── KPI Cards ── */
            .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
            .kpi-card {
                background: #111;
                border: 1px solid rgba(255,255,255,0.06);
                border-radius: 1rem;
                padding: 1.25rem;
                position: relative;
                overflow: hidden;
                transition: border-color 0.2s;
            }
            .kpi-card:hover { border-color: rgba(34,197,94,0.2); }
            .kpi-card::before {
                content: '';
                position: absolute;
                top: 0; left: 0; right: 0;
                height: 2px;
                background: var(--accent, #22c55e);
                opacity: 0.6;
            }
            .kpi-label { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280; margin-bottom: 0.5rem; }
            .kpi-value { font-size: 2rem; font-weight: 900; font-style: italic; color: white; line-height: 1; }
            .kpi-sub { font-size: 0.65rem; color: #6b7280; margin-top: 0.4rem; }
            .kpi-icon { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); opacity: 0.06; }
            .kpi-icon svg { height: 4rem; width: 4rem; }

            /* ── Chart ── */
            .chart-row { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-bottom: 2rem; }
            .card {
                background: #111;
                border: 1px solid rgba(255,255,255,0.06);
                border-radius: 1rem;
                padding: 1.5rem;
            }
            .card-title {
                font-size: 0.7rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: #6b7280;
                margin-bottom: 1.25rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            .card-title svg { height: 0.9rem; width: 0.9rem; color: #22c55e; }

            /* Bars chart */
            .bar-chart { display: flex; align-items: flex-end; gap: 0.4rem; height: 100px; }
            .bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 0.35rem; height: 100%; }
            .bar {
                width: 100%;
                background: rgba(34,197,94,0.15);
                border-radius: 4px 4px 0 0;
                border: 1px solid rgba(34,197,94,0.25);
                transition: background 0.2s;
                position: relative;
                margin-top: auto;
            }
            .bar:hover { background: rgba(34,197,94,0.35); }
            .bar-label { font-size: 0.5rem; color: #4b5563; font-weight: 700; text-transform: uppercase; }

            /* Donut */
            .donut-wrap { display: flex; flex-direction: column; align-items: center; gap: 1rem; }
            .donut-legend { display: flex; flex-direction: column; gap: 0.5rem; width: 100%; }
            .donut-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.65rem; }
            .donut-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

            /* ── Table shared ── */
            .table-wrap { background: #111; border: 1px solid rgba(255,255,255,0.06); border-radius: 1rem; overflow: hidden; }
            .table-header {
                padding: 1rem 1.5rem;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }
            .table-title { font-size: 0.7rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280; }
            .search-input {
                background: #0a0a0a;
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 0.5rem;
                padding: 0.4rem 0.75rem;
                font-size: 0.75rem;
                color: white;
                outline: none;
                width: 200px;
                transition: border-color 0.2s;
            }
            .search-input:focus { border-color: #22c55e; }
            .search-input::placeholder { color: #3f3f46; }
            table { width: 100%; border-collapse: collapse; }
            thead th {
                padding: 0.75rem 1.5rem;
                text-align: left;
                font-size: 0.6rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: #3f3f46;
                border-bottom: 1px solid rgba(255,255,255,0.04);
            }
            tbody tr { border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; }
            tbody tr:last-child { border-bottom: none; }
            tbody tr:hover { background: rgba(255,255,255,0.02); }
            td { padding: 0.9rem 1.5rem; font-size: 0.78rem; vertical-align: middle; }

            /* ── Status badges ── */
            .badge {
                display: inline-flex; align-items: center; gap: 0.3rem;
                font-size: 0.6rem; font-weight: 900; text-transform: uppercase;
                letter-spacing: 0.06em; padding: 0.2rem 0.65rem; border-radius: 99px;
                white-space: nowrap;
            }
            .badge-yellow  { background: rgba(234,179,8,0.1);  color: #eab308; border: 1px solid rgba(234,179,8,0.25);  }
            .badge-blue    { background: rgba(59,130,246,0.1);  color: #60a5fa; border: 1px solid rgba(59,130,246,0.25);  }
            .badge-green   { background: rgba(34,197,94,0.1);   color: #22c55e; border: 1px solid rgba(34,197,94,0.25);   }
            .badge-red     { background: rgba(239,68,68,0.1);   color: #ef4444; border: 1px solid rgba(239,68,68,0.25);   }
            .badge-purple  { background: rgba(168,85,247,0.1);  color: #a855f7; border: 1px solid rgba(168,85,247,0.25);  }
            .badge-gray    { background: rgba(107,114,128,0.1); color: #9ca3af; border: 1px solid rgba(107,114,128,0.2);  }

            /* ── Select status ── */
            .status-select {
                background: #0a0a0a;
                border: 1px solid rgba(255,255,255,0.1);
                border-radius: 0.5rem;
                color: white;
                font-size: 0.7rem;
                font-weight: 700;
                padding: 0.3rem 0.5rem;
                outline: none;
                cursor: pointer;
                transition: border-color 0.2s;
            }
            .status-select:focus { border-color: #22c55e; }

            /* ── Stars ── */
            .stars { color: #facc15; font-size: 0.8rem; letter-spacing: -1px; }
            .stars .empty { color: #3f3f46; }

            /* ── Action btns ── */
            .btn-sm {
                font-size: 0.6rem; font-weight: 900; text-transform: uppercase;
                letter-spacing: 0.06em; padding: 0.3rem 0.75rem; border-radius: 99px;
                border: none; cursor: pointer; transition: background 0.2s, opacity 0.2s;
            }
            .btn-approve { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
            .btn-approve:hover { background: rgba(34,197,94,0.3); }
            .btn-reject  { background: rgba(239,68,68,0.1);  color: #ef4444; border: 1px solid rgba(239,68,68,0.25); }
            .btn-reject:hover  { background: rgba(239,68,68,0.2); }
            .btn-delete  { background: rgba(239,68,68,0.1);  color: #ef4444; border: 1px solid rgba(239,68,68,0.25); }
            .btn-delete:hover  { background: rgba(239,68,68,0.2); }

            /* ── Skeleton ── */
            .skel {
                background: linear-gradient(90deg, #1a1a1a 25%, #222 50%, #1a1a1a 75%);
                background-size: 200% 100%;
                animation: shimmer 1.4s infinite;
                border-radius: 0.5rem;
            }
            @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
            .skel-row { height: 2.5rem; margin-bottom: 0.5rem; }

            /* ── Toast ── */
            #toast {
                position: fixed; bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show  { transform: translateX(-50%) translateY(0); opacity: 1; }
            #toast.error { background: #dc2626; }

            /* ── Auth wall ── */
            #auth-wall {
                display: none;
                position: fixed; inset: 0;
                background: #050505;
                z-index: 999;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 1rem;
                text-align: center;
            }
            #auth-wall.show { display: flex; }

            /* ── Empty state ── */
            .empty-state {
                padding: 4rem 2rem;
                text-align: center;
                color: #4b5563;
                font-size: 0.8rem;
                font-style: italic;
            }

            /* ── Filters ── */
            .filter-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
            .filter-btn {
                font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
                letter-spacing: 0.08em; padding: 0.3rem 0.8rem;
                border-radius: 99px; border: 1px solid rgba(255,255,255,0.08);
                background: transparent; color: #6b7280; cursor: pointer;
                transition: all 0.15s;
            }
            .filter-btn:hover { border-color: rgba(255,255,255,0.2); color: white; }
            .filter-btn.active { background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.3); color: #22c55e; }

            /* ── User avatar ── */
            .avatar {
                width: 2rem; height: 2rem; border-radius: 50%;
                display: flex; align-items: center; justify-content: center;
                font-size: 0.7rem; font-weight: 900; flex-shrink: 0;
            }

            /* ── Responsive ── */
            @media (max-width: 768px) {
                #sidebar { display: none; }
                #main { margin-left: 0; }
                .kpi-grid { grid-template-columns: 1fr 1fr; }
                .chart-row { grid-template-columns: 1fr; }
            }
        </style>
        <ClientRouter/>
    </head>
    <body>

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- ── Auth wall ── -->
        <div id="auth-wall">
            <div style="height:5rem;width:5rem;border-radius:50%;background:#111;border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;margin-bottom:0.5rem;">
                <svg xmlns="http://www.w3.org/2000/svg" style="height:2rem;width:2rem;color:#3f3f46;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <p style="font-weight:900;font-size:1.2rem;text-transform:uppercase;font-style:italic;">Accès refusé</p>
            <p style="color:#6b7280;font-size:0.8rem;" id="auth-wall-msg">Vous n'avez pas les droits administrateur.</p>
            <a href="/" style="margin-top:0.5rem;background:#16a34a;color:white;font-weight:900;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.6rem 1.5rem;border-radius:99px;text-decoration:none;">← Retour à la boutique</a>
        </div>

        <!-- ── Sidebar ── -->
        <aside id="sidebar">
            <div class="sidebar-logo">
                <div style="font-size:1.1rem;font-weight:900;font-style:italic;letter-spacing:-0.02em;"><span>CD</span> MOTOR SHOP</div>
                <span class="sidebar-badge">Admin</span>
            </div>

            <div class="nav-section">
                <div class="nav-label">Dashboard</div>
                <button class="nav-item active" data-section="stats">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    Vue d'ensemble
                </button>
            </div>

            <div class="nav-section">
                <div class="nav-label">Gestion</div>
                <button class="nav-item" data-section="orders">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Commandes
                    <span class="nav-badge" id="orders-nav-count">…</span>
                </button>
                <button class="nav-item" data-section="reviews">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    Avis clients
                    <span class="nav-badge" id="reviews-nav-count" style="background:#eab308;">…</span>
                </button>
                <button class="nav-item" data-section="users">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Utilisateurs
                </button>
            </div>

            <div style="margin-top:auto;padding:0 0.75rem 0.5rem;">
                <a href="/" style="display:flex;align-items:center;gap:0.6rem;padding:0.6rem 0.75rem;border-radius:0.6rem;font-size:0.75rem;font-weight:700;color:#4b5563;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='#4b5563'">
                    <svg style="height:1rem;width:1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Retour boutique
                </a>
            </div>
        </aside>

        <!-- ── Main ── -->
        <div id="main">

            <!-- Topbar -->
            <div id="topbar">
                <h1 id="section-title">Vue d'ensemble</h1>
                <div class="topbar-right">
                    <span id="admin-email-display"></span>
                    <button class="btn-logout" id="logout-btn">Déconnexion</button>
                </div>
            </div>

            <!-- ═══════════════ SECTION : STATS ═══════════════ -->
            <div class="section active" id="section-stats">

                <!-- KPIs -->
                <div class="kpi-grid">
                    <div class="kpi-card" style="--accent:#22c55e">
                        <div class="kpi-label">Chiffre d'affaires</div>
                        <div class="kpi-value" id="kpi-revenue">—</div>
                        <div class="kpi-sub" id="kpi-revenue-sub">Chargement…</div>
                        <div class="kpi-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:#22c55e"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
                    </div>
                    <div class="kpi-card" style="--accent:#60a5fa">
                        <div class="kpi-label">Commandes</div>
                        <div class="kpi-value" id="kpi-orders">—</div>
                        <div class="kpi-sub" id="kpi-orders-sub">Chargement…</div>
                        <div class="kpi-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:#60a5fa"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>
                    </div>
                    <div class="kpi-card" style="--accent:#a855f7">
                        <div class="kpi-label">Utilisateurs</div>
                        <div class="kpi-value" id="kpi-users">—</div>
                        <div class="kpi-sub" id="kpi-users-sub">Chargement…</div>
                        <div class="kpi-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:#a855f7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg></div>
                    </div>
                    <div class="kpi-card" style="--accent:#facc15">
                        <div class="kpi-label">Note moyenne</div>
                        <div class="kpi-value" id="kpi-rating">—</div>
                        <div class="kpi-sub" id="kpi-rating-sub">Chargement…</div>
                        <div class="kpi-icon"><svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color:#facc15"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg></div>
                    </div>
                </div>

                <!-- Charts row -->
                <div class="chart-row">
                    <!-- Barres CA par mois -->
                    <div class="card">
                        <div class="card-title">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            Commandes par mois (6 derniers mois)
                        </div>
                        <div id="bar-chart" class="bar-chart">
                            <!-- rempli par JS -->
                        </div>
                    </div>

                    <!-- Donut statuts -->
                    <div class="card">
                        <div class="card-title">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
                            Répartition statuts
                        </div>
                        <div class="donut-wrap">
                            <svg id="donut-svg" viewBox="0 0 100 100" width="120" height="120"></svg>
                            <div class="donut-legend" id="donut-legend"></div>
                        </div>
                    </div>
                </div>

                <!-- Dernières commandes -->
                <div class="table-wrap">
                    <div class="table-header">
                        <span class="table-title">Dernières commandes</span>
                        <button class="nav-item" style="width:auto;padding:0.3rem 0.75rem;font-size:0.65rem;border:1px solid rgba(255,255,255,0.08);border-radius:99px;" onclick="switchSection('orders')">Voir tout →</button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>#</th><th>Client</th><th>Total</th><th>Statut</th><th>Date</th>
                            </tr>
                        </thead>
                        <tbody id="recent-orders-tbody">
                            <tr><td colspan="5"><div class="skel skel-row"></div><div class="skel skel-row"></div><div class="skel skel-row"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ═══════════════ SECTION : COMMANDES ═══════════════ -->
            <div class="section" id="section-orders">
                <div class="table-wrap">
                    <div class="table-header" style="flex-wrap:wrap;gap:0.75rem;">
                        <span class="table-title">Toutes les commandes</span>
                        <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                            <div class="filter-row" id="order-filters">
                                <button class="filter-btn active" data-status="all">Toutes</button>
                                <button class="filter-btn" data-status="en cours">En cours</button>
                                <button class="filter-btn" data-status="expédié">Expédié</button>
                                <button class="filter-btn" data-status="livré">Livré</button>
                                <button class="filter-btn" data-status="annulé">Annulé</button>
                            </div>
                            <input type="text" class="search-input" id="orders-search" placeholder="Rechercher…" />
                        </div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>#ID</th><th>Articles</th><th>Total</th><th>Statut</th><th>Date</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody">
                            <tr><td colspan="6"><div class="skel skel-row"></div><div class="skel skel-row"></div><div class="skel skel-row"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ═══════════════ SECTION : AVIS ═══════════════ -->
            <div class="section" id="section-reviews">
                <div class="table-wrap">
                    <div class="table-header" style="flex-wrap:wrap;gap:0.75rem;">
                        <span class="table-title">Avis clients</span>
                        <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                            <div class="filter-row" id="review-filters">
                                <button class="filter-btn active" data-rating="all">Tous</button>
                                <button class="filter-btn" data-rating="5">★ 5</button>
                                <button class="filter-btn" data-rating="4">★ 4</button>
                                <button class="filter-btn" data-rating="3">★ 3</button>
                                <button class="filter-btn" data-rating="1">★ 1-2</button>
                            </div>
                            <input type="text" class="search-input" id="reviews-search" placeholder="Rechercher…" />
                        </div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Utilisateur</th><th>Note</th><th>Commentaire</th><th>Produit</th><th>Date</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reviews-tbody">
                            <tr><td colspan="6"><div class="skel skel-row"></div><div class="skel skel-row"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ═══════════════ SECTION : UTILISATEURS ═══════════════ -->
            <div class="section" id="section-users">
                <div class="table-wrap">
                    <div class="table-header">
                        <span class="table-title">Utilisateurs inscrits</span>
                        <input type="text" class="search-input" id="users-search" placeholder="Rechercher par email…" />
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Utilisateur</th><th>Email</th><th>Rôle</th><th>Commandes</th><th>Avis</th><th>Inscription</th><th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users-tbody">
                            <tr><td colspan="7"><div class="skel skel-row"></div><div class="skel skel-row"></div><div class="skel skel-row"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div><!-- /#main -->

        <script>
            import { supabase } from '../lib/supabase.js';

            const AVATAR_COLORS = ['#16a34a','#2563eb','#9333ea','#ea580c','#db2777','#0891b2','#d97706'];
            const avatarColor = (s) => AVATAR_COLORS[(s?.charCodeAt(0) ?? 0) % AVATAR_COLORS.length];

            const STATUS_BADGE = {
                'en cours': 'badge-yellow',
                'expédié':  'badge-blue',
                'livré':    'badge-green',
                'annulé':   'badge-red',
            };
            const STATUS_OPTIONS = ['en cours','expédié','livré','annulé'];

            const fmtDate  = (iso) => new Date(iso).toLocaleDateString('fr-FR', {day:'2-digit',month:'short',year:'numeric'});
            const fmtMoney = (n)   => Number(n).toFixed(2) + ' €';
            const escapeHtml = (value) => String(value ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');

            // Global data cache
            let allOrders  = [];
            let allReviews = [];
            let allUsers   = [];

            // ── Toast ──────────────────────────────────────────────────────────
            let toastTimer;
            const showToast = (msg, err=false) => {
                const t = document.getElementById('toast');
                if (!t) return;
                t.textContent = (err ? '✕ ' : '✓ ') + msg;
                t.className = err ? 'error show' : 'show';
                clearTimeout(toastTimer);
                toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
            };

            // ── Stars HTML ─────────────────────────────────────────────────────
            const starsHtml = (n) => Array.from({length:5},(_,i)=>`<span${i>=n?' class="empty"':''}>★</span>`).join('');

            document.addEventListener('astro:page-load', async () => {

                // ── Auth check + role ──────────────────────────────────────────
                const { data: { user } } = await supabase.auth.getUser();
                const wall = document.getElementById('auth-wall');
                const msg  = document.getElementById('auth-wall-msg');

                if (!user) {
                    msg.textContent = 'Vous devez être connecté.';
                    wall.classList.add('show');
                    return;
                }

                const role = user.app_metadata?.role;

                if (role !== 'admin') {
                    msg.textContent = 'Vous n\'avez pas les droits administrateur.';
                    wall.classList.add('show');
                    return;
                }

                document.getElementById('admin-email-display').textContent = user.email;

                // ── Logout ─────────────────────────────────────────────────────
                document.getElementById('logout-btn')?.addEventListener('click', async () => {
                    await supabase.auth.signOut();
                    window.location.href = '/';
                });

                // ── Sidebar navigation ─────────────────────────────────────────
                document.querySelectorAll('.nav-item[data-section]').forEach(btn => {
                    btn.addEventListener('click', () => switchSection(btn.dataset.section));
                });

                // ── Load all data ──────────────────────────────────────────────
                await Promise.all([loadOrders(), loadReviews(), loadUsers()]);
                renderStats();
            });

            // ── Switch section ─────────────────────────────────────────────────
            window.switchSection = (name) => {
                document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
                document.querySelectorAll('.nav-item[data-section]').forEach(b => b.classList.remove('active'));
                document.getElementById('section-' + name)?.classList.add('active');
                document.querySelector(`.nav-item[data-section="${name}"]`)?.classList.add('active');
                const titles = { stats:'Vue d\'ensemble', orders:'Commandes', reviews:'Avis clients', users:'Utilisateurs' };
                document.getElementById('section-title').textContent = titles[name] ?? '';
            };

            // ══════════════════════════════════════════════════════════════════
            // LOAD ORDERS
            // ══════════════════════════════════════════════════════════════════
            async function loadOrders() {
                const { data, error } = await supabase
                    .from('orders')
                    .select('*')
                    .order('created_at', { ascending: false });

                if (error) { console.error(error); return; }
                allOrders = data ?? [];

                const count = allOrders.length;
                document.getElementById('orders-nav-count').textContent = count;
                renderOrdersTable(allOrders);
                renderRecentOrders(allOrders.slice(0, 5));

                // Filters
                document.querySelectorAll('#order-filters .filter-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('#order-filters .filter-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        const s = btn.dataset.status;
                        const search = document.getElementById('orders-search')?.value.toLowerCase() ?? '';
                        renderOrdersTable(filterOrders(s, search));
                    });
                });
                document.getElementById('orders-search')?.addEventListener('input', (e) => {
                    const s = document.querySelector('#order-filters .filter-btn.active')?.dataset.status ?? 'all';
                    renderOrdersTable(filterOrders(s, e.target.value.toLowerCase()));
                });
            }

            const filterOrders = (status, search) => allOrders.filter(o =>
                (status === 'all' || o.status === status) &&
                (!search || o.id.toString().toLowerCase().includes(search) ||
                    (Array.isArray(o.items) && o.items.some(i => i.name?.toLowerCase().includes(search))))
            );

            function renderOrdersTable(orders) {
                const tbody = document.getElementById('orders-tbody');
                if (!tbody) return;
                if (orders.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state">Aucune commande trouvée.</div></td></tr>`;
                    return;
                }
                tbody.innerHTML = orders.map(o => {
                    const items = Array.isArray(o.items) ? o.items : [];
                    const names = escapeHtml(items.map(i => `${i.name} ×${i.qty}`).join(', '));
                    const badgeCls = STATUS_BADGE[o.status] ?? 'badge-gray';
                    const ordNum = String(o.id).slice(0,8).toUpperCase();
                    const options = STATUS_OPTIONS.map(s =>
                        `<option value="${s}" ${o.status===s?'selected':''}>${s.charAt(0).toUpperCase()+s.slice(1)}</option>`
                    ).join('');
                    return `<tr>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6b7280;">#${ordNum}</td>
                        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#d1d5db;font-size:0.75rem;">${names || '—'}</td>
                        <td style="font-weight:900;color:#22c55e;">${fmtMoney(o.total)}</td>
                        <td><span class="badge ${badgeCls}">● ${o.status}</span></td>
                        <td style="color:#6b7280;font-size:0.72rem;">${fmtDate(o.created_at)}</td>
                        <td>
                            <select class="status-select" data-order-id="${o.id}">${options}</select>
                        </td>
                    </tr>`;
                }).join('');

                // Status update listeners
                tbody.querySelectorAll('.status-select').forEach(sel => {
                    sel.addEventListener('change', async () => {
                        const { error } = await supabase
                            .from('orders')
                            .update({ status: sel.value })
                            .eq('id', sel.dataset.orderId);
                        if (error) showToast('Erreur mise à jour', true);
                        else {
                            const o = allOrders.find(x => x.id == sel.dataset.orderId);
                            if (o) o.status = sel.value;
                            showToast('Statut mis à jour !');
                            renderStats();
                        }
                    });
                });
            }

            function renderRecentOrders(orders) {
                const tbody = document.getElementById('recent-orders-tbody');
                if (!tbody) return;
                if (orders.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state">Aucune commande.</div></td></tr>`;
                    return;
                }
                tbody.innerHTML = orders.map(o => {
                    const badgeCls = STATUS_BADGE[o.status] ?? 'badge-gray';
                    const ordNum = String(o.id).slice(0,8).toUpperCase();
                    const safeUserId = escapeHtml(o.user_id ?? '');
                    const initial = escapeHtml(o.user_id?.slice(0,1) ?? '?').toUpperCase();
                    const col = avatarColor(o.user_id);
                    return `<tr>
                        <td style="font-family:monospace;font-size:0.7rem;color:#6b7280;">#${ordNum}</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:0.5rem;">
                                <div class="avatar" style="background:${col}22;color:${col};border:1px solid ${col}55;">${initial}</div>
                                <span style="font-size:0.7rem;color:#9ca3af;font-family:monospace;">${safeUserId.slice(0,12)}…</span>
                            </div>
                        </td>
                        <td style="font-weight:900;color:#22c55e;">${fmtMoney(o.total)}</td>
                        <td><span class="badge ${badgeCls}">● ${o.status}</span></td>
                        <td style="color:#6b7280;font-size:0.72rem;">${fmtDate(o.created_at)}</td>
                    </tr>`;
                }).join('');
            }

            // ══════════════════════════════════════════════════════════════════
            // LOAD REVIEWS
            // ══════════════════════════════════════════════════════════════════
            async function loadReviews() {
                const { data, error } = await supabase
                    .from('reviews')
                    .select('*')
                    .order('created_at', { ascending: false });

                if (error) { console.error(error); return; }
                allReviews = data ?? [];
                document.getElementById('reviews-nav-count').textContent = allReviews.length;
                renderReviewsTable(allReviews);

                // Filters
                document.querySelectorAll('#review-filters .filter-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('#review-filters .filter-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        const r = btn.dataset.rating;
                        const search = document.getElementById('reviews-search')?.value.toLowerCase() ?? '';
                        renderReviewsTable(filterReviews(r, search));
                    });
                });
                document.getElementById('reviews-search')?.addEventListener('input', e => {
                    const r = document.querySelector('#review-filters .filter-btn.active')?.dataset.rating ?? 'all';
                    renderReviewsTable(filterReviews(r, e.target.value.toLowerCase()));
                });
            }

            const filterReviews = (rating, search) => allReviews.filter(r =>
                (rating === 'all' || (rating === '1' ? r.rating <= 2 : r.rating == rating)) &&
                (!search || (r.comment ?? '').toLowerCase().includes(search) || r.user_id.toLowerCase().includes(search))
            );

            function renderReviewsTable(reviews) {
                const tbody = document.getElementById('reviews-tbody');
                if (!tbody) return;
                if (reviews.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state">Aucun avis trouvé.</div></td></tr>`;
                    return;
                }
                tbody.innerHTML = reviews.map(r => {
                    const safeUserId = escapeHtml(r.user_id ?? '');
                    const safeProductId = escapeHtml(r.product_id ?? '—');
                    const safeComment = escapeHtml(r.comment ?? '');
                    const initial = escapeHtml(r.user_id?.slice(0,1) ?? '?').toUpperCase();
                    const col = avatarColor(r.user_id);
                    return `<tr data-review-id="${r.id}">
                        <td>
                            <div style="display:flex;align-items:center;gap:0.5rem;">
                                <div class="avatar" style="background:${col}22;color:${col};border:1px solid ${col}55;">${initial}</div>
                                <span style="font-size:0.65rem;color:#9ca3af;font-family:monospace;">${safeUserId.slice(0,14)}…</span>
                            </div>
                        </td>
                        <td><div class="stars">${starsHtml(r.rating)}</div></td>
                        <td style="max-width:220px;font-size:0.75rem;color:#d1d5db;line-height:1.4;">${safeComment ? `"${safeComment.slice(0,80)}${safeComment.length>80?'…':''}"` : '<span style="color:#3f3f46;font-style:italic;">Sans commentaire</span>'}</td>
                        <td style="font-size:0.7rem;color:#6b7280;">${safeProductId}</td>
                        <td style="color:#6b7280;font-size:0.72rem;">${fmtDate(r.created_at)}</td>
                        <td>
                            <button class="btn-sm btn-delete" data-review-delete="${r.id}">Supprimer</button>
                        </td>
                    </tr>`;
                }).join('');

                tbody.querySelectorAll('[data-review-delete]').forEach(btn => {
                    btn.addEventListener('click', async () => {
                        if (!confirm('Supprimer cet avis ?')) return;
                        const id = btn.dataset.reviewDelete;
                        const { error } = await supabase.from('reviews').delete().eq('id', id);
                        if (error) { showToast('Erreur suppression', true); return; }
                        allReviews = allReviews.filter(r => r.id != id);
                        document.getElementById('reviews-nav-count').textContent = allReviews.length;
                        const r = document.querySelector('#review-filters .filter-btn.active')?.dataset.rating ?? 'all';
                        const s = document.getElementById('reviews-search')?.value.toLowerCase() ?? '';
                        renderReviewsTable(filterReviews(r, s));
                        showToast('Avis supprimé');
                        renderStats();
                    });
                });
            }

            // ══════════════════════════════════════════════════════════════════
            // LOAD USERS
            // ══════════════════════════════════════════════════════════════════
            async function loadUsers() {
                // On joint profiles + on compte commandes et avis par user_id
                const { data: profiles } = await supabase
                    .from('profiles')
                    .select('id, role, updated_at');

                // On a besoin de l'email : on le déduit des commandes (user_id) et on le stocke en profiles si possible
                // Alternative : récupérer via Supabase Auth Admin API (non dispo côté client)
                // On affiche l'UUID avec les données disponibles
                allUsers = profiles ?? [];

                // Compter commandes et avis par user
                const orderCounts  = {};
                const reviewCounts = {};
                allOrders.forEach(o  => { orderCounts[o.user_id]  = (orderCounts[o.user_id]  || 0) + 1; });
                allReviews.forEach(r => { reviewCounts[r.user_id] = (reviewCounts[r.user_id] || 0) + 1; });

                // Merge unique user_ids from orders + reviews + profiles
                const userIds = new Set([
                    ...allUsers.map(p => p.id),
                    ...allOrders.map(o => o.user_id),
                    ...allReviews.map(r => r.user_id),
                ]);

                allUsers = Array.from(userIds).map(id => {
                    const profile = profiles?.find(p => p.id === id);
                    return {
                        id,
                        role: profile?.role ?? 'user',
                        updated_at: profile?.updated_at,
                        orders:  orderCounts[id]  || 0,
                        reviews: reviewCounts[id] || 0,
                    };
                });

                renderUsersTable(allUsers);

                document.getElementById('users-search')?.addEventListener('input', e => {
                    const q = e.target.value.toLowerCase();
                    renderUsersTable(allUsers.filter(u => u.id.toLowerCase().includes(q)));
                });
            }

            function renderUsersTable(users) {
                const tbody = document.getElementById('users-tbody');
                if (!tbody) return;
                if (users.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7"><div class="empty-state">Aucun utilisateur trouvé.</div></td></tr>`;
                    return;
                }
                tbody.innerHTML = users.map(u => {
                    const safeId = escapeHtml(u.id ?? '');
                    const initial = safeId.slice(0,1).toUpperCase() || '?';
                    const col = avatarColor(u.id);
                    const roleBadge = u.role === 'admin'
                        ? `<span class="badge badge-green">Admin</span>`
                        : `<span class="badge badge-gray">User</span>`;
                    return `<tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:0.6rem;">
                                <div class="avatar" style="background:${col}22;color:${col};border:1px solid ${col}55;">${initial}</div>
                                <span style="font-family:monospace;font-size:0.65rem;color:#9ca3af;">${safeId.slice(0,16)}…</span>
                            </div>
                        </td>
                        <td style="font-size:0.7rem;color:#6b7280;font-style:italic;">Voir Supabase Auth</td>
                        <td>${roleBadge}</td>
                        <td style="text-align:center;">
                            ${u.orders > 0
                                ? `<span class="badge badge-blue">${u.orders}</span>`
                                : `<span style="color:#3f3f46;font-size:0.7rem;">0</span>`}
                        </td>
                        <td style="text-align:center;">
                            ${u.reviews > 0
                                ? `<span class="badge badge-yellow">${u.reviews}</span>`
                                : `<span style="color:#3f3f46;font-size:0.7rem;">0</span>`}
                        </td>
                        <td style="color:#6b7280;font-size:0.72rem;">${u.updated_at ? fmtDate(u.updated_at) : '—'}</td>
                        <td>
                            <select class="status-select role-select" data-user-id="${u.id}" style="font-size:0.65rem;">
                                <option value="user" ${u.role!=='admin'?'selected':''}>User</option>
                                <option value="admin" ${u.role==='admin'?'selected':''}>Admin</option>
                            </select>
                        </td>
                    </tr>`;
                }).join('');

                tbody.querySelectorAll('.role-select').forEach(sel => {
                    sel.addEventListener('change', async () => {
                        const uid = sel.dataset.userId;
                        const { error } = await supabase
                            .from('profiles')
                            .upsert({ id: uid, role: sel.value, updated_at: new Date().toISOString() }, { onConflict: 'id' });
                        if (error) { showToast('Erreur mise à jour rôle', true); return; }
                        const u = allUsers.find(x => x.id === uid);
                        if (u) u.role = sel.value;
                        showToast(`Rôle mis à jour → ${sel.value}`);
                    });
                });
            }

            // ══════════════════════════════════════════════════════════════════
            // RENDER STATS
            // ══════════════════════════════════════════════════════════════════
            function renderStats() {
                // KPIs
                const revenue = allOrders.reduce((a, o) => a + Number(o.total), 0);
                const avgRating = allReviews.length
                    ? (allReviews.reduce((a, r) => a + r.rating, 0) / allReviews.length).toFixed(1)
                    : '—';

                const pending = allOrders.filter(o => o.status === 'en cours').length;

                document.getElementById('kpi-revenue').textContent   = revenue.toFixed(2) + ' €';
                document.getElementById('kpi-revenue-sub').textContent = `${allOrders.length} commandes au total`;
                document.getElementById('kpi-orders').textContent    = allOrders.length;
                document.getElementById('kpi-orders-sub').textContent = `${pending} en attente`;
                document.getElementById('kpi-users').textContent     = allUsers.length;
                document.getElementById('kpi-users-sub').textContent  = `${allUsers.filter(u => u.role==='admin').length} admin(s)`;
                document.getElementById('kpi-rating').textContent    = avgRating;
                document.getElementById('kpi-rating-sub').textContent = `Sur ${allReviews.length} avis`;

                // Bar chart — commandes par mois (6 derniers)
                const now = new Date();
                const months = Array.from({length:6}, (_,i) => {
                    const d = new Date(now.getFullYear(), now.getMonth() - (5-i), 1);
                    return { label: d.toLocaleDateString('fr-FR',{month:'short'}), year: d.getFullYear(), month: d.getMonth(), count: 0 };
                });
                allOrders.forEach(o => {
                    const d = new Date(o.created_at);
                    const m = months.find(x => x.year === d.getFullYear() && x.month === d.getMonth());
                    if (m) m.count++;
                });
                const maxCount = Math.max(...months.map(m => m.count), 1);
                const barChart = document.getElementById('bar-chart');
                if (barChart) {
                    barChart.innerHTML = months.map(m => `
                        <div class="bar-wrap" title="${m.count} commande${m.count>1?'s':''}">
                            <div class="bar" style="height:${Math.max((m.count/maxCount)*100, 4)}%;"
                                data-tooltip="${m.count}"></div>
                            <span class="bar-label">${m.label}</span>
                        </div>`).join('');
                }

                // Donut — statuts
                const statusGroups = { 'en cours': 0, 'expédié': 0, 'livré': 0, 'annulé': 0 };
                allOrders.forEach(o => { if (statusGroups[o.status] !== undefined) statusGroups[o.status]++; });
                const donutColors = { 'en cours':'#eab308', 'expédié':'#60a5fa', 'livré':'#22c55e', 'annulé':'#ef4444' };
                const total = allOrders.length || 1;

                const svg = document.getElementById('donut-svg');
                const legend = document.getElementById('donut-legend');
                if (svg && legend) {
                    let offset = 25; // start at top
                    const radius = 35, cx = 50, cy = 50;
                    const circ = 2 * Math.PI * radius;

                    let paths = '';
                    let legendHtml = '';

                    Object.entries(statusGroups).forEach(([status, count]) => {
                        const pct = count / total;
                        const dash = pct * circ;
                        const gap  = circ - dash;
                        const col  = donutColors[status];
                        paths += `<circle cx="${cx}" cy="${cy}" r="${radius}"
                            fill="none" stroke="${col}" stroke-width="12"
                            stroke-dasharray="${dash} ${gap}"
                            stroke-dashoffset="${-offset * circ / 100}"
                            style="transform:rotate(-90deg);transform-origin:50px 50px;transition:stroke-dasharray 0.6s ease;" />`;
                        offset += pct * 100;
                        legendHtml += `<div class="donut-item">
                            <div class="donut-dot" style="background:${col}"></div>
                            <span style="flex:1;color:#9ca3af;">${status.charAt(0).toUpperCase()+status.slice(1)}</span>
                            <span style="font-weight:900;color:white;">${count}</span>
                        </div>`;
                    });

                    svg.innerHTML = `<circle cx="50" cy="50" r="35" fill="none" stroke="#1a1a1a" stroke-width="12"/>
                        ${paths}
                        <text x="50" y="55" text-anchor="middle" fill="white" font-size="14" font-weight="900" font-style="italic">${total}</text>`;
                    legend.innerHTML = legendHtml;
                }
            }
        </script>
        <script>
            import { initSiteEffects } from "../scripts/site-effects.js";
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener("astro:page-load", runSiteEffects);
            if (document.readyState !== "loading") runSiteEffects();
            else document.addEventListener("DOMContentLoaded", runSiteEffects, { once: true });
        </script>
    </body>
</html>
