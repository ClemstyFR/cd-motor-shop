---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Créer un compte | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show  { transform: translateX(-50%) translateY(0); opacity: 1; }
            #toast.error { background: #dc2626; }

            .account-dropdown { display: none; pointer-events: none; }
            .account-dropdown.is-open { display: block; pointer-events: auto; }

            /* ── Champs ── */
            .field-input {
                width: 100%;
                background: #000;
                border: 1.5px solid rgba(255,255,255,0.1);
                border-radius: 0.75rem;
                padding: 0.8rem 1rem;
                font-size: 0.875rem;
                color: white;
                outline: none;
                transition: border-color 0.2s;
                box-sizing: border-box;
            }
            .field-input::placeholder { color: #4b5563; }
            .field-input:focus  { border-color: #22c55e; }
            .field-input.error  { border-color: #ef4444; }
            .field-input.valid  { border-color: #22c55e; }

            .field-error {
                font-size: 0.65rem;
                font-weight: 700;
                color: #ef4444;
                margin-top: 0.35rem;
                min-height: 1rem;
                letter-spacing: 0.04em;
                display: flex;
                align-items: center;
                gap: 0.3rem;
                opacity: 0;
                transform: translateY(-4px);
                transition: opacity 0.2s, transform 0.2s;
            }
            .field-error.visible { opacity: 1; transform: translateY(0); }

            /* ── Barre de force du mot de passe ── */
            #pw-strength-bar {
                height: 3px;
                border-radius: 99px;
                margin-top: 0.5rem;
                background: rgba(255,255,255,0.08);
                overflow: hidden;
                transition: all 0.3s;
            }
            #pw-strength-fill {
                height: 100%;
                border-radius: 99px;
                width: 0%;
                transition: width 0.4s ease, background 0.3s;
            }
            #pw-strength-label {
                font-size: 0.6rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                margin-top: 0.3rem;
                opacity: 0;
                transition: opacity 0.2s;
            }

            /* ── Critères visuels ── */
            .pw-rule {
                display: flex;
                align-items: center;
                gap: 0.4rem;
                font-size: 0.65rem;
                color: #6b7280;
                transition: color 0.2s;
            }
            .pw-rule.ok { color: #22c55e; }
            .pw-rule-dot {
                width: 5px; height: 5px;
                border-radius: 50%;
                background: currentColor;
                flex-shrink: 0;
                transition: background 0.2s;
            }

            /* ── Toggle mdp ── */
            .pw-wrap { position: relative; }
            .pw-toggle {
                position: absolute; right: 0.85rem; top: 50%; transform: translateY(-50%);
                background: none; border: none; color: #6b7280; cursor: pointer; padding: 0.25rem;
                transition: color 0.2s;
            }
            .pw-toggle:hover { color: #22c55e; }

            /* ── Bouton ── */
            #signup-btn {
                width: 100%; background: #16a34a; color: white;
                font-weight: 900; font-size: 0.875rem; text-transform: uppercase;
                letter-spacing: 0.08em; padding: 1rem; border-radius: 1rem; border: none;
                cursor: pointer; transition: background 0.2s, transform 0.1s, opacity 0.2s;
                margin-top: 0.5rem; position: relative; overflow: hidden;
            }
            #signup-btn:hover   { background: #15803d; }
            #signup-btn:active  { transform: scale(0.98); }
            #signup-btn:disabled { opacity: 0.6; cursor: not-allowed; }
            #signup-btn.loading::after {
                content: '';
                position: absolute; inset: 0;
                background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
                background-size: 200% 100%;
                animation: btn-shimmer 1.2s infinite;
            }
            @keyframes btn-shimmer {
                0%   { background-position: -200% 0; }
                100% { background-position: 200% 0; }
            }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .card { animation: fadeUp 0.5s ease-out 0.1s both; }

            /* ── Succès ── */
            #success-state {
                display: none;
                flex-direction: column;
                align-items: center;
                text-align: center;
                padding: 3rem 1rem;
                gap: 1rem;
                animation: fadeUp 0.5s ease-out both;
            }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans min-h-screen flex flex-col">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> CD MOTOR SHOP
            </a>
            <div class="flex items-center gap-4">
                <a href="/login" class="text-xs font-bold uppercase tracking-widest text-gray-400 hover:text-green-500 transition">
                    Se connecter
                </a>
                <div class="relative">
                    <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                        class="relative p-2 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                        </svg>
                    </button>
                    <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                        class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                        <p id="account-email" class="text-xs text-white font-black truncate mb-4">—</p>
                        <button id="logout-btn"
                            class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                            Se déconnecter
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <!-- FORMULAIRE -->
        <main class="flex-1 flex items-center justify-center px-5 pt-24 pb-16">
            <div class="w-full max-w-md">

                <div class="mb-10 text-center" style="animation: fadeUp 0.4s ease-out both;">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Nouveau</span>
                    <h1 class="text-4xl font-black uppercase italic mt-2">Créer un compte</h1>
                    <p class="text-gray-500 text-sm mt-3">Rejoins la communauté CD Motor Shop</p>
                </div>

                <!-- Formulaire -->
                <div id="form-state" class="card bg-zinc-900 border border-white/10 rounded-3xl p-8" style="display:flex;flex-direction:column;gap:1.25rem;">

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Email</label>
                        <input id="email" type="email" placeholder="ton@email.com" class="field-input" autocomplete="email" />
                        <p class="field-error" id="email-error">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            <span id="email-error-text"></span>
                        </p>
                    </div>

                    <!-- Mot de passe -->
                    <div>
                        <label for="password" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Mot de passe</label>
                        <div class="pw-wrap">
                            <input id="password" type="password" placeholder="••••••••" class="field-input" autocomplete="new-password" style="padding-right:2.75rem;" />
                            <button type="button" class="pw-toggle" id="pw-toggle-1" aria-label="Afficher/masquer">
                                <svg id="pw-eye-1" xmlns="http://www.w3.org/2000/svg" style="height:1.1rem;width:1.1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>

                        <!-- Barre de force -->
                        <div id="pw-strength-bar" style="display:none;">
                            <div id="pw-strength-fill"></div>
                        </div>
                        <p id="pw-strength-label"></p>

                        <!-- Critères -->
                        <div id="pw-rules" style="display:none;margin-top:0.6rem;display:flex;flex-direction:column;gap:0.3rem;">
                            <div class="pw-rule" id="rule-length"><span class="pw-rule-dot"></span>Minimum 6 caractères</div>
                            <div class="pw-rule" id="rule-upper"><span class="pw-rule-dot"></span>Une majuscule</div>
                            <div class="pw-rule" id="rule-number"><span class="pw-rule-dot"></span>Un chiffre</div>
                        </div>

                        <p class="field-error" id="password-error">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            <span id="password-error-text"></span>
                        </p>
                    </div>

                    <!-- Confirmer le mot de passe -->
                    <div>
                        <label for="confirm" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Confirmer le mot de passe</label>
                        <div class="pw-wrap">
                            <input id="confirm" type="password" placeholder="••••••••" class="field-input" autocomplete="new-password" style="padding-right:2.75rem;" />
                            <button type="button" class="pw-toggle" id="pw-toggle-2" aria-label="Afficher/masquer">
                                <svg id="pw-eye-2" xmlns="http://www.w3.org/2000/svg" style="height:1.1rem;width:1.1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                        <p class="field-error" id="confirm-error">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            <span id="confirm-error-text"></span>
                        </p>
                    </div>

                    <button id="signup-btn" type="button">Créer mon compte</button>

                    <p style="text-align:center;font-size:0.75rem;color:#4b5563;padding-top:0.25rem;">
                        Déjà un compte ?
                        <a href="/login" style="color:#22c55e;font-weight:700;text-decoration:none;">Se connecter</a>
                    </p>
                </div>

                <!-- État succès -->
                <div id="success-state" class="bg-zinc-900 border border-white/10 rounded-3xl p-8">
                    <div style="height:4rem;width:4rem;border-radius:50%;background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;margin:0 auto;">
                        <svg xmlns="http://www.w3.org/2000/svg" style="height:1.75rem;width:1.75rem;color:#22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <h2 style="font-weight:900;font-size:1.4rem;text-transform:uppercase;font-style:italic;">Compte créé !</h2>
                    <p style="color:#6b7280;font-size:0.85rem;line-height:1.6;">Un email de confirmation t'a été envoyé.<br>Clique sur le lien pour activer ton compte.</p>
                    <a href="/login" style="display:inline-block;background:#16a34a;color:white;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.875rem 2rem;border-radius:99px;text-decoration:none;transition:background 0.2s;"
                        onmouseover="this.style.background='#15803d'" onmouseout="this.style.background='#16a34a'">
                        Se connecter
                    </a>
                </div>
            </div>
        </main>

        <script>
            import { supabase } from '../lib/supabase';
            import { initAuthNav } from '../scripts/auth-nav.js';

            document.addEventListener('astro:page-load', () => {
                initAuthNav();

                // ── Helpers ──────────────────────────────────────────────────
                const setError = (inputId, errorId, msg) => {
                    const input = document.getElementById(inputId);
                    const errorEl = document.getElementById(errorId);
                    const textEl = document.getElementById(errorId + '-text');
                    if (!input || !errorEl || !textEl) return;
                    input.classList.add('error'); input.classList.remove('valid');
                    textEl.textContent = msg;
                    errorEl.classList.add('visible');
                };
                const clearError = (inputId, errorId) => {
                    const input = document.getElementById(inputId);
                    const errorEl = document.getElementById(errorId);
                    if (!input || !errorEl) return;
                    input.classList.remove('error');
                    errorEl.classList.remove('visible');
                };
                const setValid = (inputId) => {
                    const input = document.getElementById(inputId);
                    if (input) { input.classList.add('valid'); input.classList.remove('error'); }
                };

                // ── Barre de force mot de passe ──────────────────────────────
                const pwInput   = document.getElementById('password');
                const bar       = document.getElementById('pw-strength-bar');
                const fill      = document.getElementById('pw-strength-fill');
                const label     = document.getElementById('pw-strength-label');
                const ruleLen   = document.getElementById('rule-length');
                const ruleUpper = document.getElementById('rule-upper');
                const ruleNum   = document.getElementById('rule-number');

                const calcStrength = (pw) => {
                    let score = 0;
                    if (pw.length >= 6)  score++;
                    if (pw.length >= 10) score++;
                    if (/[A-Z]/.test(pw)) score++;
                    if (/[0-9]/.test(pw)) score++;
                    if (/[^a-zA-Z0-9]/.test(pw)) score++;
                    return score;
                };

                pwInput?.addEventListener('input', () => {
                    const pw = pwInput.value;
                    clearError('password', 'password-error');

                    if (pw.length === 0) {
                        if (bar) bar.style.display = 'none';
                        if (label) { label.style.opacity = '0'; }
                        document.getElementById('pw-rules').style.display = 'none';
                        return;
                    }

                    if (bar) bar.style.display = 'block';
                    document.getElementById('pw-rules').style.display = 'flex';

                    // Critères
                    ruleLen?.classList.toggle('ok', pw.length >= 6);
                    ruleUpper?.classList.toggle('ok', /[A-Z]/.test(pw));
                    ruleNum?.classList.toggle('ok', /[0-9]/.test(pw));

                    const score = calcStrength(pw);
                    const pct = Math.min((score / 5) * 100, 100);
                    if (fill) fill.style.width = pct + '%';

                    const levels = [
                        { min: 0, color: '#ef4444', text: 'Très faible' },
                        { min: 1, color: '#f97316', text: 'Faible' },
                        { min: 2, color: '#eab308', text: 'Moyen' },
                        { min: 3, color: '#84cc16', text: 'Bon' },
                        { min: 4, color: '#22c55e', text: 'Fort' },
                    ];
                    const lvl = [...levels].reverse().find(l => score >= l.min) || levels[0];
                    if (fill) fill.style.background = lvl.color;
                    if (label) {
                        label.style.opacity = '1';
                        label.style.color = lvl.color;
                        label.textContent = lvl.text;
                    }

                    // Si confirm déjà rempli, revérifier la correspondance
                    const confirm = document.getElementById('confirm');
                    if (confirm.value) {
                        if (pw === confirm.value) { clearError('confirm', 'confirm-error'); setValid('confirm'); }
                        else setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas');
                    }
                });

                pwInput?.addEventListener('blur', () => {
                    const pw = pwInput.value;
                    if (!pw) { setError('password', 'password-error', 'Le mot de passe est requis'); return; }
                    if (pw.length < 6) { setError('password', 'password-error', 'Minimum 6 caractères'); return; }
                    clearError('password', 'password-error');
                    setValid('password');
                });

                // ── Email validation ─────────────────────────────────────────
                const emailInput = document.getElementById('email');
                emailInput?.addEventListener('blur', () => {
                    const val = emailInput.value.trim();
                    if (!val) { setError('email', 'email-error', 'L\'email est requis'); return; }
                    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) { setError('email', 'email-error', 'Format d\'email invalide'); return; }
                    clearError('email', 'email-error'); setValid('email');
                });
                emailInput?.addEventListener('input', () => {
                    if (emailInput.classList.contains('error')) clearError('email', 'email-error');
                });

                // ── Confirm validation ───────────────────────────────────────
                const confirmInput = document.getElementById('confirm');
                confirmInput?.addEventListener('input', () => {
                    clearError('confirm', 'confirm-error');
                    if (confirmInput.value && pwInput.value && confirmInput.value !== pwInput.value) {
                        setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas');
                    } else if (confirmInput.value && confirmInput.value === pwInput.value) {
                        setValid('confirm');
                    }
                });

                // ── Toggles afficher/masquer ─────────────────────────────────
                const makeToggle = (btnId, inputId, eyeId) => {
                    document.getElementById(btnId)?.addEventListener('click', () => {
                        const input = document.getElementById(inputId);
                        const isText = input.type === 'text';
                        input.type = isText ? 'password' : 'text';
                        document.getElementById(eyeId).innerHTML = isText
                            ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>'
                            : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
                    });
                };
                makeToggle('pw-toggle-1', 'password', 'pw-eye-1');
                makeToggle('pw-toggle-2', 'confirm',  'pw-eye-2');

                // ── Soumission ────────────────────────────────────────────────
                const submit = async () => {
                    const email   = emailInput?.value.trim() ?? '';
                    const pw      = pwInput?.value ?? '';
                    const confirm = confirmInput?.value ?? '';
                    const btn     = document.getElementById('signup-btn');

                    let hasError = false;
                    if (!email) { setError('email', 'email-error', 'L\'email est requis'); hasError = true; }
                    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'email-error', 'Format d\'email invalide'); hasError = true; }
                    if (!pw) { setError('password', 'password-error', 'Le mot de passe est requis'); hasError = true; }
                    else if (pw.length < 6) { setError('password', 'password-error', 'Minimum 6 caractères'); hasError = true; }
                    if (pw !== confirm) { setError('confirm', 'confirm-error', 'Les mots de passe ne correspondent pas'); hasError = true; }
                    if (hasError) return;

                    btn.textContent = 'Création…';
                    btn.disabled = true;
                    btn.classList.add('loading');

                    const { error } = await supabase.auth.signUp({ email, password: pw });

                    btn.classList.remove('loading');

                    if (error) {
                        btn.textContent = 'Créer mon compte';
                        btn.disabled = false;
                        if (error.message.includes('already')) {
                            setError('email', 'email-error', 'Cet email est déjà utilisé');
                        } else {
                            setError('email', 'email-error', error.message);
                        }
                    } else {
                        document.getElementById('form-state').style.display = 'none';
                        const s = document.getElementById('success-state');
                        s.style.display = 'flex';
                    }
                };

                document.getElementById('signup-btn')?.addEventListener('click', submit);
                document.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
            });
        </script>
    </body>
</html>