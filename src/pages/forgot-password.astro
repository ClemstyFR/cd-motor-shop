---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Mot de passe oublié | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show  { transform: translateX(-50%) translateY(0); opacity: 1; }
            #toast.error { background: #dc2626; }

            .account-dropdown { display: none; pointer-events: none; }
            .account-dropdown.is-open { display: block; pointer-events: auto; }

            .field-wrap { display: flex; flex-direction: column; gap: 0; }

            .field-input {
                width: 100%;
                background: #000;
                border: 1.5px solid rgba(255,255,255,0.1);
                border-radius: 0.75rem;
                padding: 0.8rem 1rem;
                font-size: 0.875rem;
                color: white;
                outline: none;
                transition: border-color 0.2s;
                box-sizing: border-box;
            }
            .field-input::placeholder { color: #4b5563; }
            .field-input:focus  { border-color: #22c55e; }
            .field-input.error  { border-color: #ef4444; }
            .field-input.valid  { border-color: #22c55e; }

            .field-error {
                font-size: 0.65rem;
                font-weight: 700;
                color: #ef4444;
                margin-top: 0.35rem;
                min-height: 1rem;
                letter-spacing: 0.04em;
                display: flex;
                align-items: center;
                gap: 0.3rem;
                opacity: 0;
                transform: translateY(-4px);
                transition: opacity 0.2s, transform 0.2s;
            }
            .field-error.visible { opacity: 1; transform: translateY(0); }

            #send-btn {
                width: 100%;
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 1rem;
                border-radius: 1rem;
                border: none;
                cursor: pointer;
                transition: background 0.2s, transform 0.1s, opacity 0.2s;
                margin-top: 0.5rem;
                position: relative;
                overflow: hidden;
            }
            #send-btn:hover   { background: #15803d; }
            #send-btn:active  { transform: scale(0.98); }
            #send-btn:disabled { opacity: 0.6; cursor: not-allowed; }

            #send-btn.loading::after {
                content: '';
                position: absolute; inset: 0;
                background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
                background-size: 200% 100%;
                animation: btn-shimmer 1.2s infinite;
            }
            @keyframes btn-shimmer {
                0%   { background-position: -200% 0; }
                100% { background-position: 200% 0; }
            }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .card { animation: fadeUp 0.5s ease-out 0.1s both; }

            /* Écran succès */
            #success-screen {
                display: none;
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 1rem;
                padding: 2rem 0;
                animation: fadeUp 0.5s ease-out both;
            }
            #success-screen.visible { display: flex; }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans min-h-screen flex flex-col">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/login" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> Connexion
            </a>
            <div class="relative">
                <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                    class="relative p-2 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                    </svg>
                </button>
                <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                    class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                    <p id="account-email" class="text-xs text-white font-black truncate mb-4">—</p>
                    <button id="logout-btn"
                        class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                        Se déconnecter
                    </button>
                </div>
            </div>
        </nav>

        <!-- FORMULAIRE -->
        <main class="flex-1 flex items-center justify-center px-5 pt-24 pb-16">
            <div class="w-full max-w-md">

                <div class="mb-10 text-center" style="animation: fadeUp 0.4s ease-out both;">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Récupération</span>
                    <h1 class="text-4xl font-black uppercase italic mt-2">Mot de passe oublié</h1>
                    <p class="text-gray-500 text-sm mt-3">Entre ton email pour recevoir un lien de réinitialisation</p>
                </div>

                <div class="card bg-zinc-900 border border-white/10 rounded-3xl p-8" style="display:flex;flex-direction:column;gap:1.25rem;">

                    <!-- Formulaire -->
                    <div id="form-screen" style="display:flex;flex-direction:column;gap:1.25rem;">
                        <div class="field-wrap">
                            <label for="email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Email</label>
                            <input id="email" type="email" placeholder="ton@email.com" class="field-input" autocomplete="email" />
                            <p class="field-error" id="email-error">
                                <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                </svg>
                                <span id="email-error-text"></span>
                            </p>
                        </div>

                        <button id="send-btn" type="button">Envoyer le lien</button>

                        <p style="text-align:center;font-size:0.75rem;color:#4b5563;padding-top:0.25rem;">
                            Tu te souviens ?
                            <a href="/login" style="color:#22c55e;font-weight:700;text-decoration:none;">Se connecter</a>
                        </p>
                    </div>

                    <!-- Écran succès -->
                    <div id="success-screen">
                        <div style="width:4rem;height:4rem;border-radius:50%;background:rgba(34,197,94,0.12);border:1px solid rgba(34,197,94,0.3);display:flex;align-items:center;justify-content:center;">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:1.75rem;width:1.75rem;color:#22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h2 style="font-weight:900;font-size:1.1rem;text-transform:uppercase;font-style:italic;color:white;">Email envoyé !</h2>
                        <p style="color:#6b7280;font-size:0.85rem;line-height:1.6;">Vérifie ta boîte mail et clique sur le lien pour réinitialiser ton mot de passe.<br>Pense à vérifier tes spams.</p>
                        <a href="/login" style="margin-top:0.5rem;background:#16a34a;color:white;font-weight:900;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;padding:0.75rem 2rem;border-radius:99px;text-decoration:none;">
                            Retour à la connexion
                        </a>
                    </div>

                </div>
            </div>
        </main>

        <script>
            import { supabase } from '../lib/supabase';
            import { initAuthNav } from '../scripts/auth-nav.js';

            document.addEventListener('astro:page-load', () => {
                initAuthNav();

                // Redirect si déjà connecté
                supabase.auth.getUser().then(({ data: { user } }) => {
                    if (user) window.location.href = '/account';
                });

                const emailInput  = document.getElementById('email');
                const sendBtn     = document.getElementById('send-btn');
                const formScreen  = document.getElementById('form-screen');
                const successScreen = document.getElementById('success-screen');

                const setError = (msg) => {
                    const input   = document.getElementById('email');
                    const errorEl = document.getElementById('email-error');
                    const textEl  = document.getElementById('email-error-text');
                    if (!input || !errorEl || !textEl) return;
                    input.classList.add('error');
                    input.classList.remove('valid');
                    textEl.textContent = msg;
                    errorEl.classList.add('visible');
                };

                const clearError = () => {
                    const input   = document.getElementById('email');
                    const errorEl = document.getElementById('email-error');
                    if (!input || !errorEl) return;
                    input.classList.remove('error');
                    errorEl.classList.remove('visible');
                };

                emailInput?.addEventListener('input', () => {
                    if (emailInput.classList.contains('error')) clearError();
                });

                const submit = async () => {
                    const email = emailInput?.value.trim() ?? '';

                    if (!email) { setError('L\'email est requis'); return; }
                    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('Format d\'email invalide'); return; }

                    sendBtn.textContent = 'Envoi…';
                    sendBtn.disabled = true;
                    sendBtn.classList.add('loading');

                    const { error } = await supabase.auth.resetPasswordForEmail(email, {
                        redirectTo: `${window.location.origin}/reset-password`,
                    });

                    sendBtn.classList.remove('loading');

                    if (error) {
                        sendBtn.textContent = 'Envoyer le lien';
                        sendBtn.disabled = false;
                        setError('Une erreur est survenue, réessaie.');
                    } else {
                        // Affiche l'écran succès même si l'email n'existe pas (sécurité)
                        if (formScreen)    formScreen.style.display = 'none';
                        if (successScreen) successScreen.classList.add('visible');
                    }
                };

                sendBtn?.addEventListener('click', submit);
                document.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
            });
        </script>
    </body>
</html>
