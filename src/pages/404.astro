---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>404 — Page introuvable | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            body {
                background: #000;
                color: white;
                font-family: sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* ── Orbes décoratives ── */
            #orbs {
                position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
            }
            .orb {
                position: absolute; border-radius: 50%;
                background: radial-gradient(circle, rgba(34,197,94,0.4) 0%, rgba(22,163,74,0.15) 45%, transparent 70%);
                filter: blur(70px); will-change: transform;
            }
            .orb-1 { width: 500px; height: 500px; top: -200px; left: -150px; opacity: 0.3; animation: drift1 18s ease-in-out infinite alternate; }
            .orb-2 { width: 300px; height: 300px; bottom: -100px; right: -80px; opacity: 0.2; animation: drift2 22s ease-in-out infinite alternate; }
            @keyframes drift1 { 0% { transform: translate(0,0); } 100% { transform: translate(50px,40px); } }
            @keyframes drift2 { 0% { transform: translate(0,0); } 100% { transform: translate(-40px,-30px); } }

            /* ── Contenu ── */
            main {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 6rem 1.25rem 3rem;
                position: relative;
                z-index: 1;
            }

            .container {
                text-align: center;
                max-width: 520px;
                animation: fadeUp 0.7s ease-out both;
            }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(24px); }
                to   { opacity: 1; transform: translateY(0); }
            }

            /* ── Chiffre 404 ── */
            .big-404 {
                font-size: clamp(7rem, 20vw, 12rem);
                font-weight: 900;
                font-style: italic;
                line-height: 1;
                letter-spacing: -0.04em;
                background: linear-gradient(135deg, #22c55e 0%, #15803d 50%, #052e16 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                user-select: none;
                margin-bottom: 0;
            }

            .tag {
                display: inline-block;
                background: rgba(34,197,94,0.1);
                border: 1px solid rgba(34,197,94,0.25);
                color: #22c55e;
                font-size: 0.65rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                padding: 0.35rem 0.9rem;
                border-radius: 99px;
                margin-bottom: 1.5rem;
            }

            h1 {
                font-size: clamp(1.6rem, 5vw, 2.5rem);
                font-weight: 900;
                text-transform: uppercase;
                font-style: italic;
                letter-spacing: -0.02em;
                margin: 0.5rem 0 1rem;
                line-height: 1.1;
            }

            .desc {
                color: #6b7280;
                font-size: 0.9rem;
                line-height: 1.7;
                margin-bottom: 2.5rem;
            }

            /* ── Boutons ── */
            .actions {
                display: flex;
                gap: 0.875rem;
                justify-content: center;
                flex-wrap: wrap;
            }

            .btn-primary {
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.875rem 2rem;
                border-radius: 99px;
                text-decoration: none;
                transition: background 0.2s, transform 0.1s;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }
            .btn-primary:hover  { background: #15803d; }
            .btn-primary:active { transform: scale(0.97); }

            .btn-secondary {
                background: transparent;
                color: #9ca3af;
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.875rem 2rem;
                border-radius: 99px;
                text-decoration: none;
                border: 1px solid rgba(255,255,255,0.1);
                transition: border-color 0.2s, color 0.2s;
            }
            .btn-secondary:hover { border-color: rgba(255,255,255,0.25); color: white; }

            /* ── Liens rapides ── */
            .quick-links {
                margin-top: 3rem;
                padding-top: 2rem;
                border-top: 1px solid rgba(255,255,255,0.06);
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                justify-content: center;
            }

            .quick-link {
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: #4b5563;
                text-decoration: none;
                padding: 0.4rem 0.9rem;
                border-radius: 99px;
                border: 1px solid rgba(255,255,255,0.06);
                transition: color 0.2s, border-color 0.2s;
            }
            .quick-link:hover { color: #22c55e; border-color: rgba(34,197,94,0.3); }

            /* ── Icône engrenage animée ── */
            .icon-wrap {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 5rem;
                height: 5rem;
                border-radius: 50%;
                background: rgba(34,197,94,0.08);
                border: 1px solid rgba(34,197,94,0.15);
                margin-bottom: 1.5rem;
            }
            .icon-wrap svg {
                animation: spin-slow 8s linear infinite;
            }
            @keyframes spin-slow {
                from { transform: rotate(0deg); }
                to   { transform: rotate(360deg); }
            }

            /* ── Navbar minimaliste ── */
            nav {
                position: fixed;
                top: 0; left: 0; right: 0;
                z-index: 50;
                background: rgba(0,0,0,0.8);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid rgba(255,255,255,0.06);
                padding: 1.25rem 2.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .logo {
                font-size: 1.1rem;
                font-weight: 900;
                font-style: italic;
                letter-spacing: -0.03em;
                text-decoration: none;
                color: white;
                transition: color 0.2s;
            }
            .logo:hover { color: #22c55e; }
            .logo span { color: #16a34a; }
        </style>
        <ClientRouter/>
    </head>
    <body>

        <!-- Orbes fond -->
        <div id="orbs" aria-hidden="true">
            <span class="orb orb-1"></span>
            <span class="orb orb-2"></span>
        </div>

        <!-- Navbar -->
        <nav>
            <a href="/" class="logo"><span>CD</span> MOTOR SHOP</a>
            <a href="/" class="btn-secondary" style="padding:0.5rem 1.25rem;">← Retour</a>
        </nav>

        <!-- Contenu principal -->
        <main>
            <div class="container">

                <!-- Icône -->
                <div class="icon-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" style="height:2rem;width:2rem;color:#22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>

                <!-- 404 -->
                <div class="big-404">404</div>

                <div class="tag">Page introuvable</div>

                <h1>Cette page a changé de vitesse</h1>

                <p class="desc">
                    La page que tu cherches n'existe pas ou a été déplacée.<br>
                    Pas de panique — retourne à la boutique.
                </p>

                <div class="actions">
                    <a href="/" class="btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" style="height:0.9rem;width:0.9rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                        Retour à l'accueil
                    </a>
                    <a href="/deepmatte" class="btn-secondary">Voir le Deep Matte</a>
                </div>

                <div class="quick-links">
                    <a href="/account" class="quick-link">Mon compte</a>
                    <a href="/orders" class="quick-link">Mes commandes</a>
                    <a href="/login" class="quick-link">Connexion</a>
                    <a href="/contact" class="quick-link">Contact</a>
                </div>

            </div>
        </main>
        <script>
            import { initSiteEffects } from "../scripts/site-effects.js";
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener("astro:page-load", runSiteEffects);
            if (document.readyState !== "loading") runSiteEffects();
            else document.addEventListener("DOMContentLoaded", runSiteEffects, { once: true });
        </script>
    </body>
</html>
