        <script>
            document.addEventListener('astro:page-load', () => {

                // ─── GALERIE PRODUIT ─────────────────────────────────────────────────────
                const mainImg   = document.getElementById('prod-img');
                const thumbs    = document.querySelectorAll('.thumb');
                const galleryPrev = document.getElementById('gallery-prev');
                const galleryNext = document.getElementById('gallery-next');
                const galleryMain = document.getElementById('gallery-main');

                if (mainImg && thumbs.length > 0) {
                    let currentImg = 0;

                    const goToImage = (idx) => {
                        const nextImg = (idx + thumbs.length) % thumbs.length;
                        const direction = nextImg > currentImg || (currentImg === thumbs.length - 1 && nextImg === 0) ? 'left' : 'right';
                        currentImg = nextImg;

                        mainImg.classList.remove('is-sliding-out-left', 'is-sliding-out-right', 'is-sliding-in-left', 'is-sliding-in-right');
                        mainImg.classList.add(`is-sliding-out-${direction}`);
                        setTimeout(() => {
                            mainImg.src = thumbs[currentImg].querySelector('img').src;
                            mainImg.classList.remove(`is-sliding-out-${direction}`);
                            mainImg.classList.add(`is-sliding-in-${direction}`);
                            requestAnimationFrame(() => {
                                mainImg.classList.remove(`is-sliding-in-${direction}`);
                            });
                        }, 170);

                        // Mettre à jour les miniatures actives
                        thumbs.forEach((t, i) => t.classList.toggle('active', i === currentImg));
                    };

                    // Clic sur une miniature
                    thumbs.forEach((thumb, i) => {
                        thumb.addEventListener('click', () => goToImage(i));
                    });

                    // Flèches
                    galleryPrev?.addEventListener('click', () => goToImage(currentImg - 1));
                    galleryNext?.addEventListener('click', () => goToImage(currentImg + 1));
                }

                const accordionItems = Array.from(document.querySelectorAll('.accordion-item'));
                accordionItems.forEach((item) => {
                    const summary = item.querySelector('summary');
                    const panel = item.querySelector('.accordion-panel');
                    if (!summary || !panel) return;

                    const setPanelHeight = () => {
                        if (item.open) panel.style.height = `${panel.scrollHeight}px`;
                    };

                    const openItem = () => {
                        item.open = true;
                        item.classList.add('is-open');
                        panel.style.height = '0px';
                        panel.style.opacity = '0';
                        requestAnimationFrame(() => {
                            panel.style.height = `${panel.scrollHeight}px`;
                            panel.style.opacity = '1';
                        });
                    };

                    const closeItem = () => {
                        panel.style.height = `${panel.scrollHeight}px`;
                        requestAnimationFrame(() => {
                            item.classList.remove('is-open');
                            panel.style.height = '0px';
                            panel.style.opacity = '0';
                        });
                    };

                    const onTransitionEnd = (event) => {
                        if (event.propertyName !== 'height') return;
                        if (item.classList.contains('is-open')) {
                            panel.style.height = 'auto';
                        } else {
                            item.open = false;
                        }
                    };

                    summary.addEventListener('click', (event) => {
                        event.preventDefault();
                        if (item.open && item.classList.contains('is-open')) closeItem();
                        else openItem();
                    });

                    panel.addEventListener('transitionend', onTransitionEnd);
                    window.addEventListener('resize', setPanelHeight);
                });

                const mainCartBtn = document.getElementById('add-to-cart');
                const stickyCartBar = document.getElementById('sticky-cart-bar');
                if (mainCartBtn && stickyCartBar) {
                    const updateStickyCart = () => {
                        const show = mainCartBtn.getBoundingClientRect().bottom < 0;
                        stickyCartBar.classList.toggle('opacity-0', !show);
                        stickyCartBar.classList.toggle('pointer-events-none', !show);
                        stickyCartBar.classList.toggle('translate-y-full', !show);
                        stickyCartBar.classList.toggle('md:translate-y-4', !show);
                        stickyCartBar.classList.toggle('opacity-100', show);
                        stickyCartBar.classList.toggle('translate-y-0', show);
                    };

                    updateStickyCart();
                    window.addEventListener('scroll', updateStickyCart, { passive: true });
                    window.addEventListener('resize', updateStickyCart);
                }

            });
        </script>

        <!-- ── AVIS + FORMULAIRE ───────────────────────────────────────────────── -->
        <script>
            import { initCart }    from '../scripts/cart.js';
            import { initAuthNav } from '../scripts/auth-nav.js';
            import { supabase }    from '../lib/supabase.js';

            document.addEventListener('astro:page-load', async () => {
                // Lire les infos produit depuis le data-attribute HTML
                const section    = document.getElementById('review-form-section');
                const PRODUCT_ID = section?.dataset.productId ?? 'deep-matte-01';
                const enStock    = section?.dataset.productEnStock !== 'false';

                // ── Sélecteur de quantité ────────────────────────────────────────
                const qtyMinus = document.getElementById('qty-minus');
                const qtyPlus  = document.getElementById('qty-plus');
                const qtyValue = document.getElementById('qty-value');
                const qtyTotal = document.getElementById('qty-total');
                const PRIX     = 29.90;
                let qty = 1;

                const updateQty = () => {
                    if (qtyValue) qtyValue.textContent = qty;
                    if (qtyTotal) qtyTotal.textContent = (qty * PRIX).toFixed(2) + '€';
                    if (qtyMinus) qtyMinus.style.opacity = qty <= 1 ? '0.3' : '1';
                };

                qtyMinus?.addEventListener('click', () => {
                    if (qty > 1) { qty--; updateQty(); }
                });
                qtyPlus?.addEventListener('click', () => {
                    qty++;
                    updateQty();
                });

                initAuthNav();
                if (enStock) initCart({
                    id: PRODUCT_ID,
                    nom: 'Deep Matte',
                    prix: 29.90,
                    getQty: () => qty,
                    resetQty: () => { qty = 1; updateQty(); },
                });

                // ── Toast ────────────────────────────────────────────────────────
                let toastTimer = null;
                const showToast = (msg, err = false) => {
                    const t = document.getElementById('toast');
                    if (!t) return;
                    t.textContent = (err ? '✕ ' : '✓ ') + msg;
                    t.style.background = err ? '#dc2626' : '#16a34a';
                    t.classList.add('show');
                    clearTimeout(toastTimer);
                    toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
                };

                // ── Couleurs avatar par initiale ─────────────────────────────────
                const COLORS = ['#16a34a','#2563eb','#9333ea','#ea580c','#db2777','#0891b2'];
                const avatarColor = (str) => COLORS[str.charCodeAt(0) % COLORS.length];
                const escapeHtml = (value) => String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#39;');

                // ── Étoiles en HTML ──────────────────────────────────────────────
                const starsHtml = (n) => Array.from({length:5}, (_,i) =>
                    `<span style="color:${i < n ? '#facc15' : '#3f3f46'}">★</span>`
                ).join('');
                const starsText = (rating) => Array.from({ length: 5 }, (_, i) => i < Math.round(rating) ? '★' : '☆').join('');

                // ── Formater la date ─────────────────────────────────────────────
                const fmtDate = (iso) => new Date(iso).toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'});

                // ── Charger et afficher les avis ─────────────────────────────────
                const reviewsEmpty  = document.getElementById('reviews-empty');
                const reviewsSlider = document.getElementById('reviews-slider');
                const reviewsTrack  = document.getElementById('reviews-track');
                const dotsEl        = document.getElementById('rev-dots');
                const prevBtn       = document.getElementById('rev-prev');
                const nextBtn       = document.getElementById('rev-next');
                const ratingScoreEl = document.getElementById('rating-score');
                const ratingStarsEl = document.getElementById('rating-stars');
                const ratingCountLabelEl = document.getElementById('rating-count-label');
                const productRatingInlineEl = document.getElementById('product-rating-inline');
                const productRatingCountEl = document.getElementById('product-rating-count');

                // Carte d'avis HTML
                const reviewCard = (r) => {
                    const userId = String(r.user_id ?? 'user');
                    const initial = escapeHtml(userId.slice(0,1).toUpperCase());
                    const col = avatarColor(userId);
                    const comment = escapeHtml(r.comment || '');
                    return `<div class="review-card-glow review-slide" style="flex:0 0 100%;width:100%;max-width:100%;min-width:0;background:#18181b;border:1px solid rgba(255,255,255,0.06);border-radius:1.5rem;padding:1.5rem;display:flex;flex-direction:column;gap:1rem;box-sizing:border-box;">
                        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:0.5rem;">
                            <div style="font-size:1.1rem;">${starsHtml(r.rating)}</div>
                            <span style="font-size:0.6rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#22c55e;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.2);padding:0.2rem 0.6rem;border-radius:99px;white-space:nowrap;flex-shrink:0;">✓ Vérifié</span>
                        </div>
                        <p style="font-size:0.825rem;color:#d1d5db;line-height:1.65;flex:1;">"${comment}"</p>
                        <div style="display:flex;align-items:center;gap:0.75rem;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.05);">
                            <div style="height:2.2rem;width:2.2rem;border-radius:50%;background:${col}22;border:1px solid ${col}66;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:0.8rem;color:${col};flex-shrink:0;">${initial}</div>
                            <p style="font-size:0.65rem;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;">${fmtDate(r.created_at)}</p>
                        </div>
                    </div>`;
                };

                // Slider logic
                let sliderIndex = 0;
                let sliderData  = [];
                const reviewsPerPage = () => window.matchMedia('(min-width: 768px)').matches ? 2 : 1;
                const REVIEWS_GAP = 20;

                const applyReviewLayout = () => {
                    if (!reviewsTrack) return { pages: 1, trackW: 0 };

                    const perPage = reviewsPerPage();
                    const trackW = reviewsTrack.parentElement?.offsetWidth ?? 0;
                    const cardW = perPage === 1 ? trackW : Math.max(0, (trackW - REVIEWS_GAP) / 2);

                    reviewsTrack.style.gap = `${REVIEWS_GAP}px`;
                    reviewsTrack.querySelectorAll('.review-slide').forEach((card) => {
                        card.style.flex = `0 0 ${cardW}px`;
                        card.style.width = `${cardW}px`;
                        card.style.maxWidth = `${cardW}px`;
                    });

                    return {
                        pages: Math.max(1, Math.ceil(sliderData.length / perPage)),
                        trackW,
                    };
                };

                const buildSlider = (data) => {
                    sliderData = data;
                    if (!reviewsTrack) return;

                    reviewsTrack.innerHTML = data.map(r => reviewCard(r)).join('');
                    const { pages } = applyReviewLayout();

                    // Dots — un par page, avec 1 avis/page sur mobile et 2 sur desktop
                    if (dotsEl) {
                        dotsEl.innerHTML = Array.from({length: pages}, (_, i) => `
                            <button data-page="${i}" aria-label="Page ${i+1}"
                                style="height:8px;border-radius:99px;border:none;cursor:pointer;transition:width 0.3s,background 0.3s;background:${i===0?'#22c55e':'rgba(255,255,255,0.2)'};width:${i===0?'1.5rem':'0.5rem'};"></button>
                        `).join('');
                        dotsEl.querySelectorAll('button').forEach(btn => {
                            btn.addEventListener('click', () => goTo(parseInt(btn.dataset.page)));
                        });
                    }

                    sliderIndex = 0;
                    updateSlider();
                };

                const updateRatingSummary = (reviews = []) => {
                    const total = reviews.length;

                    if (total === 0) {
                        if (ratingScoreEl) ratingScoreEl.textContent = '—';
                        if (ratingStarsEl) ratingStarsEl.textContent = '☆☆☆☆☆';
                        if (ratingCountLabelEl) ratingCountLabelEl.textContent = 'Aucun avis vérifié';
                        if (productRatingInlineEl) productRatingInlineEl.textContent = '—';
                        if (productRatingCountEl) productRatingCountEl.textContent = '0';
                        [1, 2, 3, 4, 5].forEach((rating) => {
                            const bar = document.querySelector(`[data-rating-bar="${rating}"]`);
                            const percent = document.querySelector(`[data-rating-percent="${rating}"]`);
                            if (bar) bar.style.width = '0%';
                            if (percent) percent.textContent = '0%';
                        });
                        return;
                    }

                    const average = reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / total;
                    const averageText = average.toFixed(1);
                    const counts = reviews.reduce((acc, review) => {
                        const rating = Math.max(1, Math.min(5, Number(review.rating || 0)));
                        acc[rating] = (acc[rating] || 0) + 1;
                        return acc;
                    }, {});

                    if (ratingScoreEl) ratingScoreEl.textContent = averageText;
                    if (ratingStarsEl) ratingStarsEl.textContent = starsText(average);
                    if (ratingCountLabelEl) ratingCountLabelEl.textContent = `${total} avis vérifié${total > 1 ? 's' : ''}`;
                    if (productRatingInlineEl) productRatingInlineEl.textContent = averageText;
                    if (productRatingCountEl) productRatingCountEl.textContent = String(total);

                    [1, 2, 3, 4, 5].forEach((rating) => {
                        const value = Math.round(((counts[rating] || 0) / total) * 100);
                        const bar = document.querySelector(`[data-rating-bar="${rating}"]`);
                        const percent = document.querySelector(`[data-rating-percent="${rating}"]`);
                        if (bar) bar.style.width = `${value}%`;
                        if (percent) percent.textContent = `${value}%`;
                    });
                };

                const goTo = (page) => {
                    const { pages } = applyReviewLayout();
                    sliderIndex = Math.max(0, Math.min(page, pages - 1));
                    updateSlider();
                };

                const updateSlider = () => {
                    if (!reviewsTrack) return;
                    const { pages, trackW } = applyReviewLayout();
                    const offset = sliderIndex * (trackW + REVIEWS_GAP);
                    reviewsTrack.style.transform = `translateX(-${offset}px)`;

                    // Update dots
                    dotsEl?.querySelectorAll('button').forEach((btn, i) => {
                        const active = i === sliderIndex;
                        btn.style.background = active ? '#22c55e' : 'rgba(255,255,255,0.2)';
                        btn.style.width = active ? '1.5rem' : '0.5rem';
                    });

                    // Update arrows opacity
                    if (prevBtn) prevBtn.style.opacity = sliderIndex === 0 ? '0.3' : '1';
                    if (nextBtn) nextBtn.style.opacity = sliderIndex >= pages - 1 ? '0.3' : '1';
                };

                prevBtn?.addEventListener('click', () => goTo(sliderIndex - 1));
                nextBtn?.addEventListener('click', () => goTo(sliderIndex + 1));
                window.addEventListener('resize', () => {
                    if (!sliderData.length) return;
                    const { pages } = applyReviewLayout();
                    sliderIndex = Math.min(sliderIndex, pages - 1);
                    updateSlider();
                });

                const loadReviews = async () => {
                    const skeleton = document.getElementById('reviews-skeleton');

                    const { data: reviews, error } = await supabase
                        .from('reviews')
                        .select('id,rating,comment,created_at,user_id')
                        .eq('product_id', PRODUCT_ID)
                        .order('created_at', { ascending: false });

                    if (skeleton) skeleton.style.display = 'none';
                    if (error) console.error('Supabase reviews error:', error);

                    const data = reviews ?? [];
                    updateRatingSummary(data);

                    if (data.length === 0) {
                        if (reviewsEmpty) reviewsEmpty.style.display = 'block';
                        if (reviewsSlider) reviewsSlider.style.display = 'none';
                        return [];
                    }

                    if (reviewsEmpty) reviewsEmpty.style.display = 'none';
                    if (reviewsSlider) reviewsSlider.style.display = 'block';
                    buildSlider(data);

                    return data;
                };

                const reviews = await loadReviews();

                // ── Auth + état formulaire ───────────────────────────────────────
                const { data: { user } } = await supabase.auth.getUser();

                const authWall    = document.getElementById('review-auth-wall');
                const alreadyDiv  = document.getElementById('review-already');
                const formDiv     = document.getElementById('review-form');

                if (!user) {
                    if (authWall) authWall.style.display = 'block';
                } else {
                    const existing = reviews.find(r => r.user_id === user.id);
                    if (existing) {
                        if (alreadyDiv) alreadyDiv.style.display = 'flex';
                    } else {
                        if (formDiv) formDiv.style.display = 'flex';
                    }
                }

                // Bouton "Modifier" → rouvre le formulaire
                document.getElementById('edit-review-btn')?.addEventListener('click', () => {
                    if (alreadyDiv) alreadyDiv.style.display = 'none';
                    if (formDiv)    formDiv.style.display = 'flex';
                    // Pré-remplir avec l'avis existant
                    const existing = reviews.find(r => r.user_id === user?.id);
                    if (existing) {
                        selectedRating = existing.rating;
                        renderStars();
                        const ta = document.getElementById('review-comment');
                        if (ta) ta.value = existing.comment ?? '';
                    }
                });

                // ── Sélecteur d'étoiles ──────────────────────────────────────────
                let selectedRating = 0;
                const starBtns = document.querySelectorAll('#star-picker button');

                const renderStars = () => {
                    starBtns.forEach(btn => {
                        const n = parseInt(btn.dataset.star);
                        btn.style.color = n <= selectedRating ? '#facc15' : '#3f3f46';
                    });
                };

                starBtns.forEach(btn => {
                    const n = parseInt(btn.dataset.star);
                    btn.addEventListener('mouseover', () => {
                        starBtns.forEach(b => { b.style.color = parseInt(b.dataset.star) <= n ? '#facc15' : '#3f3f46'; });
                    });
                    btn.addEventListener('mouseout', renderStars);
                    btn.addEventListener('click', () => { selectedRating = n; renderStars(); });
                });

                // ── Soumettre l'avis ─────────────────────────────────────────────
                document.getElementById('submit-review-btn')?.addEventListener('click', async () => {
                    if (!selectedRating) { showToast('Choisis une note !', true); return; }
                    const comment = document.getElementById('review-comment')?.value.trim() ?? '';

                    const submitBtn = document.getElementById('submit-review-btn');
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Publication…';

                    const { error } = await supabase.from('reviews').upsert({
                        user_id:    user.id,
                        product_id: PRODUCT_ID,
                        rating:     selectedRating,
                        comment:    comment || null,
                    }, { onConflict: 'user_id,product_id' });

                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Publier l\'avis';

                    if (error) { showToast('Erreur lors de la publication', true); return; }

                    showToast('Avis publié ! Merci 🙏');
                    if (formDiv)   formDiv.style.display = 'none';
                    if (alreadyDiv) alreadyDiv.style.display = 'flex';
                    await loadReviews();
                });
            });
        </script>
        <script>
            document.addEventListener('astro:page-load', () => {
                if (!window.matchMedia('(hover: hover)').matches) return;
                const INTENSITY = 8;
                document.querySelectorAll('.tilt-card').forEach(card => {
                    card.addEventListener('mousemove', (e) => {
                        const rect = card.getBoundingClientRect();
                        const x = (e.clientX - rect.left) / rect.width  - 0.5;
                        const y = (e.clientY - rect.top)  / rect.height - 0.5;
                        card.style.transition = 'transform 0.1s ease-out, box-shadow 0.1s ease-out';
                        card.style.transform = `perspective(800px) rotateX(${(-y * INTENSITY).toFixed(2)}deg) rotateY(${(x * INTENSITY).toFixed(2)}deg) scale(1.02)`;
                        card.style.boxShadow = '0 20px 60px rgba(0,0,0,0.5), 0 0 30px rgba(34,197,94,0.06)';
                    });
                    card.addEventListener('mouseleave', () => {
                        card.style.transition = 'transform 0.5s ease-out, box-shadow 0.5s ease-out';
                        card.style.transform  = 'perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)';
                        card.style.boxShadow  = '';
                        setTimeout(() => { card.style.transition = 'transform 0.1s ease-out, box-shadow 0.1s ease-out'; }, 500);
                    });
                });
            });
        </script>
        <script>
            document.addEventListener('astro:page-load', () => {
                const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                const revealItems = Array.from(document.querySelectorAll('.deep-reveal, .tilt-card, #rating-card, .review-card, .install-steps, .install-result, .home-footer'));
                revealItems.forEach((item, index) => {
                    item.style.transitionDelay = `${Math.min(index * 55, 220)}ms`;
                    if (reduceMotion) item.classList.add('is-visible');
                });

                if (!reduceMotion && 'IntersectionObserver' in window) {
                    const revealObserver = new IntersectionObserver((entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.classList.add('is-visible');
                            entry.target.style.transitionDelay = '0ms';
                            revealObserver.unobserve(entry.target);
                        });
                    }, { threshold: 0.18, rootMargin: '0px 0px -10% 0px' });

                    revealItems.forEach((item) => revealObserver.observe(item));
                } else {
                    revealItems.forEach((item) => item.classList.add('is-visible'));
                }

                const counters = Array.from(document.querySelectorAll('[data-count-to]'));
                const animateCounter = (el) => {
                    if (el.dataset.counted === 'true') return;
                    el.dataset.counted = 'true';
                    const target = Number(el.dataset.countTo);
                    const decimals = Number(el.dataset.countDecimals || 0);
                    if (!Number.isFinite(target)) return;

                    if (reduceMotion) {
                        el.textContent = target.toFixed(decimals);
                        return;
                    }

                    const duration = 950;
                    const start = performance.now();
                    const easeOut = (t) => 1 - Math.pow(1 - t, 3);

                    const tick = (now) => {
                        const progress = Math.min((now - start) / duration, 1);
                        el.textContent = (target * easeOut(progress)).toFixed(decimals);
                        if (progress < 1) requestAnimationFrame(tick);
                    };

                    requestAnimationFrame(tick);
                };

                if (!('IntersectionObserver' in window)) {
                    counters.forEach(animateCounter);
                    return;
                }

                const counterObserver = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        animateCounter(entry.target);
                        counterObserver.unobserve(entry.target);
                    });
                }, { threshold: 0.45 });

                counters.forEach((counter) => counterObserver.observe(counter));
            });
        </script>
        <script>
            document.addEventListener('astro:page-load', () => {
                const card = document.getElementById('rating-card');
                if (!card) return;
                let raf, angle = 0;
                const speed = 0.08;
                function tick() {
                    angle = (angle + speed) % 360;
                    card.style.setProperty('--angle', angle + 'deg');
                    raf = requestAnimationFrame(tick);
                }
                card.addEventListener('mouseenter', () => {
                    card.classList.add('border-active');
                    raf = requestAnimationFrame(tick);
                });
                card.addEventListener('mouseleave', () => {
                    card.classList.remove('border-active');
                    cancelAnimationFrame(raf);
                });
            });
        </script>
        <script>
            import { initSiteEffects } from '../scripts/site-effects.js';
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener("astro:page-load", runSiteEffects);
            if (document.readyState !== "loading") runSiteEffects();
            else document.addEventListener("DOMContentLoaded", runSiteEffects, { once: true });
        </script>
    </body>
