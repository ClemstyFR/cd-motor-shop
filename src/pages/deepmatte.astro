---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image6.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image5.png';
import imageBlackMatte4 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = { 
    id: "deep-matte-01",
    nom: "Deep Matte", 
    description: "Finition aluminium premium, prise en main parfaite pour une précision maximale.",
    prix: 29.90,
    enStock: true, // Variable de contrôle
};

const images = [
    imageBlackMatte1.src,
    imageBlackMatte2.src,
    imageBlackMatte3.src,
    imageBlackMatte4.src,
];
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>{product.nom} | Pommeau de levier premium — CD Motor Shop</title>
        <meta name="description" content="Deep Matte — Pommeau de levier de vitesse en aluminium premium. Compatibilité universelle M8/M10/M12, livraison gratuite, retour 30 jours." />
        <meta property="og:title" content="Deep Matte | Pommeau aluminium premium — CD Motor Shop" />
        <meta property="og:description" content="Finition aluminium mat premium, prise en main parfaite. Bagues M8/M10/M12 incluses. Livraison gratuite." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app/deepmatte" />
        <meta property="og:type" content="product" />
        <meta name="twitter:card" content="summary_large_image" />
        <style>
            html { scroll-behavior: smooth; }

            :root {
                --ease: cubic-bezier(0.22, 1, 0.36, 1);
            }

            .motion-shine {
                position: relative;
                isolation: isolate;
                overflow: hidden;
            }

            .motion-shine::before {
                content: "";
                position: absolute;
                inset: -80%;
                z-index: 0;
                pointer-events: none;
                background: radial-gradient(circle, rgba(103,232,249,0.32), transparent 38%);
                opacity: 0;
                transform: translate3d(-18%, 18%, 0) scale(0.78);
                transition: opacity 280ms var(--ease), transform 520ms var(--ease);
            }

            .motion-shine::after {
                content: "";
                position: absolute;
                inset: 0;
                z-index: 0;
                pointer-events: none;
                background: linear-gradient(110deg, transparent 0 34%, rgba(255,255,255,0.34) 48%, transparent 62%);
                transform: translateX(-120%);
                transition: transform 650ms var(--ease);
            }

            .motion-shine:hover::before {
                opacity: 1;
                transform: translate3d(12%, -8%, 0) scale(1);
            }

            .motion-shine:hover::after {
                transform: translateX(120%);
            }

            .motion-shine > * {
                position: relative;
                z-index: 1;
            }

            .deep-reveal,
            .tilt-card,
            #rating-card {
                opacity: 0;
                transition: opacity 720ms var(--ease), transform 820ms var(--ease), box-shadow 420ms var(--ease), border-color 420ms var(--ease);
            }

            .deep-reveal {
                transform: translateY(26px);
            }

            .deep-reveal.is-visible,
            .tilt-card.is-visible,
            #rating-card.is-visible {
                opacity: 1;
            }

            .deep-reveal.is-visible {
                transform: translateY(0);
            }

            .installation-section {
                overflow-x: clip;
                scroll-margin-top: 7rem;
            }

            .install-steps {
                overflow: visible;
            }

            .install-connector {
                transform: scaleX(0);
                transform-origin: left;
                transition: transform 900ms var(--ease), opacity 700ms var(--ease);
                opacity: 0;
            }

            .install-step,
            .install-result {
                opacity: 0;
                transition: opacity 780ms var(--ease), transform 900ms var(--ease), border-color 420ms var(--ease), box-shadow 420ms var(--ease);
                will-change: transform, opacity;
            }

            .install-step[data-direction="left"] {
                transform: translate3d(-42vw, 1rem, 0) rotate(-1.5deg);
            }

            .install-step[data-direction="right"] {
                transform: translate3d(42vw, 1rem, 0) rotate(1.5deg);
            }

            .install-step[data-direction="top"] {
                transform: translate3d(0, -2.5rem, 0) scale(0.98);
            }

            .install-result {
                transform: translateY(2rem);
            }

            .install-steps.is-visible .install-connector {
                opacity: 1;
                transform: scaleX(1);
            }

            .install-steps.is-visible .install-step,
            .install-result.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
                will-change: auto;
            }

            .install-steps.is-visible .install-step:nth-of-type(2) {
                transition-delay: 120ms;
            }

            .install-steps.is-visible .install-step:nth-of-type(3) {
                transition-delay: 240ms;
            }

            .install-steps.is-visible .install-step:nth-of-type(4) {
                transition-delay: 360ms;
            }

            @media (max-width: 767px) {
                .install-step[data-direction="left"],
                .install-step[data-direction="top"] {
                    transform: translate3d(-70vw, 1.25rem, 0);
                }

                .install-step[data-direction="right"] {
                    transform: translate3d(70vw, 1.25rem, 0);
                }

                .install-steps.is-visible .install-step:nth-of-type(2) { transition-delay: 80ms; }
                .install-steps.is-visible .install-step:nth-of-type(3) { transition-delay: 180ms; }
                .install-steps.is-visible .install-step:nth-of-type(4) { transition-delay: 280ms; }
            }

            @media (prefers-reduced-motion: reduce) {
                .install-step,
                .install-result,
                .install-connector {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }

            #rating-card {
                position: relative;
                border: none !important;
                isolation: isolate;
            }
            #rating-card::after {
                content: '';
                position: absolute;
                inset: 2px;
                background: #18181b;
                border-radius: calc(1.5rem - 2px);
                z-index: 0;
            }
            #rating-card::before {
                content: '';
                position: absolute;
                inset: -1px;
                border-radius: 1.6rem;
                background: conic-gradient(
                    from var(--angle, 0deg),
                    transparent 0%,
                    rgba(34,197,94,0.28) 16%,
                    rgba(103,232,249,0.34) 34%,
                    transparent 52%,
                    rgba(34,197,94,0.22) 72%,
                    transparent 100%
                );
                opacity: 0;
                transition: opacity 0.5s ease, filter 0.5s ease;
                z-index: -1;
                filter: blur(2px);
            }
            #rating-card .glow-ring {
                position: absolute;
                inset: -8px;
                border-radius: 1.9rem;
                background: conic-gradient(
                    from var(--angle, 0deg),
                    transparent,
                    rgba(34,197,94,0.16),
                    rgba(103,232,249,0.20),
                    transparent,
                    rgba(34,197,94,0.12),
                    transparent
                );
                opacity: 0;
                filter: blur(18px);
                transition: opacity 0.5s ease;
                z-index: -2;
                pointer-events: none;
            }
            #rating-card > *:not(.glow-ring) { position: relative; z-index: 1; }
            #rating-card:hover::before,
            #rating-card:hover .glow-ring { opacity: 0.85; }

            .review-card-glow {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                background: transparent !important;
                transition: transform 280ms var(--ease), border-color 280ms var(--ease), box-shadow 280ms var(--ease);
            }

            .review-card-glow::before {
                content: "";
                position: absolute;
                inset: -2px;
                z-index: -2;
                border-radius: inherit;
                background: conic-gradient(
                    from var(--angle, 0deg),
                    transparent 0%,
                    rgba(34,197,94,0.22) 18%,
                    rgba(103,232,249,0.28) 34%,
                    transparent 50%,
                    rgba(34,197,94,0.14) 72%,
                    transparent 100%
                );
                opacity: 0;
                filter: blur(0);
                transition: opacity 420ms ease, filter 420ms ease;
            }

            .review-card-glow::after {
                content: "";
                position: absolute;
                inset: 1px;
                z-index: -1;
                border-radius: calc(1.5rem - 1px);
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.04), transparent 36%),
                    #18181b;
            }

            .review-card-glow > * {
                position: relative;
                z-index: 1;
            }

            .review-card-glow:hover {
                border-color: rgba(103,232,249,0.14) !important;
                box-shadow: 0 20px 70px rgba(0,0,0,0.30), 0 0 34px rgba(103,232,249,0.055);
                transform: translateY(-3px);
            }

            .review-card-glow:hover::before {
                opacity: 1;
                filter: blur(12px);
                animation: slowGlowTurn 9s linear infinite;
            }

            .compat-examples {
                position: relative;
                isolation: isolate;
                overflow: hidden;
                border: 1px solid rgba(255,255,255,0.10);
                border-radius: 1.5rem;
                background:
                    radial-gradient(circle at 12% 0%, rgba(103,232,249,0.13), transparent 18rem),
                    radial-gradient(circle at 92% 18%, rgba(34,197,94,0.12), transparent 16rem),
                    linear-gradient(145deg, rgba(255,255,255,0.055), transparent 34%),
                    #111113;
                box-shadow: 0 28px 90px rgba(0,0,0,0.32);
            }

            .compat-examples::before {
                content: "";
                position: absolute;
                inset: 0;
                pointer-events: none;
                background:
                    linear-gradient(90deg, transparent, rgba(255,255,255,0.055), transparent),
                    repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 4.5rem);
                opacity: 0.42;
            }

            .compat-examples > * {
                position: relative;
                z-index: 1;
            }

            .compat-icon {
                position: relative;
                box-shadow: 0 0 34px rgba(103,232,249,0.16);
            }

            .compat-icon::after {
                content: "";
                position: absolute;
                inset: -0.45rem;
                border-radius: 1rem;
                border: 1px solid rgba(103,232,249,0.14);
                opacity: 0.7;
            }

            .compat-model-card {
                position: relative;
                overflow: hidden;
                border: 1px solid rgba(255,255,255,0.09);
                border-radius: 1rem;
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.06), transparent 42%),
                    rgba(0,0,0,0.28);
                transition: transform 260ms var(--ease), border-color 260ms var(--ease), background 260ms var(--ease), box-shadow 260ms var(--ease);
            }

            .thread-row {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 0.75rem;
            }

            .thread-row p {
                min-width: 0;
                padding-right: 0.25rem;
            }

            .compat-model-card::before {
                content: "";
                position: absolute;
                inset: auto 0 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(103,232,249,0.7), transparent);
                opacity: 0;
                transition: opacity 260ms var(--ease);
            }

            .compat-model-card:hover {
                border-color: rgba(103,232,249,0.26);
                background:
                    linear-gradient(145deg, rgba(103,232,249,0.08), transparent 40%),
                    rgba(0,0,0,0.34);
                box-shadow: 0 16px 48px rgba(0,0,0,0.22);
                transform: translateY(-3px);
            }

            .compat-model-card:hover::before {
                opacity: 1;
            }

            .thread-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 2.35rem;
                border: 1px solid rgba(103,232,249,0.20);
                border-radius: 999px;
                background: rgba(103,232,249,0.08);
                color: #67e8f9;
                font-size: 0.64rem;
                font-weight: 950;
                letter-spacing: 0.08em;
            }

            @media (max-width: 640px) {
                .thread-row {
                    display: flex;
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 0.5rem;
                }

                .thread-row p {
                    max-width: 100%;
                    padding-right: 0;
                }

                .thread-badge {
                    position: static;
                    min-width: 2.6rem;
                    font-size: 0.58rem;
                    letter-spacing: 0.06em;
                    padding: 0.28rem 0.55rem;
                }

                .compat-model-card {
                    min-height: 8.2rem;
                    padding: 1rem !important;
                }

                .thread-cards {
                    gap: 0.75rem !important;
                }

                .thread-card {
                    padding: 1rem 0.8rem !important;
                }

                .thread-card p:first-child {
                    font-size: clamp(2.15rem, 10vw, 2.8rem) !important;
                    line-height: 0.9;
                }

                .thread-card p:last-child {
                    font-size: 0.58rem !important;
                    letter-spacing: 0.16em !important;
                    overflow-wrap: anywhere;
                }
            }

            @keyframes slowGlowTurn {
                to { --angle: 360deg; }
            }

            @property --angle {
                syntax: '<angle>';
                initial-value: 0deg;
                inherits: false;
            }

            .cart-dropdown {
                display: none;
                pointer-events: none;
                width: min(18rem, calc(100vw - 2rem));
            }
            .cart-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .account-dropdown {
                display: none;
                pointer-events: none;
            }
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .accordion-item summary::-webkit-details-marker {
                display: none;
            }

            .accordion-panel {
                overflow: hidden;
                height: 0;
                opacity: 0;
                transform: translateY(-0.35rem);
                transition: height 340ms var(--ease), opacity 260ms ease, transform 340ms var(--ease);
                will-change: height, opacity, transform;
            }

            .accordion-item.is-open .accordion-panel {
                opacity: 1;
                transform: translateY(0);
            }

            .accordion-item .chevron {
                transition: transform 300ms var(--ease), color 220ms ease !important;
            }

            .accordion-item.is-open .chevron {
                color: #22c55e !important;
                transform: rotate(180deg);
            }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

            /* ── Galerie ── */
            #gallery-main {
                overflow: hidden;
                transition: transform 420ms var(--ease), box-shadow 420ms var(--ease), border-color 420ms var(--ease);
            }
            #gallery-main:hover {
                border-color: rgba(103,232,249,0.22);
                box-shadow: 0 26px 90px rgba(0,0,0,0.36), 0 0 44px rgba(34,197,94,0.07);
                transform: translateY(-3px);
            }
            #prod-img {
                transition: opacity 220ms ease, transform 520ms var(--ease), filter 520ms var(--ease);
                will-change: transform, opacity;
            }
            #prod-img.is-sliding-out-left {
                opacity: 0;
                transform: translateX(-2rem) scale(0.98);
            }
            #prod-img.is-sliding-out-right {
                opacity: 0;
                transform: translateX(2rem) scale(0.98);
            }
            #prod-img.is-sliding-in-left {
                opacity: 0;
                transform: translateX(2rem) scale(0.98);
            }
            #prod-img.is-sliding-in-right {
                opacity: 0;
                transform: translateX(-2rem) scale(0.98);
            }
            .thumb {
                transition: opacity 0.2s, transform 0.2s, border-color 0.2s;
                cursor: pointer;
                opacity: 0.5;
            }
            .thumb:hover { opacity: 0.85; transform: scale(1.05); }
            .thumb.active {
                opacity: 1;
                border-color: #16a34a !important;
                transform: scale(1.05);
            }

            /* Flèches galerie */
            .gallery-arrow {
                position: absolute;
                top: 50%; transform: translateY(-50%);
                background: rgba(0,0,0,0.5);
                border: 1px solid rgba(255,255,255,0.15);
                color: white;
                width: 2.25rem; height: 2.25rem;
                border-radius: 50%;
                display: flex; align-items: center; justify-content: center;
                cursor: pointer;
                transition: background 0.2s, border-color 0.2s;
                z-index: 10;
            }
            .gallery-arrow:hover {
                background: #16a34a;
                border-color: #16a34a;
                transform: translateY(-50%) scale(1.05);
            }
            .gallery-arrow.prev { left: 0.6rem; }
            .gallery-arrow.next { right: 0.6rem; }

            @media (max-width: 640px) {
                nav.fixed {
                    padding: 0.85rem 1rem !important;
                    gap: 0.5rem;
                }

                nav.fixed > a {
                    max-width: calc(100vw - 8.5rem);
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                    font-size: 1rem;
                }

                nav.fixed #account-btn,
                nav.fixed #cart-toggle {
                    padding: 0.35rem;
                }

                nav.fixed #cart-count {
                    top: -0.15rem;
                    right: -0.15rem;
                }

                .cart-dropdown,
                .account-dropdown {
                    right: 0;
                    max-width: calc(100vw - 2rem);
                }
            }

            .home-footer {
                position: relative;
                overflow: hidden;
            }

            .home-footer::before {
                content: "";
                position: absolute;
                left: 50%;
                top: 0;
                width: min(42rem, 82vw);
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(103,232,249,0.85), rgba(34,197,94,0.9), transparent);
                opacity: 0;
                transform: translateX(-50%) scaleX(0.35);
                transform-origin: center;
                transition: opacity 650ms var(--ease), transform 900ms var(--ease);
            }

            .home-footer > div {
                opacity: 0;
                transform: translateY(1.4rem);
                transition: opacity 700ms var(--ease), transform 760ms var(--ease);
            }

            .home-footer.is-visible::before {
                opacity: 1;
                transform: translateX(-50%) scaleX(1);
            }

            .home-footer.is-visible > div {
                opacity: 1;
                transform: translateY(0);
            }

            /* ── Slider avis ── */
            .review-card {
                width: 100%;
            }

            .review-slide {
                flex: 0 0 100% !important;
            }

            @media (max-width: 767px) {
                #reviews-skeleton {
                    grid-template-columns: 1fr !important;
                }

                #reviews-skeleton > div:nth-child(2) {
                    display: none;
                }
            }

            @keyframes skel-pulse {
                0%, 100% { opacity: 0.4; }
                50%       { opacity: 0.8; }
            }
            @media (min-width: 768px) {
                .review-slide {
                    flex: 0 0 calc(50% - 0.625rem) !important;
                }

                #reviews-track {
                    /* conteneur de référence pour les 50% */
                }
                #reviews-container {
                    /* les cartes s'appuient sur la largeur du track via JS */
                }
                .review-card {
                    /* La largeur sera fixée en JS via offsetWidth du track */
                }
            }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> RETOUR
            </a>
            <div class="flex items-center gap-2">

                <!-- ── BONHOMME COMPTE ─────────────────────────────── -->
                <div class="relative">
                    <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                        class="relative p-2 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                        </svg>
                    </button>
                    <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                        class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                        <p id="account-email" class="text-xs text-white font-black truncate mb-3">—</p>
                        <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                            <a href="/account"
                                class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                Mon compte
                            </a>
                            <a href="/orders"
                                class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                                Mes commandes
                            </a>
                        </div>
                        <button id="logout-btn"
                            class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                            Se déconnecter
                        </button>
                    </div>
                </div>

                <!-- ── PANIER ──────────────────────────────────────── -->
                <div class="relative">
                <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
