---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = { 
    id: "deep-matte-01",
    nom: "Deep Matte", 
    description: "Finition aluminium premium, prise en main parfaite pour une précision maximale.",
    prix: 29.90,
    enStock: true, // Variable de contrôle
};

const images = [imageBlackMatte1.src, imageBlackMatte2.src, imageBlackMatte3.src];
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>{product.nom} | Détails Techniques</title>
        <style>
            html { scroll-behavior: smooth; }

            .cart-dropdown {
                display: none;
                pointer-events: none;
                width: min(18rem, calc(100vw - 2rem));
            }
            .cart-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .account-dropdown {
                display: none;
                pointer-events: none;
            }
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

            /* ── Galerie ── */
            #gallery-main {
                transition: opacity 0.25s ease;
            }
            #gallery-main.fade {
                opacity: 0;
            }
            .thumb {
                transition: opacity 0.2s, transform 0.2s, border-color 0.2s;
                cursor: pointer;
                opacity: 0.5;
            }
            .thumb:hover { opacity: 0.85; transform: scale(1.05); }
            .thumb.active {
                opacity: 1;
                border-color: #16a34a !important;
                transform: scale(1.05);
            }

            /* Flèches galerie */
            .gallery-arrow {
                position: absolute;
                top: 50%; transform: translateY(-50%);
                background: rgba(0,0,0,0.5);
                border: 1px solid rgba(255,255,255,0.15);
                color: white;
                width: 2.25rem; height: 2.25rem;
                border-radius: 50%;
                display: flex; align-items: center; justify-content: center;
                cursor: pointer;
                transition: background 0.2s, border-color 0.2s;
                z-index: 10;
            }
            .gallery-arrow:hover {
                background: #16a34a;
                border-color: #16a34a;
            }
            .gallery-arrow.prev { left: 0.6rem; }
            .gallery-arrow.next { right: 0.6rem; }

            /* ── Slider avis ── */
            .review-card {
                width: 100%;
            }
            @keyframes skel-pulse {
                0%, 100% { opacity: 0.4; }
                50%       { opacity: 0.8; }
            }
            @media (min-width: 768px) {
                #reviews-track {
                    /* conteneur de référence pour les 50% */
                }
                #reviews-container {
                    /* les cartes s'appuient sur la largeur du track via JS */
                }
                .review-card {
                    /* La largeur sera fixée en JS via offsetWidth du track */
                }
            }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> RETOUR
            </a>
            <div class="flex items-center gap-2">

                <!-- ── BONHOMME COMPTE ─────────────────────────────── -->
                <div class="relative">
                    <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                        class="relative p-2 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                        </svg>
                    </button>
                    <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                        class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                        <p id="account-email" class="text-xs text-white font-black truncate mb-3">—</p>
                        <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                            <a href="/account"
                                class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                Mon compte
                            </a>
                            <a href="/orders"
                                class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                                Mes commandes
                            </a>
                        </div>
                        <button id="logout-btn"
                            class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                            Se déconnecter
                        </button>
                    </div>
                </div>

                <!-- ── PANIER ──────────────────────────────────────── -->
                <div class="relative">
                <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span id="cart-count" aria-live="polite" class="absolute -top-1 -right-1 bg-green-600 text-white text-[10px] font-bold h-5 w-5 flex items-center justify-center rounded-full">0</span>
                </button>
                <div id="cart-dropdown" role="dialog" aria-label="Panier" class="cart-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 overflow-hidden">
                    <h4 class="text-sm font-black uppercase mb-4 italic text-green-500">Mon Panier</h4>
                    <div id="cart-items" class="space-y-4 max-h-60 overflow-y-auto" aria-live="polite">
                        <p class="text-gray-500 text-xs italic">Votre panier est vide.</p>
                    </div>
                    <div class="border-t border-white/10 mt-4 pt-4">
                        <div class="flex justify-between font-bold text-sm">
                            <span>TOTAL :</span>
                            <span id="cart-total">0.00€</span>
                        </div>
                        <button id="checkout-btn" class="w-full bg-white text-black text-xs font-black py-3 mt-4 rounded-xl hover:bg-green-500 hover:text-white transition uppercase">
                            Commander
                        </button>
                    </div>
                </div>
                </div>

                <!-- fin flex items-center gap-2 -->
            </div>
        </nav>

        <!-- SECTION PRODUIT -->
        <section class="pt-32 pb-16 px-5 md:px-10 max-w-6xl mx-auto">
            <div class="flex flex-col md:flex-row gap-12 items-start">

                <!-- GALERIE -->
                <div class="w-full md:w-1/2 flex flex-col gap-4">

                    <!-- Image principale avec flèches -->
                    <div class="relative bg-zinc-900 rounded-[40px] border border-white/5 p-4">
                        <img
                            id="prod-img"
                            src={images[0]}
                            class="w-full h-auto rounded-3xl object-cover"
                            alt={product.nom}
                        />
                        <button class="gallery-arrow prev" id="gallery-prev" aria-label="Image précédente">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        <button class="gallery-arrow next" id="gallery-next" aria-label="Image suivante">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>

                    <!-- Miniatures -->
                    <div class="flex gap-3 justify-center">
                        {images.map((src, i) => (
                            <button
                                class={`thumb w-20 h-20 rounded-2xl overflow-hidden border-2 border-white/10 bg-zinc-900 ${i === 0 ? 'active' : ''}`}
                                data-index={i}
                                aria-label={`Voir l'image ${i + 1}`}
                            >
                                <img src={src} class="w-full h-full object-cover" alt={`${product.nom} vue ${i + 1}`} />
                            </button>
                        ))}
                    </div>
                </div>

                <!-- INFOS PRODUIT -->
                <div class="w-full md:w-1/2">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Fiche Produit</span>
                    <h1 class="text-5xl font-black uppercase italic mt-2">{product.nom}</h1>
                    
                    <div class="flex items-center gap-4 mt-4">
                        <p class="text-3xl text-white font-black">{product.prix.toFixed(2)}€</p>
                        {!product.enStock && (
                            <span class="bg-red-600/10 border border-red-600 text-red-500 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter">
                                Rupture de stock
                            </span>
                        )}
                    </div>

                    <a href="#avis-clients" class="flex items-center gap-2 mt-4 hover:opacity-80 transition group">
                        <div class="flex text-yellow-400 text-lg">★★★★★</div>
                        <span class="text-white font-black text-sm">4.7</span>
                        <span class="text-gray-500 text-xs underline decoration-gray-700 group-hover:text-green-500">(24 avis clients)</span>
                    </a>

                    <p class="text-gray-400 mt-8 text-lg italic leading-relaxed">"{product.description}"</p>

                    <div class="mt-10 flex flex-col gap-4">

                        {product.enStock ? (
                            <>
                                <!-- Sélecteur de quantité -->
                                <div style="display:flex;align-items:center;gap:0.75rem;">
                                    <span style="font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;color:#6b7280;">Quantité</span>
                                    <div style="display:flex;align-items:center;background:#18181b;border:1px solid rgba(255,255,255,0.1);border-radius:0.75rem;overflow:hidden;">
                                        <button id="qty-minus" aria-label="Diminuer la quantité"
                                            style="width:2.5rem;height:2.5rem;display:flex;align-items:center;justify-content:center;color:#22c55e;font-size:1.2rem;font-weight:900;background:none;border:none;cursor:pointer;transition:background 0.15s;"
                                            onmouseover="this.style.background='rgba(34,197,94,0.1)'"
                                            onmouseout="this.style.background='none'">−</button>
                                        <span id="qty-value" style="min-width:2rem;text-align:center;font-weight:900;font-size:0.95rem;">1</span>
                                        <button id="qty-plus" aria-label="Augmenter la quantité"
                                            style="width:2.5rem;height:2.5rem;display:flex;align-items:center;justify-content:center;color:#22c55e;font-size:1.2rem;font-weight:900;background:none;border:none;cursor:pointer;transition:background 0.15s;"
                                            onmouseover="this.style.background='rgba(34,197,94,0.1)'"
                                            onmouseout="this.style.background='none'">+</button>
                                    </div>
                                    <span id="qty-total" style="font-size:0.8rem;color:#6b7280;font-style:italic;">{product.prix.toFixed(2)}€</span>
                                </div>

                                <button
                                    id="add-to-cart"
                                    data-add-to-cart
                                    data-default-label="Ajouter au panier"
                                    data-added-label="✓ Ajouté !"
                                    class="w-full bg-green-600 hover:bg-green-700 text-white font-black py-5 rounded-2xl transition-all active:scale-95 uppercase text-xl shadow-lg shadow-green-900/20">
                                    Ajouter au panier
                                </button>
                            </>
                        ) : (
                            <button disabled class="w-full bg-zinc-800 text-zinc-500 cursor-not-allowed font-black py-5 rounded-2xl uppercase text-xl border border-white/5">
                                Rupture de stock
                            </button>
                        )}
                        
                        <a href="/" class="w-full border border-white/20 hover:border-green-500/50 hover:text-green-400 text-white text-center font-bold py-3 rounded-2xl transition-all uppercase text-sm tracking-widest">
                            ← Retour à la boutique
                        </a>
                    </div>

                    <!-- Specs -->
                    <div class="mt-12 space-y-4 border-t border-white/10 pt-8 text-sm">
                        <div class="flex justify-between"><span class="text-gray-500 italic">Matériau</span><span class="font-bold">Aluminium</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 italic">Poids</span><span class="font-bold">245g</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 italic">Compatibilité</span><span class="font-bold">Universelle (Bagues M8, M10 et M12 incluses)</span></div>
                        <div class="flex justify-between"><span class="text-gray-500 italic">Fabrication</span><span class="font-bold">USA</span></div>
                    </div>

                    <!-- Livraison & Retours -->
                    <div style="margin-top:1.75rem;border-top:1px solid rgba(255,255,255,0.08);padding-top:1.5rem;">

                        <!-- Accordion item -->
                        <details class="accordion-item" style="border-bottom:1px solid rgba(255,255,255,0.06);">
                            <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;cursor:pointer;list-style:none;gap:0.5rem;">
                                <div style="display:flex;align-items:center;gap:0.75rem;">
                                    <svg xmlns="http://www.w3.org/2000/svg" style="height:1rem;width:1rem;color:#22c55e;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8l1 12h12L19 8M10 12h4"/></svg>
                                    <span style="font-size:0.8rem;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;">Livraison</span>
                                </div>
                                <svg class="chevron" xmlns="http://www.w3.org/2000/svg" style="height:0.9rem;width:0.9rem;color:#6b7280;flex-shrink:0;transition:transform 0.25s;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div style="padding:0 0 1.25rem;display:flex;flex-direction:column;gap:0.75rem;">
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">Livraison gratuite</p>
                                        <p style="font-size:0.72rem;color:#6b7280;margin-top:0.15rem;line-height:1.5;">Sans minimum d'achat, partout en France métropolitaine.</p>
                                    </div>
                                </div>
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">Provenance USA</p>
                                    </div>
                                </div>
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">Livraison estimée : 12–18 jours ouvrés</p>
                                        <p style="font-size:0.72rem;color:#6b7280;margin-top:0.15rem;line-height:1.5;">Suivi de colis disponible dans "Mes commandes"</p>
                                    </div>
                                </div>
                            </div>
                        </details>

                        <details class="accordion-item" style="border-bottom:1px solid rgba(255,255,255,0.06);">
                            <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;cursor:pointer;list-style:none;gap:0.5rem;">
                                <div style="display:flex;align-items:center;gap:0.75rem;">
                                    <svg xmlns="http://www.w3.org/2000/svg" style="height:1rem;width:1rem;color:#22c55e;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    <span style="font-size:0.8rem;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;">Retours & remboursements</span>
                                </div>
                                <svg class="chevron" xmlns="http://www.w3.org/2000/svg" style="height:0.9rem;width:0.9rem;color:#6b7280;flex-shrink:0;transition:transform 0.25s;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div style="padding:0 0 1.25rem;display:flex;flex-direction:column;gap:0.75rem;">
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">30 jours pour changer d'avis</p>
                                        <p style="font-size:0.72rem;color:#6b7280;margin-top:0.15rem;line-height:1.5;">Retour gratuit si le produit est dans son état d'origine et son emballage.</p>
                                    </div>
                                </div>
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">Remboursement intégral</p>
                                        <p style="font-size:0.72rem;color:#6b7280;margin-top:0.15rem;line-height:1.5;">Traité sous 5 à 7 jours ouvrés après réception du retour.</p>
                                    </div>
                                </div>
                                <a href="/contact" style="font-size:0.7rem;font-weight:700;color:#22c55e;text-decoration:none;display:inline-flex;align-items:center;gap:0.3rem;margin-top:0.25rem;">
                                    Contacter le support →
                                </a>
                            </div>
                        </details>

                        <details class="accordion-item">
                            <summary style="display:flex;align-items:center;justify-content:space-between;padding:1rem 0;cursor:pointer;list-style:none;gap:0.5rem;">
                                <div style="display:flex;align-items:center;gap:0.75rem;">
                                    <svg xmlns="http://www.w3.org/2000/svg" style="height:1rem;width:1rem;color:#22c55e;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                    <span style="font-size:0.8rem;font-weight:900;text-transform:uppercase;letter-spacing:0.06em;">Garantie</span>
                                </div>
                                <svg class="chevron" xmlns="http://www.w3.org/2000/svg" style="height:0.9rem;width:0.9rem;color:#6b7280;flex-shrink:0;transition:transform 0.25s;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </summary>
                            <div style="padding:0 0 1.25rem;display:flex;flex-direction:column;gap:0.75rem;">
                                <div style="display:flex;align-items:flex-start;gap:0.6rem;">
                                    <span style="color:#22c55e;font-size:0.9rem;flex-shrink:0;margin-top:0.05rem;">✓</span>
                                    <div>
                                        <p style="font-size:0.8rem;font-weight:700;color:white;">Garantie 2 ans</p>
                                        <p style="font-size:0.72rem;color:#6b7280;margin-top:0.15rem;line-height:1.5;">Couvre les défauts de fabrication. Ne couvre pas l'usure normale ou les dommages accidentels.</p>
                                    </div>
                                </div>
                            </div>
                        </details>

                    </div>

                </div>
            </div>
        </section>

        <!-- AVIS CLIENTS -->
        <!-- ── TUTO MONTAGE ──────────────────────────────────────────────────── -->
        <section class="py-24 bg-black border-t border-white/5">
            <div class="max-w-6xl mx-auto px-5 md:px-10">

                <!-- Titre -->
                <div class="mb-14">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Installation</span>
