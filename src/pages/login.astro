---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>Connexion | CD Motor Shop</title>
        <style>
            html { scroll-behavior: smooth; }

            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a; color: white;
                font-weight: 900; font-size: 0.75rem;
                text-transform: uppercase; letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem; border-radius: 99px;
                z-index: 9999; opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none; white-space: nowrap;
            }
            #toast.show  { transform: translateX(-50%) translateY(0); opacity: 1; }
            #toast.error { background: #dc2626; }

            .account-dropdown { display: none; pointer-events: none; }
            .account-dropdown.is-open { display: block; pointer-events: auto; }

            /* ── Champs ── */
            .field-wrap { display: flex; flex-direction: column; gap: 0; }

            .field-input {
                width: 100%;
                background: #000;
                border: 1.5px solid rgba(255,255,255,0.1);
                border-radius: 0.75rem;
                padding: 0.8rem 1rem;
                font-size: 0.875rem;
                color: white;
                outline: none;
                transition: border-color 0.2s;
                box-sizing: border-box;
            }
            .field-input::placeholder { color: #4b5563; }
            .field-input:focus  { border-color: #22c55e; }
            .field-input.error  { border-color: #ef4444; }
            .field-input.valid  { border-color: #22c55e; }

            .field-error {
                font-size: 0.65rem;
                font-weight: 700;
                color: #ef4444;
                margin-top: 0.35rem;
                min-height: 1rem;
                letter-spacing: 0.04em;
                display: flex;
                align-items: center;
                gap: 0.3rem;
                opacity: 0;
                transform: translateY(-4px);
                transition: opacity 0.2s, transform 0.2s;
            }
            .field-error.visible {
                opacity: 1;
                transform: translateY(0);
            }

            /* ── Mot de passe toggle ── */
            .pw-wrap { position: relative; }
            .pw-toggle {
                position: absolute;
                right: 0.85rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #6b7280;
                cursor: pointer;
                padding: 0.25rem;
                transition: color 0.2s;
            }
            .pw-toggle:hover { color: #22c55e; }

            /* ── Lien mot de passe oublié ── */
            .forgot-link {
                font-size: 0.65rem;
                font-weight: 700;
                color: #6b7280;
                text-decoration: none;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                align-self: flex-end;
                margin-top: 0.4rem;
                transition: color 0.2s;
            }
            .forgot-link:hover { color: #22c55e; }

            /* ── Bouton ── */
            #login-btn {
                width: 100%;
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 1rem;
                border-radius: 1rem;
                border: none;
                cursor: pointer;
                transition: background 0.2s, transform 0.1s, opacity 0.2s;
                margin-top: 0.5rem;
                position: relative;
                overflow: hidden;
            }
            #login-btn:hover   { background: #15803d; }
            #login-btn:active  { transform: scale(0.98); }
            #login-btn:disabled { opacity: 0.6; cursor: not-allowed; }

            /* Shimmer sur le bouton pendant le chargement */
            #login-btn.loading::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
                background-size: 200% 100%;
                animation: btn-shimmer 1.2s infinite;
            }
            @keyframes btn-shimmer {
                0%   { background-position: -200% 0; }
                100% { background-position: 200% 0; }
            }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .card { animation: fadeUp 0.5s ease-out 0.1s both; }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans min-h-screen flex flex-col">

        <div id="toast" role="status" aria-live="polite"></div>

        <!-- NAVIGATION -->
        <nav class="fixed w-full z-50 bg-black/80 backdrop-blur-md border-b border-white/10 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-xl font-black italic tracking-tighter hover:text-green-500 transition">
                <span class="text-green-600">←</span> CD MOTOR SHOP
            </a>
            <div class="flex items-center gap-4">
                <a href="/signup" class="text-xs font-bold uppercase tracking-widest text-gray-400 hover:text-green-500 transition">
                    Créer un compte
                </a>
                <div class="relative">
                    <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                        class="relative p-2 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                        </svg>
                    </button>
                    <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                        class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                        <p id="account-email" class="text-xs text-white font-black truncate mb-4">—</p>
                        <button id="logout-btn"
                            class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                            Se déconnecter
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <!-- FORMULAIRE -->
        <main class="flex-1 flex items-center justify-center px-5 pt-24 pb-16">
            <div class="w-full max-w-md">

                <div class="mb-10 text-center" style="animation: fadeUp 0.4s ease-out both;">
                    <span class="text-green-500 font-bold tracking-widest uppercase text-xs">Bienvenue</span>
                    <h1 class="text-4xl font-black uppercase italic mt-2">Connexion</h1>
                    <p class="text-gray-500 text-sm mt-3">Accède à ton compte CD Motor Shop</p>
                </div>

                <div class="card bg-zinc-900 border border-white/10 rounded-3xl p-8" style="display:flex;flex-direction:column;gap:1.25rem;">

                    <!-- Email -->
                    <div class="field-wrap">
                        <label for="email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Email</label>
                        <input id="email" type="email" placeholder="ton@email.com" class="field-input" autocomplete="email" />
                        <p class="field-error" id="email-error">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            <span id="email-error-text"></span>
                        </p>
                    </div>

                    <!-- Mot de passe -->
                    <div class="field-wrap">
                        <label for="password" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Mot de passe</label>
                        <div class="pw-wrap">
                            <input id="password" type="password" placeholder="••••••••" class="field-input" autocomplete="current-password" style="padding-right:2.75rem;" />
                            <button type="button" class="pw-toggle" id="pw-toggle" aria-label="Afficher/masquer le mot de passe">
                                <svg id="pw-eye" xmlns="http://www.w3.org/2000/svg" style="height:1.1rem;width:1.1rem;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                        <p class="field-error" id="password-error">
                            <svg xmlns="http://www.w3.org/2000/svg" style="height:0.75rem;width:0.75rem;flex-shrink:0;" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                            <span id="password-error-text"></span>
                        </p>
                        <a href="/forgot-password" class="forgot-link">Mot de passe oublié ?</a>
                    </div>

                    <button id="login-btn" type="button">Se connecter</button>

                    <p style="text-align:center;font-size:0.75rem;color:#4b5563;padding-top:0.25rem;">
                        Pas encore de compte ?
                        <a href="/signup" style="color:#22c55e;font-weight:700;text-decoration:none;">Créer un compte</a>
                    </p>
                </div>
            </div>
        </main>

        <script>
            import { supabase } from '../lib/supabase';
            import { initAuthNav } from '../scripts/auth-nav.js';

            document.addEventListener('astro:page-load', () => {
                initAuthNav();

                // ── Redirect si déjà connecté ────────────────────────────────
                supabase.auth.getUser().then(({ data: { user } }) => {
                    if (user) {
                        const params = new URLSearchParams(window.location.search);
                        window.location.href = params.get('redirect') || '/account';
                    }
                });

                // ── Helpers validation ───────────────────────────────────────
                const setError = (inputId, errorId, msg) => {
                    const input = document.getElementById(inputId);
                    const errorEl = document.getElementById(errorId);
                    const textEl = document.getElementById(errorId + '-text');
                    if (!input || !errorEl || !textEl) return;
                    input.classList.add('error');
                    input.classList.remove('valid');
                    textEl.textContent = msg;
                    errorEl.classList.add('visible');
                };

                const clearError = (inputId, errorId) => {
                    const input = document.getElementById(inputId);
                    const errorEl = document.getElementById(errorId);
                    if (!input || !errorEl) return;
                    input.classList.remove('error');
                    errorEl.classList.remove('visible');
                };

                const setValid = (inputId) => {
                    const input = document.getElementById(inputId);
                    if (!input) return;
                    input.classList.add('valid');
                    input.classList.remove('error');
                };

                // ── Validation en temps réel ─────────────────────────────────
                const emailInput = document.getElementById('email');
                const passwordInput = document.getElementById('password');

                emailInput?.addEventListener('blur', () => {
                    const val = emailInput.value.trim();
                    if (!val) { setError('email', 'email-error', 'L\'email est requis'); return; }
                    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) { setError('email', 'email-error', 'Format d\'email invalide'); return; }
                    clearError('email', 'email-error');
                    setValid('email');
                });

                emailInput?.addEventListener('input', () => {
                    if (emailInput.classList.contains('error')) clearError('email', 'email-error');
                });

                passwordInput?.addEventListener('blur', () => {
                    const val = passwordInput.value;
                    if (!val) { setError('password', 'password-error', 'Le mot de passe est requis'); return; }
                    clearError('password', 'password-error');
                });

                passwordInput?.addEventListener('input', () => {
                    if (passwordInput.classList.contains('error')) clearError('password', 'password-error');
                });

                // ── Toggle afficher/masquer mdp ──────────────────────────────
                document.getElementById('pw-toggle')?.addEventListener('click', () => {
                    const input = document.getElementById('password');
                    const isText = input.type === 'text';
                    input.type = isText ? 'password' : 'text';
                    document.getElementById('pw-eye').innerHTML = isText
                        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>'
                        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
                });

                // ── Soumission ────────────────────────────────────────────────
                const submit = async () => {
                    const email    = emailInput?.value.trim() ?? '';
                    const password = passwordInput?.value ?? '';
                    const btn      = document.getElementById('login-btn');

                    let hasError = false;

                    if (!email) { setError('email', 'email-error', 'L\'email est requis'); hasError = true; }
                    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError('email', 'email-error', 'Format d\'email invalide'); hasError = true; }

                    if (!password) { setError('password', 'password-error', 'Le mot de passe est requis'); hasError = true; }

                    if (hasError) return;

                    btn.textContent = 'Connexion…';
                    btn.disabled = true;
                    btn.classList.add('loading');

                    const { error } = await supabase.auth.signInWithPassword({ email, password });

                    btn.classList.remove('loading');

                    if (error) {
                        btn.textContent = 'Se connecter';
                        btn.disabled = false;
                        // Erreur spécifique sur les deux champs
                        setError('email', 'email-error', 'Email ou mot de passe incorrect');
                        setError('password', 'password-error', 'Email ou mot de passe incorrect');
                    } else {
                        btn.textContent = '✓ Connecté !';
                        const params = new URLSearchParams(window.location.search);
                        setTimeout(() => window.location.href = params.get('redirect') || '/', 800);
                    }
                };

                document.getElementById('login-btn')?.addEventListener('click', submit);
                document.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
            });
        </script>
    </body>
</html>