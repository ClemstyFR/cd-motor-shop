---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = {
    id: 'deep-matte-01',
    nom: 'Deep Matte',
    description: 'Pommeau aluminium mat, grip précis, montage simple avec bagues M8, M10 et M12 incluses.',
    prix: 29.90,
    image: imageBlackMatte1,
    link: '/deepmatte',
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>CD Motor Shop | Deep Matte</title>
        <meta name="description" content="CD Motor Shop — Pommeau de levier de vitesse aluminium premium Deep Matte. Montage 5 min, bagues M8/M10/M12 incluses, livraison gratuite." />
        <meta property="og:title" content="CD Motor Shop | Deep Matte" />
        <meta property="og:description" content="Pommeau Deep Matte en aluminium premium. Prise en main nette, montage simple, livraison gratuite." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <style>
            html { scroll-behavior: smooth; }

            .cart-dropdown,
            .account-dropdown {
                display: none;
                pointer-events: none;
            }
            .cart-dropdown {
                width: min(18rem, calc(100vw - 2rem));
            }
            .cart-dropdown.is-open,
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .site-nav {
                border-bottom: 1px solid rgba(255,255,255,0.08);
                background: rgba(5,6,7,0.78);
                backdrop-filter: blur(18px);
            }
            .nav-link {
                color: #9aa4ad;
                font-size: 0.72rem;
                font-weight: 900;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                transition: color 0.2s ease;
            }
            .nav-link:hover { color: white; }

            .hero {
                min-height: 100svh;
                display: grid;
                align-items: end;
                position: relative;
                overflow: hidden;
                padding: 7.5rem 1.25rem 2rem;
            }
            .hero-bg {
                position: absolute;
                inset: 0;
                z-index: 0;
            }
            .hero-bg img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0.58;
                filter: saturate(0.85) contrast(1.08);
            }
            .hero-bg::after {
                content: "";
                position: absolute;
                inset: 0;
                background:
                    linear-gradient(90deg, rgba(5,6,7,0.96) 0%, rgba(5,6,7,0.6) 44%, rgba(5,6,7,0.12) 100%),
                    linear-gradient(180deg, rgba(5,6,7,0.1) 0%, rgba(5,6,7,0.42) 52%, #050607 100%);
            }
            .hero-inner {
                width: min(100%, 1180px);
                margin: 0 auto;
                position: relative;
                z-index: 1;
                display: grid;
                grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.62fr);
                gap: 2rem;
                align-items: end;
            }
            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 0.55rem;
                color: #67e8f9;
                font-size: 0.72rem;
                font-weight: 950;
                letter-spacing: 0.14em;
                text-transform: uppercase;
            }
            .eyebrow::before {
                content: "";
                width: 2.5rem;
                height: 1px;
                background: currentColor;
                opacity: 0.7;
            }
            .hero h1 {
                max-width: 12ch;
                margin: 1.2rem 0 0;
                font-size: clamp(3.7rem, 9vw, 8.8rem);
                line-height: 0.86;
                font-weight: 950;
                font-style: italic;
                letter-spacing: 0;
                text-transform: uppercase;
            }
            .hero-copy {
                max-width: 36rem;
                margin-top: 1.35rem;
                color: #d8dde0;
                font-size: clamp(1rem, 2vw, 1.24rem);
                line-height: 1.65;
                font-weight: 400;
            }
            .hero-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 0.8rem;
                margin-top: 2rem;
            }
            .btn-primary,
            .btn-secondary {
                min-height: 3.25rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                padding: 0.9rem 1.35rem;
                font-size: 0.82rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                text-decoration: none;
                transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
            }
            .btn-primary {
                border: 1px solid rgba(34,197,94,0.45);
                background: #16a34a;
                color: white;
                box-shadow: 0 18px 55px rgba(22,163,74,0.24);
            }
            .btn-secondary {
                border: 1px solid rgba(216,221,224,0.16);
                background: rgba(255,255,255,0.035);
                color: white;
            }
            .btn-primary:hover,
            .btn-secondary:hover { transform: translateY(-2px); }
            .hero-panel {
                border: 1px solid rgba(216,221,224,0.13);
                background: rgba(8,9,10,0.7);
                backdrop-filter: blur(18px);
                border-radius: 1rem;
                padding: 1rem;
            }
            .hero-product {
                display: grid;
                grid-template-columns: 5.5rem 1fr;
                gap: 1rem;
                align-items: center;
            }
            .hero-product img {
                width: 5.5rem;
                aspect-ratio: 1;
                object-fit: cover;
                border-radius: 0.8rem;
                border: 1px solid rgba(255,255,255,0.1);
            }
            .metric-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 0.5rem;
                margin-top: 1rem;
            }
            .metric {
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 0.8rem;
                background: rgba(255,255,255,0.025);
                padding: 0.7rem;
            }
            .metric strong {
                display: block;
                color: white;
                font-size: 1.05rem;
                font-weight: 950;
                font-style: italic;
            }
            .metric span {
                display: block;
                margin-top: 0.15rem;
                color: #828b94;
                font-size: 0.64rem;
                font-weight: 850;
                line-height: 1.25;
                text-transform: uppercase;
            }

            .section-wrap {
                width: min(100%, 1180px);
                margin: 0 auto;
                padding: 6rem 1.25rem;
            }
            .section-head {
                display: flex;
                align-items: end;
                justify-content: space-between;
                gap: 2rem;
                margin-bottom: 2rem;
            }
            .section-head h2 {
                max-width: 12ch;
                margin: 0.6rem 0 0;
                font-size: clamp(2.2rem, 5vw, 4.4rem);
                line-height: 0.94;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .section-head p {
                max-width: 27rem;
                margin: 0;
                color: #9aa4ad;
                font-size: 0.98rem;
                line-height: 1.7;
            }
            .proof-strip {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                border-top: 1px solid rgba(255,255,255,0.09);
                border-bottom: 1px solid rgba(255,255,255,0.09);
            }
            .proof {
                min-height: 8rem;
                padding: 1.35rem;
                border-right: 1px solid rgba(255,255,255,0.09);
            }
            .proof:last-child { border-right: 0; }
            .proof svg {
                width: 1.35rem;
                height: 1.35rem;
                color: #16a34a;
                margin-bottom: 1rem;
            }
            .proof strong {
                display: block;
                color: white;
                font-size: 0.92rem;
                font-weight: 950;
                text-transform: uppercase;
            }
            .proof span {
                display: block;
                margin-top: 0.35rem;
                color: #828b94;
                font-size: 0.82rem;
                line-height: 1.5;
            }

            .product-showcase {
                display: grid;
                grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.72fr);
                gap: 1rem;
                align-items: stretch;
            }
            .media-panel,
            .buy-panel,
            .detail-card,
            .review-card {
                border: 1px solid rgba(216,221,224,0.12);
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.055), rgba(255,255,255,0.012)),
                    #111315;
                box-shadow: 0 24px 80px rgba(0,0,0,0.3);
            }
            .media-panel {
                border-radius: 1.1rem;
                overflow: hidden;
                min-height: 36rem;
                position: relative;
            }
            .media-panel img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            .media-caption {
                position: absolute;
                left: 1rem;
                right: 1rem;
                bottom: 1rem;
                display: flex;
                justify-content: space-between;
                gap: 1rem;
                align-items: center;
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 0.9rem;
                background: rgba(5,6,7,0.72);
                backdrop-filter: blur(16px);
                padding: 0.85rem 1rem;
            }
            .buy-panel {
                border-radius: 1.1rem;
                padding: 1.25rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 1.25rem;
            }
            .price-row {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
                padding-bottom: 1.2rem;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }
            .price {
                color: white;
                font-size: 2.8rem;
                line-height: 1;
                font-weight: 950;
                font-style: italic;
            }
            .product-title {
                margin: 0.45rem 0 0;
                color: white;
                font-size: clamp(2.2rem, 4vw, 4rem);
                line-height: 0.92;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .feature-list {
                display: grid;
                gap: 0.7rem;
                margin: 0;
                padding: 0;
                list-style: none;
            }
            .feature-list li {
                display: flex;
                gap: 0.7rem;
                color: #d8dde0;
                font-size: 0.92rem;
                line-height: 1.5;
            }
            .feature-list li::before {
                content: "✓";
                color: #16a34a;
                font-weight: 950;
            }
            .add-btn {
                width: 100%;
                min-height: 3.7rem;
                border: 0;
                border-radius: 0.95rem;
                background: #16a34a;
                color: white;
                font-size: 0.9rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                cursor: pointer;
                transition: transform 0.2s ease, background 0.2s ease;
            }
            .add-btn:hover { transform: translateY(-2px); background: #11823a; }
            .tech-link {
                min-height: 3.2rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.14);
                border-radius: 0.95rem;
                color: white;
                font-size: 0.78rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-decoration: none;
            }
            .tech-link:hover { border-color: rgba(34,197,94,0.45); color: #86efac; }

            .detail-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1rem;
                margin-top: 1rem;
            }
            .detail-card {
                border-radius: 1rem;
                padding: 1.25rem;
            }
            .detail-card img {
                width: 100%;
                aspect-ratio: 4 / 3;
                object-fit: cover;
                border-radius: 0.8rem;
                margin-bottom: 1rem;
            }
            .detail-card strong {
                display: block;
                color: white;
                font-size: 1rem;
                font-weight: 950;
                text-transform: uppercase;
            }
            .detail-card p {
                margin: 0.45rem 0 0;
                color: #9aa4ad;
                font-size: 0.88rem;
                line-height: 1.6;
            }

            .reviews-head {
                text-align: center;
                max-width: 42rem;
                margin: 0 auto 2rem;
            }
            .reviews-head h2 {
                margin: 0.55rem 0 0;
                font-size: clamp(2rem, 4vw, 3.8rem);
                line-height: 0.96;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            #reviews-grid-home {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1rem;
            }
            .review-card {
                border-radius: 1rem;
                padding: 1.2rem;
                min-height: 13rem;
            }

            .final-band {
                border-top: 1px solid rgba(255,255,255,0.1);
                border-bottom: 1px solid rgba(255,255,255,0.1);
                background:
                    linear-gradient(120deg, rgba(22,163,74,0.18), rgba(103,232,249,0.06)),
                    rgba(255,255,255,0.02);
            }
            .final-inner {
                width: min(100%, 1180px);
                margin: 0 auto;
                padding: 3rem 1.25rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 2rem;
            }
            .final-inner strong {
                display: block;
                max-width: 12ch;
                font-size: clamp(2rem, 4vw, 4rem);
                line-height: 0.92;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .footer-link { color: #828b94; font-size: 0.72rem; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; }
            .footer-link:hover { color: white; }

            #toast {
                position: fixed;
                bottom: 2rem;
                left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem;
                border-radius: 99px;
                z-index: 9999;
                opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none;
                white-space: nowrap;
            }
            #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
            @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

            @media (max-width: 960px) {
                .nav-link { display: none; }
                .hero-inner,
                .product-showcase,
                .dashboard-grid { grid-template-columns: 1fr; }
                .hero { align-items: center; padding-top: 6.5rem; }
                .hero-inner { align-items: center; }
                .hero-panel { max-width: 28rem; }
                .proof-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                .proof:nth-child(2) { border-right: 0; }
                .proof:nth-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.09); }
                .detail-grid,
                #reviews-grid-home { grid-template-columns: 1fr; }
                .media-panel { min-height: 26rem; }
            }
            @media (max-width: 640px) {
                .site-nav { padding: 1rem !important; }
                .hero h1 { font-size: clamp(3.2rem, 17vw, 5rem); }
                .hero-actions,
                .final-inner,
                .section-head { flex-direction: column; align-items: flex-start; }
                .btn-primary,
                .btn-secondary { width: 100%; }
                .metric-grid { grid-template-columns: 1fr; }
                .proof-strip { grid-template-columns: 1fr; }
                .proof { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.09); }
                .proof:last-child { border-bottom: 0; }
                .media-caption { position: static; border-radius: 0; border-left: 0; border-right: 0; border-bottom: 0; }
                .price-row { align-items: flex-start; flex-direction: column; }
            }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans">
        <div id="toast" role="status" aria-live="polite"></div>

        <nav class="site-nav fixed w-full z-50 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-2xl font-black italic tracking-tighter text-white no-underline">
                <span class="text-green-600">CD</span> MOTOR SHOP
            </a>
            <div class="flex items-center gap-6">
                <a href="#produit-unique" class="nav-link">Produit</a>
                <a href="#compatibilite" class="nav-link">Compatibilité</a>
                <a href="#avis" class="nav-link">Avis</a>

                <div class="flex items-center gap-2">
                    <div class="relative">
                        <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                            class="relative p-2 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                            </svg>
                        </button>
                        <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                            class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                            <p id="account-email" class="text-xs text-white font-black truncate mb-3">—</p>
                            <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                                <a href="/account" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mon compte</a>
                                <a href="/orders" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mes commandes</a>
                            </div>
                            <button id="logout-btn" class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                                Se déconnecter
                            </button>
                        </div>
                    </div>

                    <div class="relative">
                        <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            <span id="cart-count" aria-live="polite" class="absolute -top-1 -right-1 bg-green-600 text-white text-[10px] font-bold h-5 w-5 flex items-center justify-center rounded-full">0</span>
                        </button>
                        <div id="cart-dropdown" role="dialog" aria-label="Panier" class="cart-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 overflow-hidden">
                            <h4 class="text-sm font-black uppercase mb-4 italic text-green-500">Mon Panier</h4>
                            <div id="cart-items" class="space-y-4 max-h-60 overflow-y-auto" aria-live="polite">
                                <p class="text-gray-500 text-xs italic">Votre panier est vide.</p>
                            </div>
                            <div class="border-t border-white/10 mt-4 pt-4">
                                <div class="flex justify-between font-bold text-sm">
                                    <span>TOTAL :</span>
                                    <span id="cart-total">0.00€</span>
                                </div>
                                <button id="checkout-btn" class="w-full bg-white text-black text-xs font-black py-3 mt-4 rounded-xl hover:bg-green-500 hover:text-white transition uppercase">
                                    Commander
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main>
            <section class="hero">
                <div class="hero-bg">
                    <img src={imageBlackMatte2.src} alt="" role="presentation" />
                </div>
                <div class="hero-inner">
                    <div>
                        <span class="eyebrow">Deep Matte</span>
                        <h1>Levier plus net.</h1>
                        <p class="hero-copy">
                            Un pommeau aluminium mat pensé pour transformer le ressenti de conduite sans transformer la voiture. Grip précis, poids rassurant, montage simple.
                        </p>
                        <div class="hero-actions">
                            <a href="#produit-unique" class="btn-primary">Découvrir le produit</a>
                            <a href="/deepmatte" class="btn-secondary">Voir la fiche technique</a>
                        </div>
                    </div>

                    <aside class="hero-panel">
                        <div class="hero-product">
                            <img src={product.image.src} alt={`Photo du produit ${product.nom}`} />
                            <div>
                                <p class="text-gray-500 text-[11px] font-black uppercase tracking-widest">Pommeau aluminium</p>
                                <h2 class="text-white text-2xl font-black italic uppercase leading-none mt-1">{product.nom}</h2>
                                <p class="text-green-500 font-black mt-2">{product.prix.toFixed(2)}€ · Livraison gratuite</p>
                            </div>
                        </div>
                        <div class="metric-grid">
                            <div class="metric"><strong>5 min</strong><span>Montage estimé</span></div>
                            <div class="metric"><strong>M8-12</strong><span>Bagues incluses</span></div>
                            <div class="metric"><strong>245g</strong><span>Poids premium</span></div>
                        </div>
                    </aside>
                </div>
            </section>

            <section class="section-wrap">
                <div class="proof-strip">
                    <div class="proof">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14l-1 12H6L5 8Zm2-4h10l2 4H5l2-4Z"/></svg>
                        <strong>Livraison gratuite</strong>
                        <span>Sans minimum d’achat, avec suivi dans l’espace commandes.</span>
                    </div>
                    <div class="proof">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
                        <strong>Compatibilité claire</strong>
                        <span>Bagues M8, M10 et M12 incluses pour couvrir les montages fréquents.</span>
                    </div>
                    <div class="proof">
