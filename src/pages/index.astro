        <!-- ─── Scripts ─────────────────────────────────────── -->
        <script>
            document.addEventListener('astro:page-load', () => {
                const card = document.getElementById('product-card');
                if (!card || !window.matchMedia('(hover: hover)').matches) return;
                const INTENSITY = 2.5;
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    card.style.transform = `perspective(1400px) rotateX(${(-y * INTENSITY).toFixed(2)}deg) rotateY(${(x * INTENSITY).toFixed(2)}deg)`;
                });
                card.addEventListener('mouseleave', () => {
                    card.style.transition = 'transform 0.5s ease-out';
                    card.style.transform = 'perspective(1400px) rotateX(0deg) rotateY(0deg)';
                    setTimeout(() => { card.style.transition = 'transform 0.1s ease-out'; }, 500);
                });
            });
        </script>

        <script>
            import { initAuthNav } from '../scripts/auth-nav.js';
            document.addEventListener('astro:page-load', () => initAuthNav());
        </script>

        <script>
            import { initCart } from '../scripts/cart.js';
            document.addEventListener('astro:page-load', () => {
                initCart({ id: 'deep-matte-01', nom: 'Deep Matte', prix: 29.90 });
            });
        </script>

        <script>
            import { supabase } from '../lib/supabase.js';

            document.addEventListener('astro:page-load', async () => {
                const COLORS = ['#16a34a','#2563eb','#9333ea','#ea580c','#db2777','#0891b2'];
                const avatarColor = (s) => COLORS[(s?.charCodeAt(0) ?? 0) % COLORS.length];
                const starsHtml = (n) => Array.from({length:5}, (_,i) =>
                    `<span style="color:${i < n ? '#facc15' : '#27272a'}">★</span>`
                ).join('');
                const fmtRelative = (iso) => {
                    const diff = Date.now() - new Date(iso).getTime();
                    const days = Math.max(0, Math.floor(diff / 86400000));
                    if (days < 7) return `Il y a ${days} jour${days > 1 ? 's' : ''}`;
                    if (days < 30) return `Il y a ${Math.floor(days / 7)} semaine${Math.floor(days / 7) > 1 ? 's' : ''}`;
                    return `Il y a ${Math.floor(days / 30)} mois`;
                };

                const fallbackReviews = [
                    { user_id: 'thomas', rating: 5, comment: "Qualité vraiment premium, ça change tout dans l'habitacle. Le toucher est parfait et le montage s'est fait en 5 minutes.", created_at: new Date(Date.now() - 14 * 86400000).toISOString() },
                    { user_id: 'lucas', rating: 5, comment: "Rendu incroyable sur ma Golf 8. La finition aluminium mat est exactement comme sur les photos, voire mieux en vrai.", created_at: new Date(Date.now() - 30 * 86400000).toISOString() },
                    { user_id: 'samir', rating: 4, comment: "Très bonne prise en main, solide et bien fini. Livraison rapide. Une fois en place c'est nickel.", created_at: new Date(Date.now() - 21 * 86400000).toISOString() },
                ];

                const { data: reviews } = await supabase
                    .from('reviews')
                    .select('user_id, rating, comment, created_at')
                    .eq('product_id', 'deep-matte-01')
                    .order('created_at', { ascending: false })
                    .limit(3);

                const data = (reviews && reviews.length > 0) ? reviews : fallbackReviews;
                const avg = (data.reduce((a, r) => a + r.rating, 0) / data.length).toFixed(1);
                const total = reviews?.length ?? 0;

                const avgEl = document.getElementById('home-avg');
                const countEl = document.getElementById('home-count');
                if (avgEl) avgEl.textContent = avg;
                if (countEl) countEl.textContent = total > 0 ? `${total} avis vérifiés` : 'Avis clients';

                const grid = document.getElementById('reviews-grid-home');
                const skel = document.getElementById('reviews-skeleton-home');
                if (!grid) return;

                grid.innerHTML = data.map((review) => {
                    const col = avatarColor(review.user_id);
                    const initial = (review.user_id?.slice(0,1) ?? '?').toUpperCase();
                    const comment = review.comment?.slice(0, 130) ?? '';
                    return `<article class="review-card">
                        <div style="font-size:0.9rem;letter-spacing:0.06em;">${starsHtml(review.rating)}</div>
                        <p style="color:#8a9299;font-size:0.84rem;line-height:1.7;margin-top:1.1rem;">"${comment}${(review.comment?.length ?? 0) > 130 ? '…' : ''}"</p>
                        <div style="display:flex;align-items:center;gap:0.75rem;margin-top:1.5rem;">
                            <div style="height:2rem;width:2rem;border-radius:50%;background:${col}1a;border:1px solid ${col}55;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:0.75rem;color:${col};flex-shrink:0;">${initial}</div>
                            <div>
                                <p style="color:white;font-size:0.65rem;font-weight:900;text-transform:uppercase;letter-spacing:0.08em;">Client vérifié</p>
                                <p style="color:#4a5260;font-size:0.6rem;margin-top:0.1rem;">${fmtRelative(review.created_at)}</p>
                            </div>
                        </div>
                    </article>`;
                }).join('');

                if (skel) skel.style.display = 'none';
                grid.style.display = 'grid';
            });
        </script>

        <script>
            import { initSiteEffects } from '../scripts/site-effects.js';
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener('astro:page-load', runSiteEffects);
            if (document.readyState !== 'loading') runSiteEffects();
            else document.addEventListener('DOMContentLoaded', runSiteEffects, { once: true });
        </script>
