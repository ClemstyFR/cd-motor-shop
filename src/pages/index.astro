astro_content = """---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = {
    id: 'deep-matte-01',
    nom: 'Deep Matte',
    description: 'Finition aluminium premium, prise en main parfaite pour une précision maximale.',
    prix: 29.90,
    image: imageBlackMatte1,
    link: '/deepmatte',
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>CD Motor Shop | Le détail qui redéfinit l'excellence.</title>
        <meta name="description" content="CD Motor Shop — Pommeau de levier de vitesse aluminium premium Deep Matte. Livraison gratuite, compatibilité universelle M8/M10/M12." />
        <meta property="og:title" content="CD Motor Shop | Le détail qui redéfinit l'excellence." />
        <meta property="og:description" content="Pommeau Deep Matte en aluminium premium. Prise en main parfaite, montage en 5 min, livraison gratuite." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <style>
            /* ─── Reset & Base ─────────────────────────────────── */
            *, *::before, *::after { 
                box-sizing: border-box;
                margin: 0; 
                padding: 0; 
            }
            html { 
                scroll-behavior: smooth;
                background-color: #050607;
            }

            :root {
                --ink:    #050607;
                --white:  #ffffff;
                --muted:  #9aa4ad;
                --dim:    #4a5260;
                --green:  #16a34a;
                --green-h:#11823a;
                --cyan:   #67e8f9;
                --border: rgba(255,255,255,0.06);
                --glass:  rgba(5,6,7,0.45);
                --ease-elegant: cubic-bezier(0.16, 1, 0.3, 1);
            }

            body {
                overflow-x: hidden;
            }

            /* ─── Dropdowns ────────────────────────────────────── */
            .cart-dropdown,
            .account-dropdown {
                display: none;
                pointer-events: none;
                backdrop-filter: blur(30px);
                background: rgba(15, 17, 20, 0.92) !important;
                border: 1px solid var(--border);
                border-radius: 24px !important;
                box-shadow: 0 40px 80px rgba(0,0,0,0.6);
                transform: translateY(12px);
                transition: opacity 0.4s var(--ease-elegant), transform 0.4s var(--ease-elegant);
            }
            .cart-dropdown { 
                width: min(22rem, calc(100vw - 2rem));
            }
            .cart-dropdown.is-open,
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
                transform: translateY(0);
            }

            /* ─── Navigation ───────────────────────────────────── */
            .site-nav {
                position: fixed;
                top: 1.5rem; 
                left: 50%;
                transform: translateX(-50%);
                width: calc(100% - 3rem);
                max-width: 1200px;
                z-index: 50;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.85rem 2rem;
                background: var(--glass);
                border: 1px solid var(--border);
                backdrop-filter: blur(24px);
                border-radius: 9999px;
                transition: all 0.4s var(--ease-elegant);
            }
            .nav-logo {
                font-size: 1.05rem;
                font-weight: 800;
                letter-spacing: -0.03em;
                color: var(--white);
                text-decoration: none;
                line-height: 1;
            }
            .nav-logo span { 
                color: var(--green); 
            }
            .nav-center {
                display: flex;
                align-items: center;
                gap: 2.5rem;
            }
            .nav-link {
                color: var(--muted);
                font-size: 0.75rem;
                font-weight: 600;
                letter-spacing: 0.02em;
                text-decoration: none;
                transition: color 0.25s var(--ease-elegant);
            }
            .nav-link:hover { 
                color: var(--white); 
            }
            .nav-icons { 
                display: flex; 
                align-items: center; 
                gap: 0.75rem; 
            }

            /* ─── Hero Section ─────────────────────────────────── */
            .hero {
                position: relative;
                min-height: 100vh;
                display: grid;
                grid-template-columns: 1.1fr 1fr;
                align-items: center;
                max-width: 1200px;
                margin: 0 auto;
                padding: 7rem 2rem 2rem 2rem;
                gap: 4rem;
            }
            .hero-text {
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            .eyebrow {
                color: var(--green);
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                display: inline-block;
                margin-bottom: 0.75rem;
                opacity: 0;
                animation: fadeUp 0.8s var(--ease-elegant) 0.1s forwards;
            }
            .hero-h1 {
                font-size: clamp(2.6rem, 4.5vw, 4.2rem);
                line-height: 1.1;
                font-weight: 800;
                letter-spacing: -0.03em;
                color: var(--white);
                opacity: 0;
                animation: fadeUp 0.8s var(--ease-elegant) 0.2s forwards;
            }
            .hero-copy {
                margin-top: 1.5rem;
                max-width: 28rem;
                color: var(--muted);
                font-size: 0.98rem;
                line-height: 1.65;
                opacity: 0;
                animation: fadeUp 0.8s var(--ease-elegant) 0.3s forwards;
            }
            .hero-actions {
                display: flex;
                gap: 1rem;
                margin-top: 2.5rem;
                flex-wrap: wrap;
                opacity: 0;
                animation: fadeUp 0.8s var(--ease-elegant) 0.4s forwards;
            }

            /* Right column — Image block with generous roundings */
            .hero-media {
                position: relative;
                overflow: hidden;
                border-radius: 32px;
                height: 75vh;
                box-shadow: 0 40px 100px rgba(0,0,0,0.8);
                opacity: 0;
                animation: scaleIn 1.2s var(--ease-elegant) forwards;
            }
            .hero-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                transition: transform 1.2s var(--ease-elegant);
            }
            .hero-media:hover img {
                transform: scale(1.04);
            }

            /* Stats Bar */
            .hero-stats {
                display: flex;
                gap: 3rem;
                margin-top: 4rem;
                padding-top: 2rem;
                border-top: 1px solid var(--border);
                opacity: 0;
                animation: fadeUp 0.8s var(--ease-elegant) 0.5s forwards;
            }
            .hero-stat {
                display: flex;
                flex-direction: column;
            }
            .hero-stat strong {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--white);
                line-height: 1.2;
            }
            .hero-stat span {
                margin-top: 0.3rem;
                font-size: 0.65rem;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: var(--dim);
            }

            /* ─── Buttons ──────────────────────────────────────── */
            .btn-main, .btn-ghost {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 3.2rem;
                padding: 0 2rem;
                border-radius: 9999px;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.01em;
                text-decoration: none;
                cursor: pointer;
                border: 0;
                transition: all 0.35s var(--ease-elegant);
            }
            .btn-main {
                background: var(--white);
                color: var(--ink);
            }
            .btn-main:hover { 
                background: var(--green); 
                color: var(--white);
                transform: translateY(-2px);
                box-shadow: 0 15px 30px rgba(22, 163, 74, 0.25);
            }
            .btn-ghost {
                background: rgba(255,255,255,0.02);
                border: 1px solid var(--border);
                color: var(--white);
            }
            .btn-ghost:hover { 
                background: rgba(255,255,255,0.06);
                border-color: rgba(255,255,255,0.2);
                transform: translateY(-2px); 
            }

            /* ─── Product Section ──────────────────────────────── */
            .product-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 8rem 2rem;
            }
            .section-label {
                display: flex;
                align-items: center;
                gap: 1.5rem;
                margin-bottom: 3rem;
            }
            .section-label::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--border);
            }

            /* Clean Minimalist Product Card */
            .product-card {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3.5rem;
                background: rgba(255, 255, 255, 0.01);
                border: 1px solid var(--border);
                border-radius: 32px;
                padding: 2.5rem;
                overflow: hidden;
                transition: border-color 0.4s var(--ease-elegant), box-shadow 0.4s var(--ease-elegant);
                will-change: transform;
            }
            .product-card:hover {
                border-color: rgba(22, 163, 74, 0.2);
                box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 40px rgba(22,163,74,0.02);
            }
            .product-media {
                aspect-ratio: 1 / 1;
                overflow: hidden;
                border-radius: 20px;
                background: #08090a;
            }
            .product-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.8s var(--ease-elegant);
            }
            .product-info {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 0.5rem 0;
            }
            .product-name {
                font-size: clamp(2rem, 4vw, 3rem);
                line-height: 1.1;
                font-weight: 800;
                color: var(--white);
                margin-top: 0.5rem;
            }
            .product-copy {
                margin-top: 1.25rem;
                color: var(--muted);
                font-size: 0.95rem;
                line-height: 1.6;
            }
            .feature-list {
                list-style: none;
                margin-top: 2rem;
                display: grid;
                gap: 0.8rem;
            }
            .feature-list li {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                color: #8a9299;
                font-size: 0.88rem;
            }
            .feature-list li::before {
                content: "✓";
                color: var(--green);
                font-weight: 700;
                flex-shrink: 0;
            }
            .price-block {
                padding-top: 2rem;
                margin-top: 2rem;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }
            .price {
                font-size: 2.6rem;
                font-weight: 800;
                color: var(--white);
                line-height: 1;
            }
            .price-note {
                font-size: 0.7rem;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: var(--green);
                margin-top: 0.4rem;
            }
            .rating-block { 
                text-align: right;
            }
            .rating-stars { 
                color: #facc15; 
                font-size: 0.9rem; 
                letter-spacing: 0.05em;
            }
            .rating-count { 
                color: var(--dim); 
                font-size: 0.7rem; 
                font-weight: 600;
                margin-top: 0.3rem; 
            }
            .add-btn {
                width: 100%;
                min-height: 3.5rem;
                margin-top: 2rem;
                background: var(--green);
                border: 0;
                border-radius: 16px;
                color: var(--white);
                font-size: 0.8rem;
                font-weight: 700;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.3s var(--ease-elegant);
            }
            .add-btn:hover { 
                background: var(--green-h);
                transform: translateY(-2px);
                box-shadow: 0 15px 30px rgba(22, 163, 74, 0.25);
            }
            .tech-link {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 3rem;
                margin-top: 0.75rem;
                border: 1px solid var(--border);
                border-radius: 16px;
                color: var(--muted);
                font-size: 0.75rem;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.3s var(--ease-elegant);
            }
            .tech-link:hover { 
                border-color: rgba(22,197,94,0.3); 
                color: #86efac; 
                background: rgba(22, 197, 94, 0.02);
            }

            /* ─── Visual Tiles ─────────────────────────────────── */
            .visual-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 2rem 8rem;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 2rem;
            }
            .visual-tile {
                position: relative;
                min-height: 34rem;
                overflow: hidden;
                border-radius: 28px;
                background: #0c0d0e;
                box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            }
            .visual-tile img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 1.2s var(--ease-elegant);
            }
            .visual-tile:hover img { 
                transform: scale(1.05); 
            }
            .visual-caption {
                position: absolute;
                bottom: 1.5rem;
                left: 1.5rem;
                right: 1.5rem;
                background: rgba(10, 12, 15, 0.65);
                backdrop-filter: blur(20px);
                border: 1px solid var(--border);
                padding: 1.25rem 1.5rem;
                border-radius: 20px;
                transition: transform 0.3s var(--ease-elegant), background 0.3s var(--ease-elegant);
            }
            .visual-tile:hover .visual-caption {
                background: rgba(10, 12, 15, 0.8);
                transform: translateY(-4px);
            }
            .visual-caption strong {
                display: block;
                color: var(--white);
                font-size: 0.9rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
            }
            .visual-caption span {
                display: block;
                color: var(--muted);
                font-size: 0.8rem;
                line-height: 1.5;
            }

            /* ─── Reviews Section ──────────────────────────────── */
            .reviews-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 8rem 2rem;
            }
            .reviews-header {
                display: grid;
                grid-template-columns: 1fr auto;
                align-items: flex-end;
                gap: 2rem;
                margin-bottom: 4rem;
                padding-bottom: 2rem;
                border-bottom: 1px solid var(--border);
            }
            .reviews-header h2 {
                font-size: clamp(1.8rem, 3.5vw, 2.6rem);
                font-weight: 800;
                line-height: 1.1;
                color: var(--white);
            }
            .reviews-avg {
                text-align: right;
                white-space: nowrap;
            }
            .avg-num {
                display: block;
                font-size: 3.2rem;
                font-weight: 800;
                color: var(--white);
                line-height: 1;
            }
            .avg-stars { 
                color: #facc15; 
                font-size: 0.9rem; 
                margin-top: 0.3rem; 
            }
            .avg-count { 
                color: var(--dim); 
                font-size: 0.7rem; 
                font-weight: 600;
                letter-spacing: 0.05em; 
                text-transform: uppercase; 
                margin-top: 0.4rem; 
            }

            #reviews-grid-home, #reviews-skeleton-home {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
            .review-card {
                background: rgba(255, 255, 255, 0.01);
                border: 1px solid var(--border);
                border-radius: 24px;
                padding: 2rem;
                transition: all 0.35s var(--ease-elegant);
            }
            .review-card:hover {
                border-color: rgba(255,255,255,0.12);
                background: rgba(255, 255, 255, 0.02);
                transform: translateY(-4px);
            }

            /* ─── Final CTA ────────────────────────────────────── */
            .final-cta {
                padding: 4rem 2rem 8rem 2rem;
            }
            .final-inner {
                max-width: 1200px;
                margin: 0 auto;
                padding: 5rem 4rem;
                background: radial-gradient(circle at top right, rgba(22, 163, 74, 0.06), transparent 60%), rgba(255, 255, 255, 0.01);
                border: 1px solid var(--border);
                border-radius: 40px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 3rem;
            }
            .final-inner strong {
                font-size: clamp(1.8rem, 3.2vw, 2.6rem);
                font-weight: 800;
                color: var(--white);
                line-height: 1.1;
                max-width: 18ch;
                display: block;
            }
            .final-actions { 
                display: flex; 
                gap: 1rem; 
                flex-wrap: wrap; 
            }

            /* ─── Footer ───────────────────────────────────────── */
            .site-footer {
                border-top: 1px solid var(--border);
                padding: 4rem 2rem;
                max-width: 1200px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 2rem;
            }
            .footer-brand {
                font-size: 1rem;
                font-weight: 800;
                color: var(--white);
            }
            .footer-brand span { 
                color: var(--green); 
            }
            .footer-links { 
                display: flex; 
                flex-wrap: wrap; 
                gap: 2rem; 
            }
            .footer-link {
                color: var(--dim);
                font-size: 0.75rem;
                font-weight: 500;
                text-decoration: none;
                transition: color 0.25s var(--ease-elegant);
            }
            .footer-link:hover { 
                color: var(--white); 
            }
            .footer-copy {
                width: 100%;
                color: var(--dim);
                font-size: 0.7rem;
                margin-top: 1rem;
            }

            /* ─── Toast System ─────────────────────────────────── */
            #toast {
                position: fixed;
                bottom: 2.5rem; 
                left: 50%;
                transform: translateX(-50%) translateY(40px);
                background: var(--white);
                color: var(--ink);
                font-weight: 700;
                font-size: 0.75rem;
                padding: 0.8rem 1.6rem;
                border-radius: 9999px;
                z-index: 9999;
                opacity: 0;
                box-shadow: 0 20px 40px rgba(0,0,0,0.4);
                transition: transform 0.4s var(--ease-elegant), opacity 0.3s ease;
                pointer-events: none;
                white-space: nowrap;
            }
            #toast.show { 
                transform: translateX(-50%) translateY(0); 
                opacity: 1; 
            }

            /* ─── Motion Keyframes ────────────────────────────── */
            @keyframes fadeUp {
                from { 
                    opacity: 0;
                    transform: translateY(24px); 
                }
                to { 
                    opacity: 1;
                    transform: translateY(0); 
                }
            }
            @keyframes scaleIn {
                from { 
                    opacity: 0;
                    transform: scale(0.97); 
                }
                to { 
                    opacity: 1;
                    transform: scale(1); 
                }
            }
            @keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }

            /* ─── Responsive Breakdown ─────────────────────────── */
            @media (max-width: 900px) {
                .site-nav { 
                    top: 1rem;
                    width: calc(100% - 2rem);
                    padding: 0.75rem 1.25rem;
                }
                .nav-center .nav-link { 
                    display: none; 
                }

                .hero { 
                    grid-template-columns: 1fr;
                    padding-top: 8rem;
                    gap: 3rem;
                }
                .hero-media { 
                    height: 45vh;
                    order: -1; 
                    border-radius: 24px;
                }
                .hero-text { 
                    padding: 0; 
                }
                .hero-stats {
                    gap: 1.5rem;
                    justify-content: space-between;
                }

                .product-section { 
                    padding: 6rem 1.25rem; 
                }
                .product-card { 
                    grid-template-columns: 1fr;
                    gap: 2rem;
                    padding: 1.5rem;
                    border-radius: 24px;
                }
                .product-media { 
                    aspect-ratio: 1.2 / 1; 
                }

                .visual-section { 
                    grid-template-columns: 1fr;
                    padding: 0 1.25rem 6rem;
                    gap: 1.5rem;
                }
                .visual-tile { 
                    min-height: 24rem; 
                    border-radius: 24px;
                }

                .reviews-section { 
                    padding: 6rem 1.25rem; 
                }
                #reviews-grid-home, #reviews-skeleton-home { 
                    grid-template-columns: 1fr;
                    gap: 1rem;
                }
                .reviews-header { 
                    grid-template-columns: 1fr;
                    gap: 1rem;
                }
                .reviews-avg { 
                    text-align: left; 
                }

                .final-inner { 
                    flex-direction: column;
                    padding: 3rem 2rem; 
                    border-radius: 28px;
                    align-items: flex-start;
                    gap: 2rem;
                }
                .final-actions { 
                    width: 100%; 
                }
                .final-actions .btn-main,
                .final-actions .btn-ghost { 
                    width: 100%; 
                }

                .site-footer { 
                    padding: 3rem 1.25rem; 
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1.5rem;
                }
                .footer-links {
                    flex-direction: column;
                    gap: 1rem;
                }
            }
        </style>
        <ClientRouter />
    </head>

    <body class="bg-[#050607] text-white font-sans">
        <div id="toast" role="status" aria-live="polite"></div>

        <nav class="site-nav">
            <a href="/" class="nav-logo"><span>CD</span> Motor Shop</a>

            <div class="nav-center">
                <a href="#produit-unique" class="nav-link">Produit</a>
                <a href="#details" class="nav-link">Détails</a>
                <a href="#avis" class="nav-link">Avis</a>

                <div class="nav-icons">
                    <div class="relative">
                        <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown" class="relative p-2 flex items-center justify-center text-gray-400 hover:text-white transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                            </svg>
                        </button>
                        <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                            class="account-dropdown absolute right-0 mt-3 bg-zinc-900/90 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
