---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = {
    id: 'deep-matte-01',
    nom: 'Deep Matte',
    description: 'Finition aluminium premium, prise en main parfaite pour une précision maximale.',
    prix: 29.90,
    image: imageBlackMatte1,
    link: '/deepmatte',
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>CD Motor Shop | Le détail qui change tout.</title>
        <meta name="description" content="CD Motor Shop — Pommeau de levier de vitesse aluminium premium Deep Matte. Livraison gratuite, compatibilité universelle M8/M10/M12." />
        <meta property="og:title" content="CD Motor Shop | Le détail qui change tout." />
        <meta property="og:description" content="Pommeau Deep Matte en aluminium premium. Prise en main parfaite, montage en 5 min, livraison gratuite." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <style>
            /* ─── Reset & base ─────────────────────────────────── */
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            html { scroll-behavior: smooth; }

            :root {
                --ink:    #050607;
                --white:  #ffffff;
                --muted:  #9aa4ad;
                --dim:    #4a5260;
                --green:  #16a34a;
                --green-h:#11823a;
                --cyan:   #67e8f9;
                --border: rgba(255,255,255,0.09);
                --glass:  rgba(5,6,7,0.78);
            }

            /* ─── Dropdowns ────────────────────────────────────── */
            .cart-dropdown,
            .account-dropdown {
                display: none;
                pointer-events: none;
            }
            .cart-dropdown { width: min(18rem, calc(100vw - 2rem)); }
            .cart-dropdown.is-open,
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            /* ─── Nav ──────────────────────────────────────────── */
            .site-nav {
                position: fixed;
                top: 0; left: 0; right: 0;
                z-index: 50;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1.25rem 2.5rem;
                background: var(--glass);
                border-bottom: 1px solid var(--border);
                backdrop-filter: blur(20px);
            }
            .nav-logo {
                font-size: 1rem;
                font-weight: 950;
                font-style: italic;
                letter-spacing: -0.02em;
                text-transform: uppercase;
                color: var(--white);
                text-decoration: none;
                line-height: 1;
            }
            .nav-logo span { color: var(--green); }
            .nav-center {
                display: flex;
                align-items: center;
                gap: 2rem;
            }
            .nav-link {
                color: var(--muted);
                font-size: 0.65rem;
                font-weight: 900;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                text-decoration: none;
                transition: color 0.18s;
            }
            .nav-link:hover { color: var(--white); }
            .nav-icons { display: flex; align-items: center; gap: 0.5rem; }

            /* ─── Hero ─────────────────────────────────────────── */
            .hero {
                position: relative;
                min-height: 100svh;
                display: grid;
                grid-template-columns: 1fr 1fr;
                overflow: hidden;
            }

            /* Left column — text */
            .hero-text {
                position: relative;
                z-index: 1;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                padding: 8rem 4rem 5rem 2.5rem;
                background: var(--ink);
            }
            .eyebrow {
                color: var(--cyan);
                font-size: 0.62rem;
                font-weight: 900;
                letter-spacing: 0.18em;
                text-transform: uppercase;
                opacity: 0;
                animation: fadeUp 0.7s ease-out 0.1s forwards;
            }
            .hero-h1 {
                margin-top: 1.1rem;
                font-size: clamp(3.2rem, 5.5vw, 6.5rem);
                line-height: 0.88;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                color: var(--white);
                opacity: 0;
                animation: fadeUp 0.7s ease-out 0.2s forwards;
            }
            .hero-copy {
                margin-top: 1.8rem;
                max-width: 32rem;
                color: var(--muted);
                font-size: 0.92rem;
                line-height: 1.8;
                opacity: 0;
                animation: fadeUp 0.7s ease-out 0.3s forwards;
            }
            .hero-actions {
                display: flex;
                gap: 0.75rem;
                margin-top: 2.5rem;
                flex-wrap: wrap;
                opacity: 0;
                animation: fadeUp 0.7s ease-out 0.4s forwards;
            }

            /* Right column — full-bleed image */
            .hero-media {
                position: relative;
                overflow: hidden;
            }
            .hero-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
                filter: saturate(0.9) contrast(1.06);
                opacity: 0.72;
                display: block;
            }
            .hero-media::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(90deg, var(--ink) 0%, transparent 18%);
                z-index: 1;
            }

            /* Stats bar at bottom of text column */
            .hero-stats {
                display: flex;
                gap: 0;
                margin-top: 3.5rem;
                border-top: 1px solid var(--border);
                opacity: 0;
                animation: fadeUp 0.7s ease-out 0.5s forwards;
            }
            .hero-stat {
                flex: 1;
                padding: 1.1rem 1rem 0 0;
            }
            .hero-stat:not(:last-child) {
                border-right: 1px solid var(--border);
                margin-right: 1rem;
            }
            .hero-stat strong {
                display: block;
                font-size: 1.4rem;
                font-weight: 950;
                font-style: italic;
                color: var(--white);
                line-height: 1;
            }
            .hero-stat span {
                display: block;
                margin-top: 0.3rem;
                font-size: 0.58rem;
                font-weight: 900;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--dim);
            }

            /* ─── Buttons ──────────────────────────────────────── */
            .btn-main, .btn-ghost {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 3rem;
                padding: 0 1.5rem;
                border-radius: 4px;
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-decoration: none;
                cursor: pointer;
                border: 0;
                transition: background 0.18s, transform 0.18s, border-color 0.18s, color 0.18s;
            }
            .btn-main {
                background: var(--green);
                color: var(--white);
            }
            .btn-main:hover { background: var(--green-h); transform: translateY(-1px); }
            .btn-ghost {
                background: transparent;
                border: 1px solid var(--border);
                color: var(--white);
            }
            .btn-ghost:hover { border-color: rgba(255,255,255,0.3); transform: translateY(-1px); }

            /* ─── Product section ──────────────────────────────── */
            .product-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 8rem 2.5rem;
            }
            .section-label {
                display: flex;
                align-items: center;
                gap: 1rem;
                margin-bottom: 4rem;
            }
            .section-label::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--border);
            }

            /* Product layout: image | info */
            .product-card {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0;
                border: 1px solid var(--border);
                border-radius: 2px;
                overflow: hidden;
                background: #0c0d0e;
                transform-style: preserve-3d;
                transition: transform 0.1s ease-out;
                will-change: transform;
            }
            .product-media {
                aspect-ratio: 1 / 1.1;
                overflow: hidden;
                background: #08090a;
            }
            .product-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.6s ease;
            }
            .product-card:hover .product-media img {
                transform: scale(1.03);
            }
            .product-info {
                padding: clamp(2rem, 5vw, 3.5rem);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                border-left: 1px solid var(--border);
            }
            .product-name {
                font-size: clamp(2.5rem, 4.5vw, 5rem);
                line-height: 0.88;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                color: var(--white);
                margin-top: 0.4rem;
            }
            .product-copy {
                margin-top: 1.5rem;
                color: var(--muted);
                font-size: 0.9rem;
                line-height: 1.75;
            }
            .feature-list {
                list-style: none;
                margin-top: 2rem;
                display: grid;
                gap: 0.7rem;
            }
            .feature-list li {
                display: flex;
                gap: 0.6rem;
                color: #8a9299;
                font-size: 0.82rem;
                line-height: 1.5;
            }
            .feature-list li::before {
                content: "—";
                color: var(--green);
                font-weight: 950;
                flex-shrink: 0;
            }
            .price-block {
                padding-top: 2rem;
                margin-top: 2rem;
                border-top: 1px solid var(--border);
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
            }
            .price {
                font-size: 3.2rem;
                font-weight: 950;
                font-style: italic;
                color: var(--white);
                line-height: 1;
            }
            .price-note {
                font-size: 0.62rem;
                font-weight: 900;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--dim);
                margin-top: 0.35rem;
            }
            .rating-block { text-align: right; }
            .rating-stars { color: #facc15; font-size: 0.9rem; letter-spacing: 0.05em; }
            .rating-count { color: var(--dim); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 0.2rem; }
            .add-btn {
                width: 100%;
                min-height: 3.5rem;
                margin-top: 1.25rem;
                background: var(--green);
                border: 0;
                border-radius: 2px;
                color: var(--white);
                font-size: 0.72rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                cursor: pointer;
                transition: background 0.18s, transform 0.18s;
            }
            .add-btn:hover { background: var(--green-h); transform: translateY(-1px); }
            .tech-link {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 2.8rem;
                margin-top: 0.75rem;
                border: 1px solid var(--border);
                border-radius: 2px;
                color: var(--muted);
                font-size: 0.65rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-decoration: none;
                transition: border-color 0.18s, color 0.18s;
            }
            .tech-link:hover { border-color: rgba(34,197,94,0.4); color: #86efac; }

            /* ─── Visual duo ───────────────────────────────────── */
            .visual-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 2.5rem 8rem;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1px;
                background: var(--border);
                border: 1px solid var(--border);
                border-radius: 2px;
                overflow: hidden;
            }
            .visual-tile {
                position: relative;
                min-height: 32rem;
                overflow: hidden;
                background: #0c0d0e;
            }
            .visual-tile img {
                width: 100%; height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.6s ease;
            }
            .visual-tile:hover img { transform: scale(1.04); }
            .visual-caption {
                position: absolute;
                bottom: 1.25rem;
                left: 1.25rem;
                right: 1.25rem;
                background: rgba(5,6,7,0.8);
                backdrop-filter: blur(14px);
                border: 1px solid var(--border);
                padding: 0.9rem 1rem;
                border-radius: 2px;
            }
            .visual-caption strong {
                display: block;
                color: var(--white);
                font-size: 0.78rem;
                font-weight: 950;
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }
            .visual-caption span {
                display: block;
                margin-top: 0.25rem;
                color: var(--muted);
                font-size: 0.76rem;
                line-height: 1.5;
            }

            /* ─── Reviews ──────────────────────────────────────── */
            .reviews-section {
                max-width: 1200px;
                margin: 0 auto;
                padding: 8rem 2.5rem;
            }
            .reviews-header {
                display: grid;
                grid-template-columns: 1fr auto;
                align-items: end;
                gap: 2rem;
                margin-bottom: 3rem;
                padding-bottom: 2rem;
                border-bottom: 1px solid var(--border);
            }
            .reviews-header h2 {
                font-size: clamp(2rem, 4vw, 4rem);
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                line-height: 0.9;
                color: var(--white);
            }
            .reviews-avg {
                text-align: right;
                white-space: nowrap;
            }
            .avg-num {
                display: block;
                font-size: 3rem;
                font-weight: 950;
                font-style: italic;
                color: var(--white);
                line-height: 1;
            }
            .avg-stars { color: #facc15; font-size: 0.85rem; margin-top: 0.2rem; }
            .avg-count { color: var(--dim); font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 0.25rem; }

            #reviews-grid-home {
                grid-template-columns: repeat(3, 1fr);
                gap: 1px;
                background: var(--border);
                border: 1px solid var(--border);
                border-radius: 2px;
                overflow: hidden;
            }
            .review-card {
                background: #0c0d0e;
                padding: 1.6rem;
            }
            #reviews-skeleton-home {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1px;
                background: var(--border);
                border: 1px solid var(--border);
                border-radius: 2px;
                overflow: hidden;
            }

            /* ─── Final CTA ────────────────────────────────────── */
            .final-cta {
                border-top: 1px solid var(--border);
            }
            .final-inner {
                max-width: 1200px;
                margin: 0 auto;
                padding: 5rem 2.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
            }
            .final-inner strong {
                font-size: clamp(2rem, 4vw, 4.2rem);
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                color: var(--white);
                line-height: 0.9;
                max-width: 12ch;
                display: block;
            }
            .final-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

            /* ─── Footer ───────────────────────────────────────── */
            .site-footer {
                border-top: 1px solid var(--border);
                padding: 3rem 2.5rem;
                max-width: 1200px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 1.5rem;
            }
            .footer-brand {
                font-size: 0.8rem;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                color: var(--white);
            }
            .footer-brand span { color: var(--green); }
            .footer-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
            .footer-link {
                color: var(--dim);
                font-size: 0.6rem;
                font-weight: 800;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-decoration: none;
                transition: color 0.18s;
            }
            .footer-link:hover { color: var(--white); }
            .footer-copy {
                width: 100%;
                color: var(--dim);
                font-size: 0.58rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            /* ─── Toast ────────────────────────────────────────── */
            #toast {
                position: fixed;
                bottom: 2rem; left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: var(--green);
                color: var(--white);
                font-weight: 900;
                font-size: 0.65rem;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                padding: 0.65rem 1.4rem;
                border-radius: 2px;
                z-index: 9999;
                opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none;
                white-space: nowrap;
            }
            #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }

            /* ─── Animations ───────────────────────────────────── */
            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(20px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            @keyframes shimmer {
                0%   { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }

            /* ─── Responsive ───────────────────────────────────── */
            @media (max-width: 900px) {
                .site-nav { padding: 1rem 1.25rem; }
                .nav-center .nav-link { display: none; }

                .hero { grid-template-columns: 1fr; min-height: auto; }
                .hero-media { height: 55vw; order: -1; }
                .hero-media::before { background: linear-gradient(180deg, transparent 60%, var(--ink) 100%); }
                .hero-text { padding: 2rem 1.25rem 4rem; }

                .product-section { padding: 5rem 1.25rem; }
                .product-card { grid-template-columns: 1fr; }
                .product-info { border-left: 0; border-top: 1px solid var(--border); }
                .product-media { aspect-ratio: 4/3; }

                .visual-section { grid-template-columns: 1fr; padding: 0 1.25rem 5rem; }
                .visual-tile { min-height: 22rem; }

                .reviews-section { padding: 5rem 1.25rem; }
                #reviews-grid-home { grid-template-columns: 1fr; }
                #reviews-skeleton-home { grid-template-columns: 1fr; }
                .reviews-header { grid-template-columns: 1fr; }
                .reviews-avg { text-align: left; }

                .final-inner { flex-direction: column; padding: 3.5rem 1.25rem; }
                .final-actions { flex-direction: column; width: 100%; }
                .final-actions .btn-main,
                .final-actions .btn-ghost { width: 100%; justify-content: center; }

                .site-footer { padding: 2.5rem 1.25rem; flex-direction: column; }
            }
        </style>
        <ClientRouter />
    </head>

    <body class="bg-black text-white font-sans">
        <div id="toast" role="status" aria-live="polite"></div>

        <!-- ─── Nav ──────────────────────────────────────── -->
        <nav class="site-nav">
            <a href="/" class="nav-logo"><span>CD</span> Motor Shop</a>

            <div class="nav-center">
                <a href="#produit-unique" class="nav-link">Produit</a>
                <a href="#details" class="nav-link">Détails</a>
                <a href="#avis" class="nav-link">Avis</a>

                <div class="nav-icons">
                    <!-- Account -->
                    <div class="relative">
                        <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown" class="relative p-2 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                            </svg>
                        </button>
                        <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                            class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                            <p id="account-email" class="text-xs text-white font-black truncate mb-3">—</p>
                            <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                                <a href="/account" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mon compte</a>
                                <a href="/orders" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mes commandes</a>
                            </div>
                            <button id="logout-btn" class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                                Se déconnecter
                            </button>
                        </div>
                    </div>

                    <!-- Cart -->
                    <div class="relative">
                        <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            <span id="cart-count" aria-live="polite" class="absolute -top-0.5 -right-0.5 bg-green-600 text-white text-[9px] font-bold h-4 w-4 flex items-center justify-center rounded-full">0</span>
                        </button>
                        <div id="cart-dropdown" role="dialog" aria-label="Panier" class="cart-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 overflow-hidden">
                            <h4 class="text-sm font-black uppercase mb-4 italic text-green-500">Mon Panier</h4>
                            <div id="cart-items" class="space-y-4 max-h-60 overflow-y-auto" aria-live="polite">
                                <p class="text-gray-500 text-xs italic">Votre panier est vide.</p>
                            </div>
                            <div class="border-t border-white/10 mt-4 pt-4">
                                <div class="flex justify-between font-bold text-sm">
                                    <span>TOTAL :</span>
                                    <span id="cart-total">0.00€</span>
                                </div>
