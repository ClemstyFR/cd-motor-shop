---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = {
    id: 'deep-matte-01',
    nom: 'Deep Matte',
    description: 'Finition aluminium premium, prise en main parfaite pour une précision maximale.',
    prix: 29.90,
    image: imageBlackMatte1,
    link: '/deepmatte',
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>CD Motor Shop | Le détail qui change tout.</title>
        <meta name="description" content="CD Motor Shop — Pommeau de levier de vitesse aluminium premium Deep Matte. Livraison gratuite, compatibilité universelle M8/M10/M12." />
        <meta property="og:title" content="CD Motor Shop | Le détail qui change tout." />
        <meta property="og:description" content="Pommeau Deep Matte en aluminium premium. Prise en main parfaite, montage en 5 min, livraison gratuite." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <style>
            html { scroll-behavior: smooth; }

            .cart-dropdown,
            .account-dropdown {
                display: none;
                pointer-events: none;
            }
            .cart-dropdown {
                width: min(18rem, calc(100vw - 2rem));
            }
            .cart-dropdown.is-open,
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .site-nav {
                background: rgba(5,6,7,0.72);
                border-bottom: 1px solid rgba(255,255,255,0.08);
                backdrop-filter: blur(18px);
            }
            .nav-center {
                display: flex;
                align-items: center;
                gap: 1.5rem;
            }
            .nav-link {
                color: #9aa4ad;
                font-size: 0.7rem;
                font-weight: 900;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                text-decoration: none;
                transition: color 0.2s ease;
            }
            .nav-link:hover { color: white; }

            .hero {
                position: relative;
                min-height: 100svh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                padding: 8rem 1.25rem 4rem;
            }
            .hero-bg {
                position: absolute;
                inset: 0;
                z-index: 0;
            }
            .hero-bg img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0.44;
                filter: saturate(0.88) contrast(1.08);
            }
            .hero-bg::after {
                content: "";
                position: absolute;
                inset: 0;
                background:
                    radial-gradient(circle at 50% 40%, transparent 0%, rgba(5,6,7,0.15) 34%, rgba(5,6,7,0.82) 78%),
                    linear-gradient(180deg, rgba(5,6,7,0.1) 0%, rgba(5,6,7,0.35) 55%, #050607 100%);
            }
            .hero-content {
                position: relative;
                z-index: 1;
                width: min(100%, 920px);
                text-align: center;
            }
            .eyebrow {
                color: #67e8f9;
                font-size: 0.72rem;
                font-weight: 900;
                letter-spacing: 0.16em;
                text-transform: uppercase;
            }
            .hero h1 {
                margin: 1.2rem auto 0;
                max-width: 11ch;
                font-size: clamp(3.75rem, 10vw, 8.4rem);
                line-height: 0.86;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
                letter-spacing: 0;
            }
            .hero-copy {
                max-width: 42rem;
                margin: 1.45rem auto 0;
                color: #d8dde0;
                font-size: clamp(1rem, 2vw, 1.18rem);
                line-height: 1.7;
            }
            .hero-actions {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 0.85rem;
                margin-top: 2.2rem;
            }
            .btn-main,
            .btn-ghost {
                min-height: 3.35rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                padding: 0.95rem 1.45rem;
                font-size: 0.8rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                text-decoration: none;
                transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
            }
            .btn-main {
                border: 1px solid rgba(34,197,94,0.45);
                background: #16a34a;
                color: white;
                box-shadow: 0 20px 60px rgba(22,163,74,0.22);
            }
            .btn-ghost {
                border: 1px solid rgba(216,221,224,0.16);
                background: rgba(255,255,255,0.035);
                color: white;
                backdrop-filter: blur(10px);
            }
            .btn-main:hover,
            .btn-ghost:hover { transform: translateY(-2px); }
            .hero-meta {
                width: min(100%, 780px);
                margin: 4.5rem auto 0;
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                border-top: 1px solid rgba(255,255,255,0.12);
                border-bottom: 1px solid rgba(255,255,255,0.12);
            }
            .hero-meta div {
                padding: 1.15rem 1rem;
                border-right: 1px solid rgba(255,255,255,0.12);
            }
            .hero-meta div:last-child { border-right: 0; }
            .hero-meta strong {
                display: block;
                color: white;
                font-size: 1.15rem;
                font-weight: 950;
                font-style: italic;
            }
            .hero-meta span {
                display: block;
                margin-top: 0.25rem;
                color: #828b94;
                font-size: 0.68rem;
                font-weight: 850;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .section {
                width: min(100%, 1120px);
                margin: 0 auto;
                padding: 7rem 1.25rem;
            }
            .section-title {
                display: flex;
                align-items: end;
                justify-content: space-between;
                gap: 2rem;
                margin-bottom: 2.2rem;
            }
            .section-title h2 {
                max-width: 12ch;
                margin: 0.65rem 0 0;
                font-size: clamp(2.3rem, 5vw, 4.8rem);
                line-height: 0.92;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .section-title p {
                max-width: 28rem;
                margin: 0;
                color: #9aa4ad;
                font-size: 0.98rem;
                line-height: 1.75;
            }

            .product-card {
                display: grid;
                grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.78fr);
                gap: 0;
                border: 1px solid rgba(216,221,224,0.12);
                border-radius: 1.15rem;
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.055), rgba(255,255,255,0.01)),
                    #111315;
                box-shadow: 0 30px 90px rgba(0,0,0,0.36);
                overflow: hidden;
                transform-style: preserve-3d;
                transition: transform 0.1s ease-out;
                will-change: transform;
            }
            .product-media {
                min-height: 42rem;
                position: relative;
                overflow: hidden;
                background: #08090a;
            }
            .product-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            .product-info {
                padding: clamp(1.5rem, 4vw, 3.2rem);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 2.5rem;
                border-left: 1px solid rgba(255,255,255,0.08);
            }
            .product-name {
                margin: 0.45rem 0 0;
                color: white;
                font-size: clamp(2.5rem, 5vw, 5.2rem);
                line-height: 0.86;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .price-row {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
                margin-top: 1.6rem;
                padding-top: 1.5rem;
                border-top: 1px solid rgba(255,255,255,0.09);
            }
            .price {
                color: white;
                font-size: 3rem;
                line-height: 1;
                font-weight: 950;
                font-style: italic;
            }
            .product-copy {
                margin-top: 1.6rem;
                color: #d8dde0;
                font-size: 1rem;
                line-height: 1.75;
            }
            .feature-list {
                display: grid;
                gap: 0.85rem;
                margin: 2rem 0 0;
                padding: 0;
                list-style: none;
            }
            .feature-list li {
                display: flex;
                gap: 0.7rem;
                color: #a8b0b7;
                font-size: 0.92rem;
                line-height: 1.55;
            }
            .feature-list li::before {
                content: "✓";
                color: #16a34a;
                font-weight: 950;
            }
            .add-btn {
                width: 100%;
                min-height: 3.75rem;
                border: 0;
                border-radius: 0.9rem;
                background: #16a34a;
                color: white;
                font-size: 0.88rem;
                font-weight: 950;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                cursor: pointer;
                transition: background 0.2s ease, transform 0.2s ease;
            }
            .add-btn:hover { background: #11823a; transform: translateY(-2px); }
            .tech-link {
                min-height: 3.25rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.14);
                border-radius: 0.9rem;
                color: white;
                font-size: 0.76rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-decoration: none;
                transition: border-color 0.2s ease, color 0.2s ease;
            }
            .tech-link:hover {
                border-color: rgba(34,197,94,0.45);
                color: #86efac;
            }

            .visual-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1rem;
            }
            .visual-tile {
                min-height: 28rem;
                border: 1px solid rgba(216,221,224,0.12);
                border-radius: 1.05rem;
                overflow: hidden;
                position: relative;
                background: #111315;
            }
            .visual-tile img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            .visual-caption {
                position: absolute;
                left: 1rem;
                right: 1rem;
                bottom: 1rem;
                border: 1px solid rgba(255,255,255,0.12);
                border-radius: 0.9rem;
                background: rgba(5,6,7,0.74);
                backdrop-filter: blur(16px);
                padding: 1rem;
            }
            .visual-caption strong {
                display: block;
                color: white;
                font-size: 0.95rem;
                font-weight: 950;
                text-transform: uppercase;
            }
            .visual-caption span {
                display: block;
                margin-top: 0.35rem;
                color: #9aa4ad;
                font-size: 0.84rem;
                line-height: 1.5;
            }

            .reviews-block {
                text-align: center;
                max-width: 920px;
                margin: 0 auto;
            }
            .reviews-block h2 {
                margin: 0.65rem 0 0;
                font-size: clamp(2.2rem, 5vw, 4.4rem);
                line-height: 0.94;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            #reviews-grid-home {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1rem;
                margin-top: 2rem;
                text-align: left;
            }
            .review-card {
                min-height: 13rem;
                border: 1px solid rgba(216,221,224,0.12);
                border-radius: 1rem;
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.045), rgba(255,255,255,0.01)),
                    #111315;
                padding: 1.2rem;
            }

            .final-cta {
                border-top: 1px solid rgba(255,255,255,0.1);
                border-bottom: 1px solid rgba(255,255,255,0.1);
                background: rgba(255,255,255,0.025);
            }
            .final-inner {
                width: min(100%, 1120px);
                margin: 0 auto;
                padding: 4.5rem 1.25rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
            }
            .final-inner strong {
                display: block;
                max-width: 13ch;
                font-size: clamp(2.3rem, 5vw, 4.8rem);
                line-height: 0.92;
                font-weight: 950;
                font-style: italic;
                text-transform: uppercase;
            }
            .footer-link {
                color: #828b94;
                font-size: 0.72rem;
                font-weight: 850;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .footer-link:hover { color: white; }

            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(24px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .hero .eyebrow,
            .hero h1,
            .hero-copy,
            .hero-actions,
            .hero-meta {
                opacity: 0;
                animation: fadeUp 0.8s ease-out forwards;
            }
            .hero h1 { animation-delay: 0.12s; }
            .hero-copy { animation-delay: 0.22s; }
            .hero-actions { animation-delay: 0.32s; }
            .hero-meta { animation-delay: 0.42s; }

            #toast {
                position: fixed;
                bottom: 2rem;
                left: 50%;
                transform: translateX(-50%) translateY(80px);
                background: #16a34a;
                color: white;
                font-weight: 900;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.7rem 1.6rem;
                border-radius: 99px;
                z-index: 9999;
                opacity: 0;
                transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
                pointer-events: none;
                white-space: nowrap;
            }
            #toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
            @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

            @media (max-width: 980px) {
                .nav-center .nav-link { display: none; }
                .product-card,
                .visual-grid { grid-template-columns: 1fr; }
                .product-info { border-left: 0; border-top: 1px solid rgba(255,255,255,0.08); }
                .product-media { min-height: 30rem; }
                #reviews-grid-home { grid-template-columns: 1fr; }
            }
            @media (max-width: 680px) {
                .site-nav { padding: 1rem !important; }
                .hero { padding-top: 7rem; }
                .hero h1 { font-size: clamp(3.3rem, 17vw, 5.2rem); }
                .hero-actions,
                .final-inner,
                .section-title {
                    flex-direction: column;
                    align-items: stretch;
                }
                .btn-main,
                .btn-ghost { width: 100%; }
                .hero-meta { grid-template-columns: 1fr; }
                .hero-meta div { border-right: 0; border-bottom: 1px solid rgba(255,255,255,0.12); }
                .hero-meta div:last-child { border-bottom: 0; }
                .section { padding: 5rem 1rem; }
                .price-row { flex-direction: column; align-items: flex-start; }
                .visual-tile { min-height: 22rem; }
                .final-inner { padding: 3.5rem 1rem; }
            }
        </style>
        <ClientRouter/>
    </head>
    <body class="bg-black text-white font-sans">
        <div id="toast" role="status" aria-live="polite"></div>

        <nav class="site-nav fixed w-full z-50 p-5 px-5 md:px-10 flex justify-between items-center">
            <a href="/" class="text-2xl font-black italic tracking-tighter text-white no-underline">
                <span class="text-green-600">CD</span> MOTOR SHOP
            </a>

            <div class="nav-center">
                <a href="#produit-unique" class="nav-link">Produit</a>
                <a href="#details" class="nav-link">Détails</a>
                <a href="#avis" class="nav-link">Avis</a>

                <div class="flex items-center gap-2">
                    <div class="relative">
                        <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown"
                            class="relative p-2 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                            </svg>
                        </button>
                        <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                            class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecté en tant que</p>
                            <p id="account-email" class="text-xs text-white font-black truncate mb-3">—</p>
                            <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                                <a href="/account" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mon compte</a>
                                <a href="/orders" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mes commandes</a>
                            </div>
                            <button id="logout-btn" class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                                Se déconnecter
                            </button>
                        </div>
                    </div>

                    <div class="relative">
                        <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                            <span id="cart-count" aria-live="polite" class="absolute -top-1 -right-1 bg-green-600 text-white text-[10px] font-bold h-5 w-5 flex items-center justify-center rounded-full">0</span>
                        </button>
                        <div id="cart-dropdown" role="dialog" aria-label="Panier" class="cart-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 overflow-hidden">
                            <h4 class="text-sm font-black uppercase mb-4 italic text-green-500">Mon Panier</h4>
                            <div id="cart-items" class="space-y-4 max-h-60 overflow-y-auto" aria-live="polite">
                                <p class="text-gray-500 text-xs italic">Votre panier est vide.</p>
                            </div>
                            <div class="border-t border-white/10 mt-4 pt-4">
                                <div class="flex justify-between font-bold text-sm">
                                    <span>TOTAL :</span>
                                    <span id="cart-total">0.00€</span>
                                </div>
                                <button id="checkout-btn" class="w-full bg-white text-black text-xs font-black py-3 mt-4 rounded-xl hover:bg-green-500 hover:text-white transition uppercase">
                                    Commander
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main>
            <section class="hero">
                <div class="hero-bg">
                    <img src={imageBlackMatte2.src} alt="" role="presentation" />
                </div>
                <div class="hero-content">
                    <span class="eyebrow">Pommeau aluminium premium</span>
                    <h1>Le détail qui change tout.</h1>
                    <p class="hero-copy">
                        Deep Matte transforme l’habitacle avec une pièce sobre, dense et tactile. Un meilleur ressenti, une finition plus nette, sans modifier l’ADN de votre véhicule.
                    </p>
                    <div class="hero-actions">
                        <a href="#produit-unique" class="btn-main">Découvrir Deep Matte</a>
                        <a href="/deepmatte" class="btn-ghost">Fiche technique</a>
                    </div>
                    <div class="hero-meta">
                        <div><strong>29.90€</strong><span>Prix public</span></div>
                        <div><strong>M8 M10 M12</strong><span>Bagues incluses</span></div>
                        <div><strong>5 min</strong><span>Montage estimé</span></div>
                    </div>
                </div>
            </section>

            <section id="produit-unique" class="section">
                <div class="section-title">
                    <div>
                        <span class="eyebrow">Deep Matte</span>
                        <h2>Simple. Précis. Évident.</h2>
                    </div>
                    <p>
                        Une seule pièce, choisie pour son équilibre entre esthétique, poids et sensation en main. L’objectif : améliorer le geste sans rendre l’intérieur bruyant.
                    </p>
                </div>

                <article id="product-card" class="product-card">
                    <div class="product-media">
                        <img src={product.image.src} id="prod-img" alt={`Photo du produit ${product.nom}`} />
                    </div>
                    <div class="product-info">
                        <div>
                            <span class="eyebrow">Édition Premium</span>
                            <h3 class="product-name">{product.nom}</h3>
                            <p class="product-copy">"{product.description}"</p>
                            <ul class="feature-list">
                                <li>Aluminium mat texturé pour une prise plus nette.</li>
                                <li>Bagues M8, M10 et M12 incluses.</li>
                                <li>Livraison gratuite et retour possible sous 30 jours.</li>
                            </ul>
                        </div>

                        <div>
                            <div class="price-row">
                                <div>
                                    <p class="price">{product.prix.toFixed(2)}€</p>
                                    <p class="text-gray-500 text-sm mt-2">Livraison offerte</p>
                                </div>
                                <div aria-label="Note : 4.7 sur 5">
                                    <p class="text-yellow-400 text-xl leading-none">★★★★★</p>
                                    <p class="text-gray-500 text-xs mt-1"><span class="text-white font-black">4.7</span> · 24 avis</p>
                                </div>
                            </div>
                            <div class="grid gap-3 mt-6">
                                <button
                                    data-add-to-cart
                                    data-default-label="Ajouter au panier - 29.90€"
                                    data-added-label="✓ Ajouté au panier"
                                    class="add-btn">
                                    Ajouter au panier - 29.90€
                                </button>
                                <a href={product.link} class="tech-link">Voir tous les détails</a>
                            </div>
                        </div>
                    </div>
                </article>
            </section>

            <section id="details" class="section pt-0">
                <div class="visual-grid">
                    <article class="visual-tile">
