---
import '../styles/global.css';
import imageBlackMatte1 from '../assets/pommeau-deepmatte/image3.png';
import imageBlackMatte2 from '../assets/pommeau-deepmatte/image2.png';
import imageBlackMatte3 from '../assets/pommeau-deepmatte/image4.png';
import { ClientRouter } from 'astro:transitions';

const product = {
    id: 'deep-matte-01',
    nom: 'Deep Matte',
    description: 'Pommeau en aluminium premium, finition noire mate, concu pour donner un geste plus net et une cabine plus precise.',
    prix: 29.90,
    image: imageBlackMatte1,
    link: '/deepmatte',
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <title>CD Motor Shop | Accessoires auto modernes et premium</title>
        <meta name="description" content="CD Motor Shop selectionne des accessoires auto sobres, modernes et precis pour personnaliser l'habitacle sans compromis." />
        <meta property="og:title" content="CD Motor Shop | Accessoires auto modernes et premium" />
        <meta property="og:description" content="Une boutique d'accessoires auto premium. Pieces de cabine, finitions sobres, details utiles et montage simple." />
        <meta property="og:image" content="https://cd-motor-shop.vercel.app/logo.png" />
        <meta property="og:url" content="https://cd-motor-shop.vercel.app" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />

        <style>
            *, *::before, *::after { box-sizing: border-box; }
            html { scroll-behavior: smooth; }

            :root {
                --ink: #050607;
                --carbon: #090b0d;
                --panel: rgba(255, 255, 255, 0.055);
                --panel-strong: rgba(255, 255, 255, 0.095);
                --white: #ffffff;
                --soft: #e8ecef;
                --muted: #9aa4ad;
                --dim: #626c76;
                --line: rgba(255,255,255,0.12);
                --line-soft: rgba(255,255,255,0.07);
                --green: #16a34a;
                --green-dark: #0f7a37;
                --cyan: #67e8f9;
                --amber: #f5c542;
                --red: #ff4d5d;
                --glass: rgba(5, 6, 7, 0.72);
                --ease: cubic-bezier(0.22, 1, 0.36, 1);
                --card-radius: 24px;
            }

            body {
                min-height: 100%;
                margin: 0;
                overflow-x: hidden;
                background:
                    radial-gradient(circle at 78% 9%, rgba(103, 232, 249, 0.13), transparent 23rem),
                    radial-gradient(circle at 12% 28%, rgba(22, 163, 74, 0.14), transparent 22rem),
                    linear-gradient(180deg, #050607 0%, #0a0d0f 42%, #050607 100%);
                color: var(--white);
                font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            }

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                pointer-events: none;
                background-image:
                    linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,0.032) 1px, transparent 1px);
                background-size: 76px 76px;
                mask-image: linear-gradient(to bottom, rgba(0,0,0,0.75), transparent 72%);
            }

            body::after {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -1;
                pointer-events: none;
                background:
                    linear-gradient(110deg, transparent 0 42%, rgba(255,255,255,0.04) 48%, transparent 55%),
                    radial-gradient(circle at 50% 120%, rgba(255,255,255,0.08), transparent 36rem);
                opacity: 0.8;
            }

            a { color: inherit; }
            img { max-width: 100%; }

            .cart-dropdown,
            .account-dropdown {
                display: none;
                pointer-events: none;
            }

            .cart-dropdown { width: min(18rem, calc(100vw - 2rem)); }
            .cart-dropdown.is-open,
            .account-dropdown.is-open {
                display: block;
                pointer-events: auto;
            }

            .site-nav {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 50;
                display: grid;
                grid-template-columns: auto 1fr auto;
                align-items: center;
                gap: 1.5rem;
                padding: 1rem clamp(1rem, 3vw, 2.7rem);
                border-bottom: 1px solid var(--line-soft);
                background: linear-gradient(180deg, rgba(5,6,7,0.86), rgba(5,6,7,0.58));
                backdrop-filter: blur(22px);
            }

            .nav-logo {
                display: inline-flex;
                align-items: center;
                gap: 0.55rem;
                color: var(--white);
                font-size: 0.82rem;
                font-weight: 950;
                font-style: italic;
                letter-spacing: 0.03em;
                line-height: 1;
                text-decoration: none;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .nav-logo span {
                display: inline-grid;
                place-items: center;
                width: 2.25rem;
                height: 2.25rem;
                border: 1px solid rgba(255,255,255,0.16);
                background: linear-gradient(135deg, rgba(103,232,249,0.18), rgba(22,163,74,0.16));
                color: var(--cyan);
            }

            .nav-links {
                justify-self: center;
                display: flex;
                align-items: center;
                gap: clamp(1rem, 3vw, 2.4rem);
            }

            .nav-link {
                color: var(--muted);
                font-size: 0.66rem;
                font-weight: 900;
                letter-spacing: 0.14em;
                text-decoration: none;
                text-transform: uppercase;
                transition: color 220ms var(--ease), transform 220ms var(--ease);
            }

            .nav-link:hover {
                color: var(--white);
                transform: translateY(-1px);
            }

            .nav-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 0.5rem;
            }

            .nav-icon-btn {
                min-width: 2.5rem;
                min-height: 2.5rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(255,255,255,0.08);
                background: rgba(255,255,255,0.035);
                color: var(--soft);
                transition: border-color 220ms var(--ease), background 220ms var(--ease), transform 220ms var(--ease);
            }

            .nav-icon-btn:hover {
                border-color: rgba(103,232,249,0.34);
                background: rgba(103,232,249,0.08);
                transform: translateY(-1px);
            }

            .site-nav #cart-toggle {
                color: var(--white);
                border: 0;
                background: transparent;
                border-radius: 0;
                min-width: auto;
                min-height: auto;
                box-shadow: none;
                transform: none;
            }

            .site-nav #cart-toggle:hover {
                color: #22c55e;
                border: 0;
                background: transparent;
                box-shadow: none;
                transform: none;
            }

            .site-nav #cart-dropdown {
                width: min(18rem, calc(100vw - 2rem));
            }

            .hero {
                position: relative;
                min-height: 100svh;
                padding: clamp(6rem, 10vw, 8.5rem) clamp(1rem, 4vw, 3rem) 0;
                overflow: hidden;
            }

            .hero-shell {
                min-height: calc(100svh - 7rem);
                display: grid;
                grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
                align-items: end;
                gap: clamp(2rem, 5vw, 5rem);
                max-width: 1440px;
                margin: 0 auto;
            }

            .hero-copy-block {
                position: relative;
                z-index: 2;
                padding-bottom: clamp(3rem, 7vw, 5.5rem);
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 0.75rem;
                color: var(--cyan);
                font-size: 0.64rem;
                font-weight: 950;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .eyebrow::before {
                content: "";
                width: 2.3rem;
                height: 1px;
                background: currentColor;
                opacity: 0.75;
            }

            .hero-title {
                margin-top: 1.25rem;
                max-width: 11ch;
                color: var(--white);
                font-size: clamp(4.35rem, 10vw, 10.75rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.78;
                text-transform: uppercase;
                text-wrap: balance;
            }

            .hero-title span {
                display: block;
                color: transparent;
                -webkit-text-stroke: 1px rgba(255,255,255,0.58);
            }

            .hero-lead {
                max-width: 38rem;
                margin-top: 1.65rem;
                color: #c5ccd2;
                font-size: clamp(1rem, 1.25vw, 1.18rem);
                line-height: 1.8;
            }

            .hero-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 0.8rem;
                margin-top: 2.3rem;
            }

            .btn-main,
            .btn-ghost,
            .btn-dark {
                position: relative;
                isolation: isolate;
                min-height: 3.2rem;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.65rem;
                padding: 0 1.35rem;
                overflow: hidden;
                border: 1px solid transparent;
                border-radius: 6px;
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.12em;
                text-decoration: none;
                text-transform: uppercase;
                cursor: pointer;
                transition: transform 240ms var(--ease), border-color 240ms var(--ease), background 240ms var(--ease), color 240ms var(--ease), box-shadow 240ms var(--ease);
            }

            .btn-main {
                background: linear-gradient(135deg, var(--green), #0f766e);
                color: var(--white);
                box-shadow: 0 18px 54px rgba(22,163,74,0.25);
            }

            .btn-main::after {
                content: "";
                position: absolute;
                inset: 0;
                z-index: -1;
                background: linear-gradient(110deg, transparent 0 34%, rgba(255,255,255,0.36) 48%, transparent 62%);
                transform: translateX(-120%);
                transition: transform 650ms var(--ease);
            }

            .btn-main:hover::after { transform: translateX(120%); }
            .btn-main:hover { transform: translateY(-2px); box-shadow: 0 22px 70px rgba(22,163,74,0.34); }

            .btn-ghost {
                border-color: rgba(255,255,255,0.14);
                background: rgba(255,255,255,0.04);
                color: var(--white);
            }

            .btn-dark {
                border-color: rgba(255,255,255,0.12);
                background: rgba(5,6,7,0.7);
                color: var(--white);
            }

            .btn-ghost:hover,
            .btn-dark:hover {
                border-color: rgba(103,232,249,0.42);
                background: rgba(103,232,249,0.08);
                transform: translateY(-2px);
            }

            .hero-stage {
                position: relative;
                min-height: min(72svh, 48rem);
                display: grid;
                place-items: center;
                perspective: 1400px;
            }

            .hero-orbit {
                position: absolute;
                inset: 5% 2% 3%;
                border: 1px solid rgba(255,255,255,0.09);
                transform: rotate(-9deg) skewX(-8deg);
                opacity: 0.75;
            }

            .hero-orbit::before,
            .hero-orbit::after {
                content: "";
                position: absolute;
                inset: 10%;
                border: 1px solid rgba(103,232,249,0.13);
            }

            .hero-product {
                position: relative;
                z-index: 2;
                width: min(44vw, 38rem);
                min-width: 19rem;
                aspect-ratio: 0.86;
                transform: rotate(-5deg);
                animation: productFloat 6.5s ease-in-out infinite;
            }

            .hero-product::before {
                content: "";
                position: absolute;
                inset: 15% 4% 3%;
                z-index: -1;
                background: linear-gradient(135deg, rgba(103,232,249,0.18), rgba(22,163,74,0.13));
                filter: blur(40px);
                transform: rotate(14deg);
            }

            .hero-product img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border: 1px solid rgba(255,255,255,0.12);
                box-shadow: 0 38px 110px rgba(0,0,0,0.58);
                clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
            }

            .floating-panel {
                position: absolute;
                z-index: 3;
                width: min(16rem, 36vw);
                padding: 1rem;
                border: 1px solid rgba(255,255,255,0.13);
                border-radius: var(--card-radius);
                background: rgba(5, 6, 7, 0.66);
                backdrop-filter: blur(18px);
                box-shadow: 0 18px 70px rgba(0,0,0,0.36);
            }

            .floating-panel strong {
                display: block;
                color: var(--white);
                font-size: 0.76rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

            .floating-panel span {
                display: block;
                margin-top: 0.35rem;
                color: var(--muted);
                font-size: 0.74rem;
                line-height: 1.55;
            }

            .panel-one { top: 14%; left: 0; }
            .panel-two { right: 0; bottom: 18%; }

            .hero-ticker {
                position: relative;
                z-index: 4;
                display: flex;
                gap: 2.4rem;
                width: calc(100% + 6rem);
                margin-left: -3rem;
                padding: 1.05rem 0;
                overflow: hidden;
                border-top: 1px solid var(--line-soft);
                border-bottom: 1px solid var(--line-soft);
                background: rgba(255,255,255,0.035);
                color: rgba(255,255,255,0.62);
                font-size: 0.64rem;
                font-weight: 950;
                letter-spacing: 0.2em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .hero-ticker-track {
                display: flex;
                gap: 2.4rem;
                min-width: max-content;
                animation: ticker 24s linear infinite;
            }

            .section {
                max-width: 1240px;
                margin: 0 auto;
                padding: clamp(5rem, 8vw, 8.5rem) clamp(1rem, 4vw, 2.5rem);
            }

            .section-head {
                display: grid;
                grid-template-columns: minmax(0, 0.82fr) minmax(18rem, 0.42fr);
                align-items: end;
                gap: 2rem;
                margin-bottom: clamp(2rem, 4vw, 3.6rem);
            }

            .section-title {
                margin-top: 0.95rem;
                color: var(--white);
                font-size: clamp(2.55rem, 5vw, 5.9rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.86;
                text-transform: uppercase;
                text-wrap: balance;
            }

            .section-copy {
                color: var(--muted);
                font-size: 0.96rem;
                line-height: 1.8;
            }

            .world-grid {
                display: grid;
                grid-template-columns: 1.1fr 0.9fr 0.9fr;
                gap: 1rem;
            }

            .world-card {
                position: relative;
                min-height: 21rem;
                padding: clamp(1.35rem, 3vw, 2rem);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: hidden;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.08), transparent 38%),
                    rgba(8, 10, 12, 0.95);
                transition: transform 320ms var(--ease), background 320ms var(--ease);
            }

            .world-card::before {
                content: "";
                position: absolute;
                inset: auto -15% -34% -15%;
                height: 60%;
                background: radial-gradient(circle, rgba(103,232,249,0.16), transparent 66%);
                opacity: 0;
                transition: opacity 320ms var(--ease), transform 320ms var(--ease);
            }

            .world-card:hover::before {
                opacity: 1;
                transform: translateY(-10%);
            }

            .world-card:hover { transform: translateY(-4px); }
            .world-card.featured { grid-row: span 2; min-height: 42rem; }

            .world-card img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                opacity: 0.38;
                filter: grayscale(0.35) contrast(1.08);
                transition: transform 650ms var(--ease), opacity 320ms var(--ease);
            }

            .world-card:hover img {
                opacity: 0.48;
                transform: scale(1.04);
            }

            .world-card-content {
                position: relative;
                z-index: 1;
            }

            .world-number {
                color: rgba(255,255,255,0.38);
                font-size: 0.65rem;
                font-weight: 950;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .world-card h3 {
                max-width: 9ch;
                margin-top: 0.9rem;
                color: var(--white);
                font-size: clamp(1.75rem, 3vw, 3.8rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.9;
                text-transform: uppercase;
            }

            .world-card p {
                position: relative;
                z-index: 1;
                max-width: 23rem;
                color: #c0c8ce;
                font-size: 0.88rem;
                line-height: 1.75;
            }

            .signal-row {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 1rem;
                margin-top: 1rem;
            }

            .signal {
                padding: 1.4rem;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background: rgba(8, 10, 12, 0.92);
            }

            .signal strong {
                display: block;
                color: var(--white);
                font-size: clamp(1.6rem, 2.8vw, 2.8rem);
                font-style: italic;
                font-weight: 950;
                line-height: 1;
            }

            .signal span {
                display: block;
                margin-top: 0.45rem;
                color: var(--dim);
                font-size: 0.58rem;
                font-weight: 900;
                letter-spacing: 0.13em;
                text-transform: uppercase;
            }

            .product-section {
                position: relative;
                max-width: 1340px;
                margin: 0 auto;
                padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 2.5rem);
            }

            .product-shell {
                display: grid;
                grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.72fr);
                min-height: 42rem;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background: rgba(255,255,255,0.035);
                overflow: hidden;
            }

            .product-visual {
                position: relative;
                min-height: 42rem;
                display: grid;
                place-items: center;
                overflow: hidden;
                background:
                    radial-gradient(circle at 50% 40%, rgba(103,232,249,0.14), transparent 20rem),
                    linear-gradient(135deg, rgba(255,255,255,0.08), transparent 48%),
                    #07090a;
            }

            .product-visual::before {
                content: "";
                position: absolute;
                width: 70%;
                aspect-ratio: 1;
                border: 1px solid rgba(255,255,255,0.1);
                transform: rotate(45deg);
            }

            .product-visual::after {
                content: "Disponible maintenant";
                position: absolute;
                top: 1.4rem;
                left: 1.4rem;
                color: rgba(255,255,255,0.42);
                font-size: 0.64rem;
                font-weight: 950;
                letter-spacing: 0.15em;
                text-transform: uppercase;
            }

            .product-visual img {
                position: relative;
                z-index: 1;
                width: min(72%, 32rem);
                aspect-ratio: 0.82;
                object-fit: cover;
                border: 1px solid rgba(255,255,255,0.12);
                transform: rotate(-7deg);
                box-shadow: 0 36px 110px rgba(0,0,0,0.58);
                transition: transform 650ms var(--ease), filter 650ms var(--ease);
            }

            .product-shell:hover .product-visual img {
                transform: rotate(-4deg) scale(1.025);
                filter: contrast(1.06);
            }

            .product-info {
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                gap: 2.5rem;
                padding: clamp(1.6rem, 4vw, 3.25rem);
                border-left: 1px solid var(--line-soft);
                background:
                    linear-gradient(180deg, rgba(255,255,255,0.055), transparent 42%),
                    rgba(5, 6, 7, 0.84);
            }

            .product-kicker {
                color: var(--green);
                font-size: 0.64rem;
                font-weight: 950;
                letter-spacing: 0.18em;
                text-transform: uppercase;
            }

            .product-name {
                margin-top: 1rem;
                color: var(--white);
                font-size: clamp(3.1rem, 6vw, 6.2rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.8;
                text-transform: uppercase;
            }

            .product-copy {
                margin-top: 1.35rem;
                color: #c3cbd1;
                font-size: 1rem;
                line-height: 1.8;
            }

            .feature-list {
                display: grid;
                gap: 0.8rem;
                margin-top: 2rem;
                list-style: none;
            }

            .feature-list li {
                display: grid;
                grid-template-columns: auto 1fr;
                gap: 0.65rem;
                color: var(--muted);
                font-size: 0.86rem;
                line-height: 1.55;
            }

            .feature-list li::before {
                content: "";
                width: 0.55rem;
                height: 0.55rem;
                margin-top: 0.48rem;
                background: var(--cyan);
                box-shadow: 0 0 18px rgba(103,232,249,0.55);
            }

            .price-block {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 1rem;
                padding-top: 1.6rem;
                border-top: 1px solid var(--line-soft);
            }

            .price {
                color: var(--white);
                font-size: clamp(2.5rem, 4vw, 4rem);
                font-style: italic;
                font-weight: 950;
                line-height: 1;
            }

            .price-note,
            .rating-count {
                color: var(--dim);
                font-size: 0.62rem;
                font-weight: 900;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            .rating-block { text-align: right; }
            .rating-stars { color: var(--amber); font-size: 0.9rem; letter-spacing: 0.05em; }

            .add-btn {
                width: 100%;
                min-height: 3.45rem;
                margin-top: 1.15rem;
                border: 0;
                border-radius: 6px;
                background: linear-gradient(135deg, var(--green), #0f766e);
                color: var(--white);
                cursor: pointer;
                font-size: 0.72rem;
                font-weight: 950;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                transition: transform 240ms var(--ease), box-shadow 240ms var(--ease), background 240ms var(--ease);
            }

            .add-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 18px 54px rgba(22,163,74,0.28);
            }

            .product-links {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 0.75rem;
                margin-top: 0.75rem;
            }

            .product-links .btn-dark {
                width: 100%;
                min-height: 3rem;
                padding: 0 0.9rem;
            }

            .catalog-strip {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1rem;
                margin-top: 1rem;
            }

            .catalog-item {
                padding: 1.35rem;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background: rgba(8,10,12,0.92);
            }

            .catalog-item span {
                color: var(--dim);
                font-size: 0.58rem;
                font-weight: 950;
                letter-spacing: 0.14em;
                text-transform: uppercase;
            }

            .catalog-item strong {
                display: block;
                margin-top: 0.45rem;
                color: var(--white);
                font-size: 1rem;
                font-weight: 950;
                text-transform: uppercase;
            }

            .reviews-section {
                max-width: 1240px;
                margin: 0 auto;
                padding: clamp(4rem, 8vw, 8rem) clamp(1rem, 4vw, 2.5rem);
            }

            .reviews-header {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: end;
                gap: 2rem;
                margin-bottom: 2.5rem;
            }

            .reviews-header h2 {
                margin-top: 0.9rem;
                color: var(--white);
                font-size: clamp(2.4rem, 5vw, 5rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.88;
                text-transform: uppercase;
            }

            .reviews-avg {
                min-width: 9rem;
                text-align: right;
            }

            .avg-num {
                display: block;
                color: var(--white);
                font-size: 3.2rem;
                font-style: italic;
                font-weight: 950;
                line-height: 1;
            }

            .avg-stars { color: var(--amber); font-size: 0.86rem; margin-top: 0.25rem; }
            .avg-count { color: var(--dim); font-size: 0.6rem; font-weight: 900; letter-spacing: 0.12em; margin-top: 0.35rem; text-transform: uppercase; }

            #reviews-grid-home,
            #reviews-skeleton-home {
                grid-template-columns: repeat(3, 1fr);
                gap: 1rem;
            }

            .review-card {
                min-height: 15rem;
                padding: 1.5rem;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background:
                    linear-gradient(145deg, rgba(255,255,255,0.06), transparent 38%),
                    rgba(8,10,12,0.94);
            }

            #reviews-skeleton-home > div {
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                overflow: hidden;
            }

            .final-cta {
                padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(4rem, 7vw, 7rem);
            }

            .final-inner {
                position: relative;
                max-width: 1240px;
                min-height: 23rem;
                margin: 0 auto;
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: end;
                gap: 2rem;
                padding: clamp(1.6rem, 5vw, 3rem);
                overflow: hidden;
                border: 1px solid var(--line-soft);
                border-radius: var(--card-radius);
                background:
                    linear-gradient(135deg, rgba(103,232,249,0.13), transparent 38%),
                    linear-gradient(315deg, rgba(22,163,74,0.16), transparent 42%),
                    #07090a;
            }

            .final-inner::before {
                content: "CD MOTOR SHOP";
                position: absolute;
                left: -0.25rem;
                top: 0.4rem;
                color: rgba(255,255,255,0.035);
                font-size: clamp(5rem, 14vw, 14rem);
                font-style: italic;
                font-weight: 950;
                line-height: 0.8;
                white-space: nowrap;
            }

            .final-inner strong,
            .final-actions {
                position: relative;
                z-index: 1;
            }

            .final-inner strong {
                max-width: 12ch;
                color: var(--white);
                font-size: clamp(2.8rem, 6vw, 6.4rem);
                font-style: italic;
                font-weight: 950;
                letter-spacing: 0;
                line-height: 0.82;
                text-transform: uppercase;
            }

            .final-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                justify-content: flex-end;
            }

            .site-footer {
                max-width: 1240px;
                margin: 0 auto;
                padding: 2.6rem clamp(1rem, 4vw, 2.5rem);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1.5rem;
                flex-wrap: wrap;
                border-top: 1px solid var(--line-soft);
            }

            .footer-brand {
                color: var(--white);
                font-size: 0.82rem;
                font-style: italic;
                font-weight: 950;
                text-transform: uppercase;
            }

            .footer-brand span { color: var(--green); }

            .footer-links {
                display: flex;
                flex-wrap: wrap;
                gap: 1.2rem;
            }

            .footer-link {
                color: var(--dim);
                font-size: 0.6rem;
                font-weight: 900;
                letter-spacing: 0.11em;
                text-decoration: none;
                text-transform: uppercase;
                transition: color 220ms var(--ease);
            }

            .footer-link:hover { color: var(--white); }

            .footer-copy {
                width: 100%;
                color: var(--dim);
                font-size: 0.58rem;
                font-weight: 800;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            #toast {
                position: fixed;
                left: 50%;
                bottom: 2rem;
                z-index: 9999;
                padding: 0.75rem 1.25rem;
                border: 1px solid rgba(255,255,255,0.16);
                border-radius: 6px;
                background: rgba(22,163,74,0.94);
                color: var(--white);
                font-size: 0.68rem;
                font-weight: 950;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                transform: translateX(-50%) translateY(90px);
                opacity: 0;
                pointer-events: none;
                transition: transform 420ms var(--ease), opacity 260ms ease;
                white-space: nowrap;
            }

            #toast.show {
                transform: translateX(-50%) translateY(0);
                opacity: 1;
            }

            .hero-copy-block > *,
            .hero-stage > * {
                opacity: 0;
                transform: translateY(22px);
                animation: introUp 760ms var(--ease) forwards;
            }

            .hero-copy-block > :nth-child(2) { animation-delay: 90ms; }
            .hero-copy-block > :nth-child(3) { animation-delay: 170ms; }
            .hero-copy-block > :nth-child(4) { animation-delay: 250ms; }
            .hero-stage > :nth-child(1) { animation-delay: 160ms; }
            .hero-stage > :nth-child(2) { animation-delay: 230ms; }
            .hero-stage > :nth-child(3) { animation-delay: 320ms; }
            .hero-stage > :nth-child(4) { animation-delay: 400ms; }

            @keyframes introUp {
                to { opacity: 1; transform: translateY(0); }
            }

            @keyframes productFloat {
                0%, 100% { transform: translateY(0) rotate(-5deg); }
                50% { transform: translateY(-16px) rotate(-3deg); }
            }

            @keyframes ticker {
                from { transform: translateX(0); }
                to { transform: translateX(calc(-50% - 1.2rem)); }
            }

            @keyframes shimmer {
                0% { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }

            @media (max-width: 980px) {
                .site-nav { grid-template-columns: auto auto; }
                .nav-links { display: none; }
                .nav-actions { justify-self: end; }

                .hero { padding-top: 5.5rem; }
                .hero-shell {
                    min-height: auto;
                    grid-template-columns: 1fr;
                    align-items: start;
                    gap: 1.5rem;
                }

                .hero-copy-block { padding-bottom: 0; }
                .hero-title { font-size: clamp(3.7rem, 17vw, 7rem); }
                .hero-stage { min-height: 31rem; }
                .hero-product { width: min(72vw, 29rem); }
                .floating-panel { width: min(14rem, 42vw); }
                .panel-one { top: 4%; }
                .panel-two { bottom: 7%; }

                .section-head,
                .product-shell,
                .reviews-header,
                .final-inner {
                    grid-template-columns: 1fr;
                }

                .section-copy,
                .reviews-avg {
                    text-align: left;
                }

                .world-grid {
                    grid-template-columns: 1fr 1fr;
                }

                .world-card.featured {
                    grid-column: 1 / -1;
                    grid-row: auto;
                    min-height: 28rem;
                }

                .signal-row,
                .catalog-strip,
                #reviews-grid-home,
                #reviews-skeleton-home {
                    grid-template-columns: 1fr 1fr;
                }

                .product-info {
                    border-left: 0;
                    border-top: 1px solid var(--line-soft);
                }

                .product-visual,
                .product-shell {
                    min-height: auto;
                }

                .product-visual {
                    aspect-ratio: 1 / 0.9;
                }

                .final-actions { justify-content: flex-start; }
            }

            @media (max-width: 640px) {
                .site-nav { padding: 0.8rem 0.85rem; }
                .nav-logo { font-size: 0.72rem; }
                .nav-logo span { width: 2rem; height: 2rem; }

                .hero { padding-left: 0.85rem; padding-right: 0.85rem; }
                .hero-lead { font-size: 0.96rem; }
                .hero-actions,
                .final-actions,
                .product-links {
                    display: grid;
                    grid-template-columns: 1fr;
                    width: 100%;
                }

                .btn-main,
                .btn-ghost,
                .btn-dark {
                    width: 100%;
                }

                .hero-stage { min-height: 27rem; }
                .hero-product { width: min(84vw, 24rem); min-width: 0; }
                .hero-orbit { inset: 8% 2% 7%; }
                .floating-panel {
                    position: relative;
                    inset: auto;
                    width: 100%;
                    margin-top: 0.65rem;
                }
                .panel-one,
                .panel-two {
                    grid-column: 1;
                }

                .hero-stage {
                    display: grid;
                    grid-template-columns: 1fr;
                    align-items: center;
                }

                .hero-ticker {
                    width: calc(100% + 1.7rem);
                    margin-left: -0.85rem;
                }

                .world-grid,
                .signal-row,
                .catalog-strip,
                #reviews-grid-home,
                #reviews-skeleton-home {
                    grid-template-columns: 1fr;
                }

                .world-card,
                .world-card.featured {
                    min-height: 22rem;
                }

                .product-visual { aspect-ratio: 1; }
                .product-visual img { width: 78%; }

                .price-block {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .rating-block { text-align: left; }

                .final-inner { min-height: 20rem; }
                .site-footer { align-items: flex-start; flex-direction: column; }
            }

            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    scroll-behavior: auto !important;
                    transition-duration: 0.01ms !important;
                }
            }
        </style>
        <ClientRouter />
    </head>

    <body class="bg-black text-white font-sans">
        <div id="toast" role="status" aria-live="polite"></div>

        <nav class="site-nav" aria-label="Navigation principale">
            <a href="/" class="nav-logo"><span>CD</span> Motor Shop</a>

            <div class="nav-links">
                <a href="#univers" class="nav-link">Univers</a>
                <a href="#selection" class="nav-link">Selection</a>
                <a href="#avis" class="nav-link">Avis</a>
                <a href="/contact" class="nav-link">Contact</a>
            </div>

            <div class="nav-actions">
                <div class="relative">
                    <button id="account-btn" aria-label="Mon compte" aria-expanded="false" aria-controls="account-dropdown" class="nav-icon-btn relative">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zM19 20a7 7 0 10-14 0"/>
                        </svg>
                    </button>
                    <div id="account-dropdown" role="dialog" aria-label="Mon compte"
                        class="account-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 w-56 overflow-hidden">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-gray-500 mb-1">Connecte en tant que</p>
                        <p id="account-email" class="text-xs text-white font-black truncate mb-3">-</p>
                        <div class="flex flex-col gap-1 mb-3 border-b border-white/10 pb-3">
                            <a href="/account" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mon compte</a>
                            <a href="/orders" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white hover:bg-white/5 font-bold px-2 py-2 rounded-lg transition uppercase tracking-widest">Mes commandes</a>
                        </div>
                        <button id="logout-btn" class="w-full bg-zinc-800 hover:bg-red-900/40 border border-white/10 hover:border-red-500/30 text-red-400 hover:text-red-300 text-xs font-black py-2.5 rounded-xl transition uppercase tracking-widest">
                            Se deconnecter
                        </button>
                    </div>
                </div>

                <div class="relative">
                    <button id="cart-toggle" aria-label="Ouvrir le panier" aria-expanded="false" aria-controls="cart-dropdown" class="relative p-2 hover:text-green-500 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span id="cart-count" aria-live="polite" class="absolute -top-1 -right-1 bg-green-600 text-white text-[10px] font-bold h-5 w-5 flex items-center justify-center rounded-full">0</span>
                    </button>
                    <div id="cart-dropdown" role="dialog" aria-label="Panier" class="cart-dropdown absolute right-0 mt-2 bg-zinc-900 border border-white/10 rounded-2xl shadow-2xl p-4 overflow-hidden">
                        <h4 class="text-sm font-black uppercase mb-4 italic text-green-500">Mon Panier</h4>
                        <div id="cart-items" class="space-y-4 max-h-60 overflow-y-auto" aria-live="polite">
                            <p class="text-gray-500 text-xs italic">Votre panier est vide.</p>
                        </div>
                        <div class="border-t border-white/10 mt-4 pt-4">
                            <div class="flex justify-between font-bold text-sm">
                                <span>TOTAL :</span>
                                <span id="cart-total">0.00€</span>
                            </div>
                            <button id="checkout-btn" class="w-full bg-white text-black text-xs font-black py-3 mt-4 rounded-xl hover:bg-green-500 hover:text-white transition uppercase">
                                Commander
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main>
            <section class="hero">
                <div class="hero-shell">
                    <div class="hero-copy-block">
                        <span class="eyebrow">Accessoires auto nouvelle vague</span>
                        <h1 class="hero-title">Upgrade <span>your drive</span></h1>
                        <p class="hero-lead">
                            CD Motor Shop construit une selection d'accessoires automobiles sobres, utiles et visuellement forts. Des pieces qui modernisent l'habitacle sans transformer votre voiture en catalogue tuning.
                        </p>
                        <div class="hero-actions">
                            <a href="#univers" class="btn-main">Explorer la boutique</a>
                            <a href="#selection" class="btn-ghost">Voir la selection</a>
                        </div>
                    </div>

                    <div class="hero-stage" aria-hidden="true">
                        <div class="hero-orbit"></div>
                        <div class="hero-product">
                            <img src={imageBlackMatte2.src} alt="" />
                        </div>
                        <div class="floating-panel panel-one">
                            <strong>Cabine plus nette</strong>
                            <span>Des details qui changent le toucher, le regard et le plaisir au quotidien.</span>
                        </div>
                        <div class="floating-panel panel-two">
                            <strong>Selection evolutive</strong>
                            <span>Un premier produit maintenant, une gamme complete en construction.</span>
                        </div>
                    </div>
                </div>

                <div class="hero-ticker" aria-hidden="true">
                    <div class="hero-ticker-track">
                        <span>Habitacle</span><span>Finition mate</span><span>Montage simple</span><span>Design premium</span><span>Grip</span><span>Detail utile</span>
                        <span>Habitacle</span><span>Finition mate</span><span>Montage simple</span><span>Design premium</span><span>Grip</span><span>Detail utile</span>
                    </div>
                </div>
            </section>

            <section id="univers" class="section">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">La boutique qui arrive</span>
                        <h2 class="section-title">Des pieces pour une voiture plus sharp.</h2>
                    </div>
                    <p class="section-copy">
                        L'idee est simple : proposer des accessoires qui ont une vraie presence, une vraie utilite, et une qualite ressentie immediatement. On commence petit, mais l'univers est deja la.
                    </p>
                </div>

                <div class="world-grid">
                    <article class="world-card featured">
                        <img src={imageBlackMatte3.src} alt="" />
                        <div class="world-card-content">
                            <span class="world-number">01 / Interior</span>
                            <h3>Poste de conduite</h3>
                        </div>
                        <p>Pommeaux, touches tactiles, inserts et pieces visibles pour rendre chaque geste plus agreable.</p>
                    </article>
                    <article class="world-card">
                        <div class="world-card-content">
                            <span class="world-number">02 / Care</span>
                            <h3>Detailing</h3>
                        </div>
                        <p>Des essentiels propres pour garder l'interieur net, sans surcharge ni gadget inutile.</p>
                    </article>
                    <article class="world-card">
                        <div class="world-card-content">
                            <span class="world-number">03 / Utility</span>
                            <h3>Usage quotidien</h3>
                        </div>
                        <p>Rangement, maintien, confort et petits upgrades qui simplifient la vie a bord.</p>
                    </article>
                    <article class="world-card">
                        <div class="world-card-content">
                            <span class="world-number">04 / Finish</span>
                            <h3>Look sobre</h3>
                        </div>
                        <p>Une direction visuelle sombre, moderne, precise. Pas de bruit, juste de la tension.</p>
                    </article>
                    <article class="world-card">
                        <div class="world-card-content">
                            <span class="world-number">05 / Drop</span>
                            <h3>Prochains drops</h3>
                        </div>
                        <p>La gamme va s'etendre progressivement autour d'accessoires compatibles et coherents.</p>
                    </article>
                </div>

                <div class="signal-row">
                    <div class="signal"><strong>01</strong><span>Produit disponible</span></div>
                    <div class="signal"><strong>3</strong><span>Axes de gamme</span></div>
                    <div class="signal"><strong>5 min</strong><span>Montage vise</span></div>
                    <div class="signal"><strong>0€</strong><span>Livraison offerte</span></div>
                </div>
            </section>

            <section id="selection" class="product-section">
                <div class="section-head">
                    <div>
                        <span class="eyebrow">Selection actuelle</span>
                        <h2 class="section-title">Premier drop, pas dernier chapitre.</h2>
                    </div>
                    <p class="section-copy">
                        La home presente une boutique en expansion. Le produit disponible aujourd'hui sert de premiere piece : solide, sobre, facile a installer, et pense pour annoncer la suite.
                    </p>
                </div>

                <article id="product-card" class="product-shell">
                    <div class="product-visual">
                        <img src={product.image.src} id="prod-img" alt={`Photo du produit ${product.nom}`} />
                    </div>
                    <div class="product-info">
                        <div>
                            <span class="product-kicker">Drop 001 / Aluminium mat</span>
                            <h3 class="product-name">{product.nom}</h3>
                            <p class="product-copy">{product.description}</p>
                            <ul class="feature-list">
                                <li>Aluminium noir mat avec toucher dense et finition minimaliste.</li>
                                <li>Bagues M8, M10 et M12 incluses pour une compatibilite large.</li>
                                <li>Un accessoire visible, mais assez sobre pour rester coherent avec l'origine.</li>
                            </ul>
                        </div>

                        <div>
                            <div class="price-block">
                                <div>
                                    <p class="price">{product.prix.toFixed(2)}€</p>
                                    <p class="price-note">Livraison offerte</p>
                                </div>
                                <div class="rating-block" aria-label="Note : 4.7 sur 5">
                                    <div class="rating-stars">★★★★★</div>
                                    <div class="rating-count"><span style="color:white;font-weight:900;">4.7</span> · 24 avis</div>
                                </div>
                            </div>
                            <button
                                data-add-to-cart
                                data-default-label="Ajouter au panier - 29.90€"
                                data-added-label="Ajoute"
                                class="add-btn">
                                Ajouter au panier - 29.90€
                            </button>
                            <div class="product-links">
                                <a href={product.link} class="btn-dark">Details</a>
                                <a href="/contact" class="btn-dark">Compatibilite</a>
                            </div>
                        </div>
                    </div>
                </article>

                <div class="catalog-strip" aria-label="Futures categories">
                    <div class="catalog-item"><span>Disponible</span><strong>Pommeaux</strong></div>
                    <div class="catalog-item"><span>Bientot</span><strong>Organisation</strong></div>
                    <div class="catalog-item"><span>Bientot</span><strong>Finitions cabine</strong></div>
                </div>
            </section>

            <section id="avis" class="reviews-section">
                <div class="reviews-header">
                    <div>
                        <span class="eyebrow">Premiers retours</span>
                        <h2>Ce que la piece change en vrai.</h2>
                    </div>
                    <div class="reviews-avg">
                        <span class="avg-num" id="home-avg">-</span>
                        <div class="avg-stars" id="home-stars">★★★★★</div>
                        <div class="avg-count" id="home-count"></div>
                    </div>
                </div>

                <div id="reviews-skeleton-home">
                    <div style="height:210px;background:linear-gradient(90deg,#111315 25%,#1a1c1e 50%,#111315 75%);background-size:200% 100%;animation:shimmer 1.4s infinite;"></div>
                    <div style="height:210px;background:linear-gradient(90deg,#111315 25%,#1a1c1e 50%,#111315 75%);background-size:200% 100%;animation:shimmer 1.4s infinite;animation-delay:0.1s;"></div>
                    <div style="height:210px;background:linear-gradient(90deg,#111315 25%,#1a1c1e 50%,#111315 75%);background-size:200% 100%;animation:shimmer 1.4s infinite;animation-delay:0.2s;"></div>
                </div>
                <div id="reviews-grid-home" style="display:none;"></div>
            </section>

            <section class="final-cta">
                <div class="final-inner">
                    <strong>La suite commence dans l'habitacle.</strong>
                    <div class="final-actions">
                        <a href="#selection" class="btn-main">Voir le drop actuel</a>
                        <a href="/contact" class="btn-ghost">Demander un conseil</a>
                    </div>
                </div>
            </section>
        </main>

        <footer>
            <div class="site-footer">
                <div class="footer-brand"><span>CD</span> Motor Shop</div>
                <div class="footer-links">
                    <a href="/mentions-legales" class="footer-link">Mentions legales</a>
                    <a href="/cgv" class="footer-link">CGV</a>
                    <a href="/politique-confidentialite" class="footer-link">Confidentialite</a>
                    <a href="/contact" class="footer-link">Contact</a>
                </div>
                <p class="footer-copy">© 2026 CD Motor Shop. Tous droits reserves.</p>
            </div>
        </footer>

        <script>
            document.addEventListener('astro:page-load', () => {
                const card = document.getElementById('product-card');
                if (!card || !window.matchMedia('(hover: hover)').matches) return;
                const INTENSITY = 2.2;
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    card.style.transform = `perspective(1400px) rotateX(${(-y * INTENSITY).toFixed(2)}deg) rotateY(${(x * INTENSITY).toFixed(2)}deg)`;
                });
                card.addEventListener('mouseleave', () => {
                    card.style.transition = 'transform 0.5s ease-out';
                    card.style.transform = 'perspective(1400px) rotateX(0deg) rotateY(0deg)';
                    setTimeout(() => { card.style.transition = 'transform 0.1s ease-out'; }, 500);
                });
            });
        </script>

        <script>
            import { initAuthNav } from '../scripts/auth-nav.js';
            document.addEventListener('astro:page-load', () => initAuthNav());
        </script>

        <script>
            import { initCart } from '../scripts/cart.js';
            document.addEventListener('astro:page-load', () => {
                initCart({ id: 'deep-matte-01', nom: 'Deep Matte', prix: 29.90 });
            });
        </script>

        <script>
            import { supabase } from '../lib/supabase.js';

            document.addEventListener('astro:page-load', async () => {
                const COLORS = ['#16a34a','#2563eb','#9333ea','#ea580c','#db2777','#0891b2'];
                const avatarColor = (s) => COLORS[(s?.charCodeAt(0) ?? 0) % COLORS.length];
                const starsHtml = (n) => Array.from({length:5}, (_,i) =>
                    `<span style="color:${i < n ? '#facc15' : '#27272a'}">★</span>`
                ).join('');
                const fmtRelative = (iso) => {
                    const diff = Date.now() - new Date(iso).getTime();
                    const days = Math.max(0, Math.floor(diff / 86400000));
                    if (days < 7) return `Il y a ${days} jour${days > 1 ? 's' : ''}`;
                    if (days < 30) return `Il y a ${Math.floor(days / 7)} semaine${Math.floor(days / 7) > 1 ? 's' : ''}`;
                    return `Il y a ${Math.floor(days / 30)} mois`;
                };

                const fallbackReviews = [
                    { user_id: 'thomas', rating: 5, comment: "Qualite vraiment premium, ca change tout dans l'habitacle. Le toucher est parfait et le montage s'est fait en 5 minutes.", created_at: new Date(Date.now() - 14 * 86400000).toISOString() },
                    { user_id: 'lucas', rating: 5, comment: "Rendu incroyable sur ma Golf 8. La finition aluminium mat est exactement comme sur les photos, voire mieux en vrai.", created_at: new Date(Date.now() - 30 * 86400000).toISOString() },
                    { user_id: 'samir', rating: 4, comment: "Tres bonne prise en main, solide et bien fini. Livraison rapide. Une fois en place c'est nickel.", created_at: new Date(Date.now() - 21 * 86400000).toISOString() },
                ];

                const { data: reviews } = await supabase
                    .from('reviews')
                    .select('user_id, rating, comment, created_at')
                    .eq('product_id', 'deep-matte-01')
                    .order('created_at', { ascending: false })
                    .limit(3);

                const data = (reviews && reviews.length > 0) ? reviews : fallbackReviews;
                const avg = (data.reduce((a, r) => a + r.rating, 0) / data.length).toFixed(1);
                const total = reviews?.length ?? 0;

                const avgEl = document.getElementById('home-avg');
                const countEl = document.getElementById('home-count');
                if (avgEl) avgEl.textContent = avg;
                if (countEl) countEl.textContent = total > 0 ? `${total} avis verifies` : 'Avis clients';

                const grid = document.getElementById('reviews-grid-home');
                const skel = document.getElementById('reviews-skeleton-home');
                if (!grid) return;

                grid.innerHTML = data.map((review) => {
                    const col = avatarColor(review.user_id);
                    const initial = (review.user_id?.slice(0,1) ?? '?').toUpperCase();
                    const comment = review.comment?.slice(0, 150) ?? '';
                    return `<article class="review-card">
                        <div style="font-size:0.9rem;letter-spacing:0.06em;">${starsHtml(review.rating)}</div>
                        <p style="color:#c4cbd1;font-size:0.9rem;line-height:1.75;margin-top:1.1rem;">"${comment}${(review.comment?.length ?? 0) > 150 ? '…' : ''}"</p>
                        <div style="display:flex;align-items:center;gap:0.75rem;margin-top:1.5rem;">
                            <div style="height:2rem;width:2rem;border-radius:50%;background:${col}1a;border:1px solid ${col}55;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:0.75rem;color:${col};flex-shrink:0;">${initial}</div>
                            <div>
                                <p style="color:white;font-size:0.65rem;font-weight:900;text-transform:uppercase;letter-spacing:0.08em;">Client verifie</p>
                                <p style="color:#626c76;font-size:0.6rem;margin-top:0.1rem;">${fmtRelative(review.created_at)}</p>
                            </div>
                        </div>
                    </article>`;
                }).join('');

                if (skel) skel.style.display = 'none';
                grid.style.display = 'grid';
            });
        </script>

        <script>
            import { initSiteEffects } from '../scripts/site-effects.js';
            const runSiteEffects = () => initSiteEffects();
            document.addEventListener('astro:page-load', runSiteEffects);
            if (document.readyState !== 'loading') runSiteEffects();
            else document.addEventListener('DOMContentLoaded', runSiteEffects, { once: true });
        </script>
    </body>
</html>
